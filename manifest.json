{
  "name": "幸孕记",
  "appid": "__UNI__1BC2635",
  "description": "从备孕到育儿，一条不断档的生命记录",
  "versionName": "1.0.0",
  "versionCode": "101",
  "uni-app-x": {
    "vapor": true,
    "styleIsolationVersion": "2",
    "vapor-render-target": "bytecode",
    "vapor-default-script-lang": "ts"
  },
  "vueVersion": "3",
  "locale": "zh-Hans",
  "networkTimeout": {
    "request": 15000
  },
  "app-android": {
    "minSdkVersion": 21,
    "abiFilters": [
      "arm64-v8a"
    ],
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.ACCESS_NETWORK_STATE",
      "android.permission.VIBRATE",
      "android.permission.POST_NOTIFICATIONS"
    ]
  },
  "web": {
    "uniCloud": true,
    "router": {
      "mode": "hash"
    }
  }
}
