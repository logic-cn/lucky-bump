import { reactive } from 'vue'

/** 应用全局状态（单例）。生命周期见 App.uvue onLaunch。 */
export const appState = reactive({
  booted: false,
  token: '',
  uid: '',
  nickname: '',
  avatar: '',
  /** 当前旅程阶段：PRECONCEPTION/T1/T2/T3/POSTPARTUM/RECOVERY/PARENTING/MOURNING */
  stage: '',
  journeyId: ''
})

const TOKEN_KEY = 'uni_id_token'

export function loadTokenFromStorage(): string {
  const v = uni.getStorageSync(TOKEN_KEY)
  return v == null ? '' : (v as string)
}

export function saveToken(token: string) {
  appState.token = token
  uni.setStorageSync(TOKEN_KEY, token)
}

export function clearToken() {
  appState.token = ''
  appState.uid = ''
  appState.nickname = ''
  uni.removeStorageSync(TOKEN_KEY)
}

export function appInit() {
  appState.token = loadTokenFromStorage()
  appState.booted = true
}

/* ---------------- 应用锁（隐私页开关 + 启动遮罩，见 pages/account/lock.uvue） ---------------- */

/** 会话内解锁标记（仅内存，冷启动重置） */
export const lockState = {
  unlocked: false
}

export function markUnlocked(): void {
  lockState.unlocked = true
}

/** 需要弹锁：开关已开启且本次会话未解锁。开关只在登录后的隐私页可开，未登录场景天然不触发。 */
export function isLockRequired(): boolean {
  const raw = uni.getStorageSync('lb_app_lock')
  const enabled = raw != null && (raw == true || (raw as string) == 'true')
  return enabled && !lockState.unlocked
}
