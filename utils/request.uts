/**
 * 统一请求层：云对象 RPC 封装（docs/06 A6）
 * - 统一附带登录态（token 经 uniCloud uni_id_token 通道）
 * - 统一错误约定：errCode=0 成功；TOKEN_ 前缀自动清登录态并跳登录（uniIdRouter 等价行为）
 * 注：errCode 语义判断以 getNumber('errCode') == 0 为准（见 docs/06 A6 响应约定）。
 */
import { clearToken, saveToken } from '../store/appStore.uts'

// #ifdef WEB
/** web 端响应可能是普通对象（编译器仅对纯字面量请求参数启用 UTS 包装），统一深转为 UTSJSONObject 树，保证 getNumber/getString/getJSON/getArray 可用 */
function deepToUts(v: any | null): any | null {
  if (v instanceof Array) {
    return v.map((item: any): any => deepToUts(item))
  }
  if (v != null && typeof v == 'object') {
    const o = new UTSJSONObject({})
    for (const key in v) {
      o[key] = deepToUts(v[key])
    }
    return o
  }
  return v
}
// #endif

// 底层网络错误（如 web 端 request:fail）与服务端资源告警直接透出会出现在界面文案里，统一转成用户可读提示
function friendlyMessage(raw: string | null): string {
  if (raw == null || raw.length == 0) return '服务暂时不可用，请稍后重试'
  if (raw.indexOf('request:fail') == 0 || raw.indexOf('Failed to fetch') == 0) return '网络异常，请检查网络后重试'
  if (raw.indexOf('resource exhausted') >= 0 || raw.indexOf('FC invoke failed') >= 0) return '服务暂时不可用，请稍后重试'
  return raw
}

export function callCloud(objName: string, method: string, params: UTSJSONObject): Promise<UTSJSONObject> {
  return new Promise<UTSJSONObject>((resolve, reject) => {
    uniCloud.callFunction({
      name: objName,
      // 云对象经 callFunction 调用的约定：data={method, params[]}，params 为参数数组，
      // 平台按 method(...params) 展开；单参数对象需包一层 [params]。
      data: { method: method, params: [params] } as UTSJSONObject,
      success: (res) => {
        // #ifdef WEB
        const result = deepToUts(res.result) as UTSJSONObject
        // #endif
        // #ifndef WEB
        const result = res.result as UTSJSONObject
        // #endif
        if (result == null) {
          reject(new Error('响应为空'))
          return
        }
        const errNum = result.getNumber('errCode') ?? -1
        if (errNum == 0) {
          resolve(result)
          return
        }
        const code = result.getString('errCode') ?? 'UNKNOWN'
        const msg = friendlyMessage(result.getString('errMsg'))
        if (code.indexOf('TOKEN_') == 0) {
          clearToken()
          uni.reLaunch({ url: '/pages/account/login' })
        }
        reject(new Error(msg))
      },
      fail: (err) => {
        reject(new Error(friendlyMessage(err.errMsg)))
      }
    })
  })
}

/** 保存登录态（登录/注册成功后调用） */
export function applyLoginResult(result: UTSJSONObject) {
  const token = result.getString('token') ?? ''
  if (token.length > 0) saveToken(token)
}

/* ---------------- 常用便捷方法 ---------------- */
export function luckyId(method: string, params: UTSJSONObject): Promise<UTSJSONObject> {
  return callCloud('lucky-id', method, params)
}
export function luckyJourney(method: string, params: UTSJSONObject): Promise<UTSJSONObject> {
  return callCloud('lucky-journey', method, params)
}
export function luckyRecord(method: string, params: UTSJSONObject): Promise<UTSJSONObject> {
  return callCloud('lucky-record', method, params)
}
export function luckyBaby(method: string, params: UTSJSONObject): Promise<UTSJSONObject> {
  return callCloud('lucky-baby', method, params)
}
export function luckyCare(method: string, params: UTSJSONObject): Promise<UTSJSONObject> {
  return callCloud('lucky-care', method, params)
}
export function luckyFamily(method: string, params: UTSJSONObject): Promise<UTSJSONObject> {
