/** 跨页日期/时间选择（Web 端 picker 平台缺陷绕过，2026-10-31）：
 * 打开独立选择器页（页面渲染路径在 Web 可靠）。
 * 回传走本地存储 + 轮询：Web 端页面栈回退会重建页面实例，闭包/$once 监听不可靠。 */

const POLL_MS = 300
const POLL_MAX = 200

function waitForPick(id: string): Promise<string> {
  return new Promise<string>((resolve) => {
    const key = `lb_pick_${id}`
    let n = 0
    const tick = () => {
      const v = uni.getStorageSync(key)
      if (v != null && (v as string).length > 0) {
        uni.removeStorageSync(key)
        resolve(v as string)
        return
      }
      n += 1
      if (n < POLL_MAX) {
        setTimeout(tick, POLL_MS)
      } else {
        resolve('')
      }
    }
    setTimeout(tick, POLL_MS)
  })
}

function openPicker(mode: string, value: string, end: string): string {
  const id = `pick${Date.now()}`
  // 请求同时写入存储：HBuilderX 5.34 vapor Web 下 onLoad 可能不触发，选择页启动时直接读存储
  uni.setStorageSync('lb_pick_req', `${id}\n${mode}\n${value}\n${end}\n${Date.now()}`)
  // 保留 query 作为 App/正常会话的兜底
  const q = mode == 'date'
    ? `/pages/util/date-picker?mode=date&id=${id}&value=${value}&end=${end}`
    : `/pages/util/date-picker?mode=time&id=${id}&value=${value}`
  uni.navigateTo({ url: q })
  return id
}

export function pickDate(value: string, end: string): Promise<string> {
  const id = openPicker('date', value, end)
  return waitForPick(id)
}

export function pickTime(value: string): Promise<string> {
  const id = openPicker('time', value, '')
  return waitForPick(id)
}
