  { name: '山楂', verdict: 'caution', note: '少量食用通常无碍，不必刻意大量吃' },
  { name: '荔枝', verdict: 'caution', note: '糖分较高，控制量，血糖异常者更要注意' },
  { name: '吸烟与二手烟', verdict: 'no', note: '孕期与哺乳期都应完全避免，包括二手烟' },
  { name: '染发', verdict: 'caution', note: '孕早期尽量避免，必须做时选通风环境并缩短接触时间' },
  { name: '泡温泉/桑拿', verdict: 'no', note: '孕早期与晚期不建议，体温过高有风险' },
  { name: '剧烈运动', verdict: 'caution', note: '避免对抗、跳跃与跌倒风险；散步、孕妇瑜伽通常更合适，特殊情况遵医嘱' },
  { name: '同房', verdict: 'caution', note: '孕中期多数情况可以；有出血、破水、前置胎盘或医生叮嘱时避免' },
  { name: '米酒下奶', verdict: 'no', note: '酒精会进入乳汁，不建议用酒类催奶，多喝水与勤吸吮更有效' },
  { name: '束腹带', verdict: 'caution', note: '产后是否使用、松紧与时长请按医生建议，不宜过紧' },
  { name: '疫苗（孕期）', verdict: 'caution', note: '灭活疫苗是否接种按医生建议；活疫苗通常不建议，具体遵医嘱' }
]

/** 本周要点：按阶段给出 3 条最相关的行动提示 */
export function weeklyFocus(stage: string, weeks: number, postpartumDays: number): string[] {
  const out: string[] = []
  if (stage.length == 0) {
    out.push('完成建档后，本周要点会按你的阶段更新')
    out.push('每天记录一条，趋势才有意义')
    out.push('出现出血、剧烈腹痛或胎动异常，请及时就医')
    return out
  }
  if (stage == 'PRECONCEPTION') {
    out.push('每天叶酸 0.4mg，固定时间吃')
    out.push('今天记录经期或排卵试纸，周期预测会更准')
    out.push('规律作息，比“拼命努力”更重要')
    return out
  }
  if (stage == 'T1' || stage == 'T2' || stage == 'T3') {
    if (weeks < 14) {
      out.push('叶酸吃到孕 3 月，避免自行用药')
      out.push('少量多餐缓解孕吐，无法进水进食超 12 小时就医')
      out.push('NT 检查在 11-13+6 周，提前预约')
    } else if (weeks < 28) {
      out.push('20-24 周大排畸，24-28 周糖耐（前空腹 8-12 小时）')
      out.push('关注钙与铁，体重按孕前 BMI 区间增长')
      out.push('常规产检每 4 周一次，按医院安排')
    } else {
      out.push('每天固定时段数胎动，明显减少立即就医')
      out.push('记住 5-1-1：宫缩 5 分钟一次、持续 1 分钟、共 1 小时')
      out.push('36 周前备好待产包与证件')
    }
    return out
  }
  if (stage == 'POSTPARTUM') {
    if (postpartumDays <= 42) {
      out.push('恶露 2-3 周变淡，异味伴发热及时就医')
      out.push('情绪自评 2/4/6 周各做一次')
      out.push('42 天复查妈妈和宝宝都要')
    } else {
      out.push('复查后按医生建议恢复活动与盆底训练')
      out.push('哺乳期每天多约 500kcal 与足量饮水')
      out.push('能睡就睡，别硬扛')
    }
    return out
  }
  out.push('6 月龄起加辅食，从含铁米粉开始，一次一种观察 3 天')
  out.push('按国家免疫规划接种疫苗，接种后留观 30 分钟')
  out.push('每个宝宝节奏不同，里程碑晚一点不必焦虑')
  return out
}

/** 我的阶段：本阶段优先，通用内容兜底 */
export function stageArticles(stage: string): Article[] {
  const own: Article[] = []
  const common: Article[] = []
  for (let i = 0; i < ARTICLES.length; i++) {
    if (ARTICLES[i].stage == stage) own.push(ARTICLES[i])
    else if (ARTICLES[i].stage == 'COMMON') common.push(ARTICLES[i])
  }
  return own.concat(common)
}

export function allArticles(): Article[] { return ARTICLES }

/** 关键词搜索：标题/标签/正文，空词返回全部 */
export function searchArticles(q: string): Article[] {
  const key = q.trim()
  if (key.length == 0) return ARTICLES
  const out: Article[] = []
  for (let i = 0; i < ARTICLES.length; i++) {
    const a = ARTICLES[i]
    if (a.title.indexOf(key) >= 0 || a.tags.indexOf(key) >= 0 || a.body.indexOf(key) >= 0) out.push(a)
  }
  return out
}

export function searchTools(q: string): Tool[] {
  const key = q.trim()
  if (key.length == 0) return TOOLS
  const out: Tool[] = []
  for (let i = 0; i < TOOLS.length; i++) {
    const t = TOOLS[i]
    if (t.name.indexOf(key) >= 0 || t.note.indexOf(key) >= 0) out.push(t)
  }
  return out
}

export function articleById(id: string): Article | null {
  for (let i = 0; i < ARTICLES.length; i++) {
    if (ARTICLES[i].id == id) return ARTICLES[i]
  }
  return null
}
