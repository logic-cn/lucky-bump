/**
 * 知识内容库（本地静态，随版本更新）
 * 边界：只做通用科普，不提供诊断、用药与治疗建议；条目均标注来源。
 */

export type Article = {
  id: string,
  title: string,
  stage: string,      // COMMON/PRECONCEPTION/T1/T2/T3/POSTPARTUM/PARENTING
  weekFrom: number,   // 孕期适用周区间，其他阶段为 0
  weekTo: number,
  tags: string,
  body: string,
  source: string
}

export type Tool = {
  name: string,
  verdict: string,    // ok/caution/no
  note: string
}

const ARTICLES: Article[] = [
