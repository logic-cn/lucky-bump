    },
    "currentJourneyId": {
      "bsonType": "string",
      "title": "当前旅程"
    },
    "sensitive_consent_at": {
      "bsonType": "long",
      "title": "敏感信息单独同意时间"
    },
    "sensitive_consent_version": {
      "bsonType": "string",
      "title": "敏感信息同意条款版本"
