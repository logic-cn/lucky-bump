import App from './App.uvue'
import { createSSRApp } from 'vue'

// #ifdef WEB
// uni-app x web 编译器把"页面内仅使用一次的 <input>"编译为运行时解析的 asset 组件（v-uni-input），
// 而内置组件不会全局注册，运行时解析失败会渲染成无功能的空元素（多 input 页面由编译器内联，无此问题）。
// 此处在应用上下文显式注册，保证所有页面的单 input 均可输入。
import { Input as UniInput, Textarea as UniTextarea } from '@dcloudio/uni-h5'

// web 端 number 原型没有 UTS 的 toInt 扩展（app 端 kotlin 自带），按 UTS 语义（向零截断）补齐
if (typeof (Number.prototype as any).toInt !== 'function') {
  (Number.prototype as any).toInt = function (): number {
    const n = this as number
    return n < 0 ? Math.ceil(n) : Math.floor(n)
  }
}
// #endif

export function createApp() {
  const app = createSSRApp(App)
  // #ifdef WEB
  app.component('v-uni-input', UniInput)
  // 页面内仅用一次的 <textarea> 同样会被编译成 v-uni-textarea（日记页实测无法输入）
  app.component('v-uni-textarea', UniTextarea)
  // #endif
  return { app }
}
