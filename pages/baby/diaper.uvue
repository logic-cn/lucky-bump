<template>
  <view class="page">
    <view class="card">
      <text class="label">这次换了什么</text>
      <view class="opts">
        <view class="opt" v-for="(k, i) in kinds" :key="i" :class="kind == k.value ? 'opt-active' : ''" @click="kind = k.value">
          <text class="opt-text" :class="kind == k.value ? 'opt-text-active' : ''">{{ k.label }}</text>
        </view>
      </view>
      <view v-if="kind != 'pee'">
        <text class="label">性状</text>
        <view class="opts">
          <view class="opt" v-for="(t, i) in textures" :key="i" :class="texture == t.value ? 'opt-active' : ''" @click="texture = t.value">
            <text class="opt-text" :class="texture == t.value ? 'opt-text-active' : ''">{{ t.label }}</text>
          </view>
        </view>
        <text class="label">颜色</text>
        <view class="opts">
          <view class="opt" v-for="(c, i) in colors" :key="i" :class="color == c.value ? (c.value == 'blood_streak' || c.value == 'white' ? 'opt-danger-active' : 'opt-active') : ''" @click="color = c.value">
            <text class="opt-text" :class="color == c.value ? 'opt-text-active' : ''">{{ c.label }}</text>
          </view>
        </view>
      </view>
    </view>
    <button class="btn-save" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存' }}</button>

    <view class="redline" v-if="redlineMsg.length > 0">
      <text class="redline-title">{{ redlineCritical ? '⚠️ 请尽快就医' : '⚠️ 需要关注' }}</text>
      <text class="redline-msg">{{ redlineMsg }}</text>
      <text class="redline-action" v-if="redlineAction.length > 0">{{ redlineAction }}</text>
    </view>

    <view class="card" v-if="summary != null">
      <text class="card-title">今天：{{ diaperCount }} 次（含便便 {{ poopCount }} 次）</text>
    </view>
  </view>
</template>

<script>
  import { luckyBaby } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'

  type KOpt = { value: string, label: string }

  export default {
    data() {
      return {
        kind: 'both', texture: 'paste', color: 'yellow', saving: false,
        babyId: '', summary: null, redlineMsg: '', redlineAction: '', redlineCritical: false,
        kinds: [{ value: 'pee', label: '🚹 尿' }, { value: 'poop', label: '🚼 便' }, { value: 'both', label: 'Both 都有' }] as KOpt[],
        textures: [{ value: 'paste', label: '糊状' }, { value: 'formed', label: '成形' }, { value: 'watery', label: '水样' }, { value: 'hard', label: '干硬' }] as KOpt[],
        colors: [{ value: 'yellow', label: '金黄' }, { value: 'green', label: '绿' }, { value: 'brown', label: '棕' }, { value: 'black', label: '黑' }, { value: 'white', label: '陶土白' }, { value: 'blood_streak', label: '带血丝' }] as KOpt[]
      }
    },
    computed: {
      diaperCount(): number { return ((this.summary as UTSJSONObject | null)?.getJSON('diaper') as UTSJSONObject | null)?.getNumber('count')?.toInt() ?? 0 },
      poopCount(): number { return ((this.summary as UTSJSONObject | null)?.getJSON('diaper') as UTSJSONObject | null)?.getNumber('poopCount')?.toInt() ?? 0 }
    },
    onLoad() {
      const stored = uni.getStorageSync('current_baby_id') as string
      this.babyId = stored ?? ''
      if (this.babyId.length == 0) {
        uni.showToast({ title: '请先在宝宝页选择宝宝', icon: 'none' })
        setTimeout(() => { uni.reLaunch({ url: '/pages/baby/baby-home' }) }, 800)
        return
      }
      this.load()
    },
    methods: {
      async load() {
        try { this.summary = await luckyBaby('dailySummary', { journeyId: journeyState.journeyId, babyId: this.babyId } as UTSJSONObject) } catch (e) { /* 忽略 */ }
      },
      async save() {
        this.saving = true
        try {
          const res = await luckyBaby('addDiaper', {
            journeyId: journeyState.journeyId, babyId: this.babyId, kind: this.kind,
            texture: this.kind == 'pee' ? '' : this.texture, color: this.kind == 'pee' ? '' : this.color
          } as UTSJSONObject)
          const rl = res.getJSON('redline')
          if (rl != null) {
            const r = rl as UTSJSONObject
            this.redlineMsg = r.getString('message') ?? ''
            this.redlineAction = r.getString('action') ?? ''
            this.redlineCritical = (r.getString('level') ?? '') == 'critical'
          } else {
            uni.showToast({ title: '已记录 ✓', icon: 'success' })
            this.load()
          }
        } catch (e) {
          uni.showToast({ title: (e as Error).message, icon: 'none' })
        } finally { this.saving = false }
      }
    }
  }
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 40rpx; margin-top: 24rpx; align-items: center; }
  .label { font-size: 26rpx; color: #1F2329; margin: 16rpx 0 16rpx 0; }
  .opts { flex-direction: row; flex-wrap: wrap; justify-content: center; }
  .opt { background-color: #F7F6F4; border-radius: 16rpx; padding: 16rpx 24rpx; margin: 8rpx; }
  .opt-active { background-color: #FFEFEA; }
  .opt-danger-active { background-color: #FDECEC; }
  .opt-text { font-size: 26rpx; color: #6B7280; }
  .opt-text-active { color: #E5484D; font-weight: bold; }
  .btn-save { width: 700rpx; height: 96rpx; line-height: 96rpx; background-color: #FF7A6B; color: #FFFFFF; font-size: 32rpx; border-radius: 44rpx; margin-top: 32rpx; }
  .redline { width: 700rpx; background-color: #FDECEC; border-radius: 24rpx; padding: 40rpx; margin-top: 24rpx; }
  .redline-title { font-size: 34rpx; font-weight: bold; color: #E5484D; }
  .redline-msg { font-size: 28rpx; color: #1F2329; margin-top: 16rpx; }
  .redline-action { font-size: 28rpx; color: #E5484D; margin-top: 12rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: #1F2329; }
</style>
