<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">这次换了什么</text>
      <view class="opts">
        <view class="opt" hover-class="lb-press" hover-stay-time="120" v-for="(k, i) in kinds" :key="i" :class="kind == k.value ? 'opt-active' : ''" @click="kind = k.value">
          <text class="opt-text" :class="kind == k.value ? 'opt-text-active' : ''">{{ k.label }}</text>
        </view>
      </view>
      <view v-if="kind != 'pee'">
        <text class="label">性状</text>
        <view class="opts">
          <view class="opt" hover-class="lb-press" hover-stay-time="120" v-for="(t, i) in textures" :key="i" :class="texture == t.value ? 'opt-active' : ''" @click="texture = t.value">
            <text class="opt-text" :class="texture == t.value ? 'opt-text-active' : ''">{{ t.label }}</text>
          </view>
        </view>
        <text class="label">颜色</text>
        <view class="opts">
          <view class="opt" hover-class="lb-press" hover-stay-time="120" v-for="(c, i) in colors" :key="i" :class="color == c.value ? (c.value == 'blood_streak' || c.value == 'white' ? 'opt-danger-active' : 'opt-active') : ''" @click="color = c.value">
            <text class="opt-text" :class="color == c.value ? 'opt-text-active' : ''">{{ c.label }}</text>
          </view>
        </view>
      </view>
    </view>
    <button class="btn-save lb-rise-1" hover-class="lb-press" hover-stay-time="120" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存' }}</button>

    <view class="redline lb-rise-2" v-if="redlineMsg.length > 0">
      <text class="redline-title">{{ redlineCritical ? '⚠️ 请尽快就医' : '⚠️ 需要关注' }}</text>
      <text class="redline-msg">{{ redlineMsg }}</text>
      <text class="redline-action" v-if="redlineAction.length > 0">{{ redlineAction }}</text>
    </view>

    <view class="card lb-rise-3" v-if="summary != null">
      <text class="card-title">今天：{{ diaperCount }} 次（含便便 {{ poopCount }} 次）</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyBaby } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type KOpt = { value: string, label: string }

  const kind = ref<string>('both')
  const texture = ref<string>('paste')
  const color = ref<string>('yellow')
  const saving = ref<boolean>(false)
  const babyId = ref<string>('')
  const summary = ref<UTSJSONObject | null>(null)
  const redlineMsg = ref<string>('')
  const redlineAction = ref<string>('')
  const redlineCritical = ref<boolean>(false)
  const kinds = ref<KOpt[]>([{ value: 'pee', label: '🚹 尿' }, { value: 'poop', label: '🚼 便' }, { value: 'both', label: 'Both 都有' }])
  const textures = ref<KOpt[]>([{ value: 'paste', label: '糊状' }, { value: 'formed', label: '成形' }, { value: 'watery', label: '水样' }, { value: 'hard', label: '干硬' }])
  const colors = ref<KOpt[]>([{ value: 'yellow', label: '金黄' }, { value: 'green', label: '绿' }, { value: 'brown', label: '棕' }, { value: 'black', label: '黑' }, { value: 'white', label: '陶土白' }, { value: 'blood_streak', label: '带血丝' }])

  const diaperCount = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('diaper') as UTSJSONObject | null)?.getNumber('count')?.toInt() ?? 0)
  const poopCount = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('diaper') as UTSJSONObject | null)?.getNumber('poopCount')?.toInt() ?? 0)

  async function load() {
    try { summary.value = await luckyBaby('dailySummary', { journeyId: journeyState.journeyId, babyId: babyId.value } as UTSJSONObject) } catch (e) { /* 忽略 */ }
  }
  async function save() {
    saving.value = true
    try {
      const res = await luckyBaby('addDiaper', {
        journeyId: journeyState.journeyId, babyId: babyId.value, kind: kind.value,
        texture: kind.value == 'pee' ? '' : texture.value, color: kind.value == 'pee' ? '' : color.value
      } as UTSJSONObject)
      const rl = res.getJSON('redline')
      if (rl != null) {
        const r = rl as UTSJSONObject
        redlineMsg.value = r.getString('message') ?? ''
        redlineAction.value = r.getString('action') ?? ''
        redlineCritical.value = (r.getString('level') ?? '') == 'critical'
      } else {
        uni.showToast({ title: '已记录 ✓', icon: 'success' })
        load()
      }
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }

  onPageReady(() => {
    const stored = uni.getStorageSync('current_baby_id') as string
    babyId.value = stored ?? ''
    if (babyId.value.length == 0) {
      uni.showToast({ title: '请先在宝宝页选择宝宝', icon: 'none' })
      setTimeout(() => { uni.reLaunch({ url: '/pages/baby/baby-home' }) }, 800)
      return
    }
    load()
  })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 26rpx; color: var(--lb-text-1); margin: 16rpx 0 16rpx 0; }
  .opts { flex-direction: row; flex-wrap: wrap; justify-content: center; }
  .opt { background-color: var(--lb-fill); border-radius: 24rpx; padding: 16rpx 24rpx; margin: 8rpx; transition: all 160ms ease-out; }
  .opt-active { background-color: var(--lb-primary-soft); }
  .opt-danger-active { background-color: var(--lb-danger-soft); }
  .opt-text { font-size: 26rpx; color: var(--lb-text-2); }
  .opt-text-active { color: var(--lb-danger); font-weight: bold; }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 32rpx; transition: all 160ms ease-out; }
  .redline { width: 702rpx; background-color: var(--lb-danger-soft); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; }
  .redline-title { font-size: 34rpx; font-weight: bold; color: var(--lb-danger); }
  .redline-msg { font-size: 28rpx; color: var(--lb-text-1); margin-top: 16rpx; }
  .redline-action { font-size: 28rpx; color: var(--lb-danger); margin-top: 12rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
