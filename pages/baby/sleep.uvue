<template>
  <view class="page">
    <view class="card">
      <text class="label">类型</text>
      <view class="opts">
        <view class="opt" :class="kind == 'nap' ? 'opt-active' : ''" @click="kind = 'nap'"><text class="opt-text" :class="kind == 'nap' ? 'opt-text-active' : ''">🌞 小睡</text></view>
        <view class="opt" :class="kind == 'night' ? 'opt-active' : ''" @click="kind = 'night'"><text class="opt-text" :class="kind == 'night' ? 'opt-text-active' : ''">🌙 夜觉</text></view>
      </view>
      <text class="label">入睡时间</text>
      <view class="row2">
        <picker class="half" mode="date" :value="startDate" @change="onStartDateChange"><view class="pick-box"><text class="pick-text">{{ startDate }}</text></view></picker>
        <picker class="half" mode="time" :value="startTime" @change="onStartTimeChange"><view class="pick-box"><text class="pick-text">{{ startTime }}</text></view></picker>
      </view>
      <text class="label">醒来时间</text>
      <view class="row2">
        <picker class="half" mode="date" :value="endDate" @change="onEndDateChange"><view class="pick-box"><text class="pick-text">{{ endDate }}</text></view></picker>
        <picker class="half" mode="time" :value="endTime" @change="onEndTimeChange"><view class="pick-box"><text class="pick-text">{{ endTime }}</text></view></picker>
      </view>
      <view class="wak-row" v-if="kind == 'night'">
        <text class="label-inline">夜醒次数</text>
        <view class="stepper">
          <view class="step-btn" @click="wakings = Math.max(0, wakings - 1)"><text class="step-text">−</text></view>
          <text class="step-num">{{ wakings }}</text>
          <view class="step-btn" @click="wakings = Math.min(20, wakings + 1)"><text class="step-text">＋</text></view>
        </view>
      </view>
    </view>
    <button class="btn-save" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存' }}</button>

    <view class="card" v-if="summary != null">
      <text class="card-title">今天共睡了 {{ sleepTotalMin }} 分钟 · 夜醒 {{ nightWakings }} 次</text>
      <text class="hint">0-3 月参考 14-17 小时/天，个体差异大；我们只记录，不评判</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from 'vue'
  import { onLoad } from '@dcloudio/uni-app'
  import { luckyBaby } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'

  function pad(n: number): string { return n < 10 ? '0' + n : '' + n }

  const now = new Date()
  const kind = ref<string>('nap')
  const wakings = ref<number>(0)
  const saving = ref<boolean>(false)
  const babyId = ref<string>('')
  const summary = ref<UTSJSONObject | null>(null)
  const startDate = ref<string>(`${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`)
  const startTime = ref<string>('13:00')
  const endDate = ref<string>(`${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`)
  const endTime = ref<string>('14:30')

  const sleepTotalMin = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('sleep') as UTSJSONObject | null)?.getNumber('totalMin')?.toInt() ?? 0)
  const nightWakings = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('sleep') as UTSJSONObject | null)?.getNumber('nightWakings')?.toInt() ?? 0)

  function onStartDateChange(e: UniPickerChangeEvent) { startDate.value = (e.detail.value as string) ?? startDate.value }
  function onStartTimeChange(e: UniPickerChangeEvent) { startTime.value = (e.detail.value as string) ?? startTime.value }
  function onEndDateChange(e: UniPickerChangeEvent) { endDate.value = (e.detail.value as string) ?? endDate.value }
  function onEndTimeChange(e: UniPickerChangeEvent) { endTime.value = (e.detail.value as string) ?? endTime.value }
  async function load() {
    try { summary.value = await luckyBaby('dailySummary', { journeyId: journeyState.journeyId, babyId: babyId.value } as UTSJSONObject) } catch (e) { /* 忽略 */ }
  }
  function tsOf(dateStr: string, timeStr: string): number {
    const p = timeStr.indexOf(':')
    const hh = parseInt(timeStr.slice(0, p)) || 0
    const mm = parseInt(timeStr.slice(p + 1)) || 0
    return Date.parse(`${dateStr}T${pad(hh)}:${pad(mm)}:00+08:00`)
  }
  async function save() {
    const startTs = tsOf(startDate.value, startTime.value)
    const endTs = tsOf(endDate.value, endTime.value)
    if (!(startTs > 0 && endTs > startTs)) { uni.showToast({ title: '醒来时间需晚于入睡时间', icon: 'none' }); return }
    saving.value = true
    try {
      await luckyBaby('addSleep', { journeyId: journeyState.journeyId, babyId: babyId.value, kind: kind.value, startTs, endTs, nightWakings: kind.value == 'night' ? wakings.value : 0 } as UTSJSONObject)
      uni.showToast({ title: '已记录 ✓', icon: 'success' })
      load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }

  onLoad(() => {
    const stored = uni.getStorageSync('current_baby_id') as string
    babyId.value = stored ?? ''
    if (babyId.value.length == 0) {
      uni.showToast({ title: '请先在宝宝页选择宝宝', icon: 'none' })
      setTimeout(() => { uni.reLaunch({ url: '/pages/baby/baby-home' }) }, 800)
      return
    }
    load()
  })
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 40rpx; margin-top: 24rpx; align-items: center; }
  .label { font-size: 26rpx; color: #1F2329; margin: 16rpx 0 12rpx 0; }
  .opts { flex-direction: row; }
  .opt { background-color: #F7F6F4; border-radius: 16rpx; padding: 16rpx 32rpx; margin: 8rpx; }
  .opt-active { background-color: #FFEFEA; }
  .opt-text { font-size: 26rpx; color: #6B7280; }
  .opt-text-active { color: #FF7A6B; font-weight: bold; }
  .row2 { flex-direction: row; }
  .half { flex: 1; margin: 0 8rpx; }
  .pick-box { width: 300rpx; height: 88rpx; background-color: #F7F6F4; border-radius: 16rpx; align-items: center; justify-content: center; }
  .pick-text { font-size: 28rpx; color: #1F2329; }
  .wak-row { flex-direction: row; align-items: center; margin-top: 16rpx; }
  .label-inline { font-size: 26rpx; color: #1F2329; flex: 1; }
  .stepper { flex-direction: row; align-items: center; }
  .step-btn { width: 80rpx; height: 80rpx; border-radius: 20rpx; background-color: #FFEFEA; align-items: center; justify-content: center; }
  .step-text { font-size: 40rpx; color: #E85D4E; }
  .step-num { width: 120rpx; text-align: center; font-size: 40rpx; font-weight: bold; color: #1F2329; }
  .btn-save { width: 700rpx; height: 96rpx; line-height: 96rpx; background-color: #FF7A6B; color: #FFFFFF; font-size: 32rpx; border-radius: 44rpx; margin-top: 32rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: #1F2329; }
  .hint { font-size: 20rpx; color: #A3AAB5; margin-top: 12rpx; }
</style>
