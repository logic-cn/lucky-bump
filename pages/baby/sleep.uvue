<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">类型</text>
      <view class="opts">
        <view class="opt" :class="kind == 'nap' ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="kind = 'nap'"><image class="opt-ico" src="/static/icons/sun.png" mode="aspectFit" /><text class="opt-text" :class="kind == 'nap' ? 'opt-text-active' : ''">小睡</text></view>
        <view class="opt" :class="kind == 'night' ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="kind = 'night'"><image class="opt-ico" src="/static/icons/sleep.png" mode="aspectFit" /><text class="opt-text" :class="kind == 'night' ? 'opt-text-active' : ''">夜觉</text></view>
      </view>
      <text class="label">入睡时间</text>
      <view class="row2">
        <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-date-field class="half"  :value="startDate" @change="onStartDateChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view class="half" hover-class="lb-press" hover-stay-time="120" @click="onPickStartDateWeb"><view class="pick-box" hover-class="lb-press" hover-stay-time="120"><text class="pick-text">{{ startDate }}</text></view></view>
    <!-- #endif -->
        <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-time-field class="half"  :value="startTime" @change="onStartTimeChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view class="half" hover-class="lb-press" hover-stay-time="120" @click="onPickStartTimeWeb"><view class="pick-box" hover-class="lb-press" hover-stay-time="120"><text class="pick-text">{{ startTime }}</text></view></view>
    <!-- #endif -->
      </view>
      <text class="label">醒来时间</text>
      <view class="row2">
        <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-date-field class="half"  :value="endDate" @change="onEndDateChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view class="half" hover-class="lb-press" hover-stay-time="120" @click="onPickEndDateWeb"><view class="pick-box" hover-class="lb-press" hover-stay-time="120"><text class="pick-text">{{ endDate }}</text></view></view>
    <!-- #endif -->
        <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-time-field class="half"  :value="endTime" @change="onEndTimeChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view class="half" hover-class="lb-press" hover-stay-time="120" @click="onPickEndTimeWeb"><view class="pick-box" hover-class="lb-press" hover-stay-time="120"><text class="pick-text">{{ endTime }}</text></view></view>
    <!-- #endif -->
      </view>
      <view class="wak-row" v-if="kind == 'night'">
        <text class="label-inline">夜醒次数</text>
        <view class="stepper">
          <view class="step-btn" hover-class="lb-press" hover-stay-time="120" @click="wakings = Math.max(0, wakings - 1)"><text class="step-text">−</text></view>
          <text class="step-num">{{ wakings }}</text>
          <view class="step-btn" hover-class="lb-press" hover-stay-time="120" @click="wakings = Math.min(20, wakings + 1)"><text class="step-text">＋</text></view>
        </view>
      </view>
    </view>
    <button class="btn-save lb-rise-1" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存' }}</button>

    <view class="card lb-rise-2" v-if="summary != null">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">今天共睡了 {{ sleepTotalMin }} 分钟 · 夜醒 {{ nightWakings }} 次</text></view>
      <text class="hint">0-3 月参考 14-17 小时/天，个体差异大；我们只记录，不评判</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  // #ifdef WEB
  import { pickDate, pickTime } from '../../utils/pickDate.uts'
  // #endif
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyBaby } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  function pad(n: number): string { return n < 10 ? '0' + n : '' + n }

  const now = new Date()
  const kind = ref<string>('nap')
  const wakings = ref<number>(0)
  const saving = ref<boolean>(false)
  const babyId = ref<string>('')
  const summary = ref<UTSJSONObject | null>(null)
  const startDate = ref<string>(`${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`)
  const startTime = ref<string>('13:00')
  const endDate = ref<string>(`${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`)
  const endTime = ref<string>('14:30')

  const sleepTotalMin = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('sleep') as UTSJSONObject | null)?.getNumber('totalMin')?.toInt() ?? 0)
  const nightWakings = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('sleep') as UTSJSONObject | null)?.getNumber('nightWakings')?.toInt() ?? 0)

  function onStartDateChange(v: string) { startDate.value = v }
  function onStartTimeChange(v: string) { startTime.value = v }
  function onEndDateChange(v: string) { endDate.value = v }
  function onEndTimeChange(v: string) { endTime.value = v }
  async function load() {
    try { summary.value = await luckyBaby('dailySummary', { journeyId: journeyState.journeyId, babyId: babyId.value } as UTSJSONObject) } catch (e) { /* 忽略 */ }
  }
  function tsOf(dateStr: string, timeStr: string): number {
    const p = timeStr.indexOf(':')
    const hh = parseInt(timeStr.slice(0, p)) || 0
    const mm = parseInt(timeStr.slice(p + 1)) || 0
    return Date.parse(`${dateStr}T${pad(hh)}:${pad(mm)}:00+08:00`)
  }
  async function save() {
    const startTs = tsOf(startDate.value, startTime.value)
    const endTs = tsOf(endDate.value, endTime.value)
    if (!(startTs > 0 && endTs > startTs)) { uni.showToast({ title: '醒来时间需晚于入睡时间', icon: 'none' }); return }
    saving.value = true
    try {
      await luckyBaby('addSleep', { journeyId: journeyState.journeyId, babyId: babyId.value, kind: kind.value, startTs, endTs, nightWakings: kind.value == 'night' ? wakings.value : 0 } as UTSJSONObject)
      uni.showToast({ title: '已记录 ✓', icon: 'success' })
      load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }

  onPageReady(() => {
    const stored = uni.getStorageSync('current_baby_id') as string
    babyId.value = stored ?? ''
    if (babyId.value.length == 0) {
      uni.showToast({ title: '请先在宝宝页选择宝宝', icon: 'none' })
      setTimeout(() => { uni.reLaunch({ url: '/pages/baby/baby-home' }) }, 800)
      return
    }
    load()
  })

  // #ifdef WEB
  async function onPickStartDateWeb() {
    const v = await pickDate(startDate.value, '')
    if (v.length > 0) {
      onStartDateChange(v)
    }
  }
  // #endif

  // #ifdef WEB
  async function onPickStartTimeWeb() {
    const v = await pickTime(startTime.value)
    if (v.length > 0) {
      onStartTimeChange(v)
    }
  }
  // #endif

  // #ifdef WEB
  async function onPickEndDateWeb() {
    const v = await pickDate(endDate.value, '')
    if (v.length > 0) {
      onEndDateChange(v)
    }
  }
  // #endif

  // #ifdef WEB
  async function onPickEndTimeWeb() {
    const v = await pickTime(endTime.value)
    if (v.length > 0) {
      onEndTimeChange(v)
    }
  }
  // #endif
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 26rpx; color: var(--lb-text-1); margin: 16rpx 0 12rpx 0; }
  .opts { flex-direction: row; }
  .opt { flex-direction: row; align-items: center; background-color: var(--lb-fill); border-radius: 24rpx; padding: 20rpx 32rpx; margin: 8rpx; transition: all 160ms ease-out; }
  .opt-ico { width: 34rpx; height: 34rpx; margin-right: 10rpx; }
  .opt-active { background-color: var(--lb-primary-soft); }
  .opt-text { font-size: 26rpx; color: var(--lb-text-2); }
  .opt-text-active { color: var(--lb-primary); font-weight: bold; }
  .row2 { flex-direction: row; }
  .half { flex: 1; margin: 0 8rpx; }
  .pick-box { width: 300rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; align-items: center; justify-content: center; transition: all 160ms ease-out; }
  .pick-text { font-size: 28rpx; color: var(--lb-text-1); }
  .wak-row { flex-direction: row; align-items: center; margin-top: 16rpx; }
  .label-inline { font-size: 26rpx; color: var(--lb-text-1); flex: 1; }
  .stepper { flex-direction: row; align-items: center; }
  .step-btn { width: 80rpx; height: 80rpx; border-radius: 24rpx; background-color: var(--lb-primary-soft); align-items: center; justify-content: center; transition: all 160ms ease-out; }
  .step-text { font-size: 40rpx; color: var(--lb-primary-deep); }
  .step-num { width: 120rpx; text-align: center; font-size: 40rpx; font-weight: bold; color: var(--lb-text-1); }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 32rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin-top: 12rpx; }

  .card-head { flex-direction: row; align-items: center; margin-bottom: 20rpx; }
  .title-bar { width: 8rpx; height: 30rpx; border-radius: 4rpx; background-image: linear-gradient(180deg, var(--lb-grad-1), var(--lb-grad-2)); margin-right: 14rpx; }
  .card-title-flush { margin-bottom: 0; }
  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
