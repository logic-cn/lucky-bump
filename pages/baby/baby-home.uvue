<template>
  <view class="page" :class="themeClass()">
    <lbc-error v-if="loadFailed" :message="errorMsg" @retry="load" />

    <view class="card lb-rise" v-if="babies.length == 0 && !loadFailed">
      <text class="empty">还没有宝宝档案</text>
      <button class="btn-save" hover-class="lb-press" hover-stay-time="120" @click="goRegister">去登记分娩</button>
    </view>

    <view v-for="(b, i) in babies" :key="i">
      <view class="hero lb-rise-1" :class="currentBabyId == b.getString('_id') ? 'hero-current' : ''" hover-class="lb-press" hover-stay-time="120" @click="selectBaby(b)">
        <text class="hero-name" :class="currentBabyId == b.getString('_id') ? 'hero-text-on' : ''">{{ b.getString('nickname') ?? '' }}</text>
        <text class="hero-sub" :class="currentBabyId == b.getString('_id') ? 'hero-sub-on' : ''">{{ monthText(b) }} · 出生 {{ b.getString('birthDate') ?? '' }}</text>
        <text class="hero-cur" v-if="currentBabyId == b.getString('_id')">当前记录对象</text>
      </view>

      <view class="summary lb-rise-2" v-if="currentBabyId == b.getString('_id') && summary != null">
        <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">今天</text></view>
        <view class="sum-row">
          <view class="sum-col"><text class="sum-num">{{ sumFeedCount }}</text><text class="sum-cap">喂养</text></view>
          <view class="sum-col"><text class="sum-num">{{ sumMl }}ml</text><text class="sum-cap">奶量</text></view>
          <view class="sum-col"><text class="sum-num">{{ sumDiaper }}</text><text class="sum-cap">尿布</text></view>
          <view class="sum-col"><text class="sum-num">{{ sumSleepMin }}m</text><text class="sum-cap">睡眠</text></view>
        </view>
        <view class="quick-row">
          <view class="btn-quick" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/baby/feeding')"><image class="btn-quick-icon" src="/static/icons/feeding.png" mode="aspectFit" /><text class="btn-quick-text">记喂养</text></view>
          <view class="btn-quick" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/baby/diaper')"><image class="btn-quick-icon" src="/static/icons/diaper.png" mode="aspectFit" /><text class="btn-quick-text">记尿布</text></view>
          <view class="btn-quick" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/baby/sleep')"><image class="btn-quick-icon" src="/static/icons/sleep.png" mode="aspectFit" /><text class="btn-quick-text">记睡眠</text></view>
        </view>
      </view>
    </view>

    <view class="card lb-rise-2" v-if="feedingGuide.length > 0">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">本月龄喂养参考</text></view>
      <text class="guide-text">{{ feedingGuide }}</text>
      <text class="hint">参考范围，不代表处方；按需喂养，儿保时与医生确认。</text>
    </view>

    <view class="card lb-rise-3">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">成长与照护</text></view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/baby/growth')"><image class="nav-icon" src="/static/icons/growth.png" mode="aspectFit" /><text class="nav-text">成长记录与百分位</text><text class="nav-arrow">›</text></view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/baby/album')"><image class="nav-icon" src="/static/icons/album.png" mode="aspectFit" /><text class="nav-text">成长相册</text><text class="nav-arrow">›</text></view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/baby/vaccines')"><image class="nav-icon" src="/static/icons/vaccine.png" mode="aspectFit" /><text class="nav-text">疫苗接种计划</text><text class="nav-arrow">›</text></view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/baby/milestones')"><image class="nav-icon" src="/static/icons/growth.png" mode="aspectFit" /><text class="nav-text">成长里程碑</text><text class="nav-arrow">›</text></view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/tools/solid-food-log')"><image class="nav-icon" src="/static/icons/bowl.png" mode="aspectFit" /><text class="nav-text">辅食记录与 3 天观察</text><text class="nav-arrow">›</text></view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/care/child-health')"><image class="nav-icon" src="/static/icons/clinic.png" mode="aspectFit" /><text class="nav-text">儿保体检记录</text><text class="nav-arrow">›</text></view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/record/nursing-timer')"><image class="nav-icon" src="/static/icons/timer.png" mode="aspectFit" /><text class="nav-text">亲喂计时器</text><text class="nav-arrow">›</text></view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="goRegister"><image class="nav-icon" src="/static/icons/add.png" mode="aspectFit" /><text class="nav-text">添加宝宝档案</text><text class="nav-arrow">›</text></view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyJourney, luckyBaby } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const babies = ref<UTSJSONObject[]>([])
  const summary = ref<UTSJSONObject | null>(null)
  const currentBabyId = ref<string>('')
  const loadFailed = ref<boolean>(false)
  const errorMsg = ref<string>('')

  const babyMonths = computed((): number => {
    for (let i = 0; i < babies.value.length; i++) {
      if ((babies.value[i].getString('_id') ?? '') == currentBabyId.value) {
        const birth = babies.value[i].getString('birthDate') ?? ''
        if (birth.length == 0) return -1
        const days = Math.floor((Date.now() - Date.parse(birth + 'T12:00:00Z')) / 86400000)
        return Math.floor(days / 30.4375)
      }
    }
    return -1
  })
  const feedingGuide = computed((): string => {
    const m = babyMonths.value
    if (m < 0) return ''
    if (m < 1) return '0-1 月：每天约 8-12 次，单次约 60-90ml；按需喂养，不强行灌喂'
    if (m < 2) return '1-2 月：每天约 7-9 次，单次约 90-120ml'
    if (m < 4) return '2-4 月：每天约 6-8 次，单次约 120-150ml'
    if (m < 6) return '4-6 月：每天约 5-6 次，单次约 150-180ml'
    if (m < 12) return '6-12 月：奶量约 600-800ml/天，配合辅食 2-3 餐'
    return '12 月以上：以家庭饮食为主，奶量按需'
  })

  const sumFeedCount = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('feeding') as UTSJSONObject | null)?.getNumber('count')?.toInt() ?? 0)
  const sumMl = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('feeding') as UTSJSONObject | null)?.getNumber('totalMl')?.toInt() ?? 0)
  const sumDiaper = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('diaper') as UTSJSONObject | null)?.getNumber('count')?.toInt() ?? 0)
  const sumSleepMin = computed((): number => ((summary.value as UTSJSONObject | null)?.getJSON('sleep') as UTSJSONObject | null)?.getNumber('totalMin')?.toInt() ?? 0)

  function go(url: string) { uni.navigateTo({ url }) }
  function goRegister() { uni.navigateTo({ url: '/pages/baby/birth-register' }) }
  function monthText(b: UTSJSONObject): string {
    const birth = b.getString('birthDate') ?? ''
    if (birth.length == 0) return ''
    const days = Math.floor((Date.now() - Date.parse(birth + 'T12:00:00Z')) / 86400000)
    const months = Math.floor(days / 30.4375)
    // 余数按真实天数差回算，避免出现"2 个月 29 天 → 3 个月 0 天"的跳变
    const rem = Math.max(0, Math.round(days - months * 30.4375))
    return `${months} 个月 ${rem} 天`
  }
  function selectBaby(b: UTSJSONObject) {
    currentBabyId.value = b.getString('_id') ?? ''
    journeyState.currentBabyId = currentBabyId.value
    uni.setStorageSync('current_baby_id', currentBabyId.value)
    loadSummary()
  }
  async function load() {
    try {
      const stored = uni.getStorageSync('current_baby_id') as string
      currentBabyId.value = stored ?? ''
      const res = await luckyJourney('listBabies', { journeyId: journeyState.journeyId } as UTSJSONObject)
      babies.value = res.getArray<UTSJSONObject>('babies') ?? []
      if (currentBabyId.value.length == 0 && babies.value.length > 0) {
        selectBaby(babies.value[0])
      } else {
        loadSummary()
      }
      loadFailed.value = false
    } catch (e) {
      // 失败时不能落成"还没有宝宝档案"，否则用户会以为档案丢了
      loadFailed.value = true
      errorMsg.value = (e as Error).message
    }
  }
  async function loadSummary() {
    if (currentBabyId.value.length == 0) { summary.value = null; return }
    try {
      summary.value = await luckyBaby('dailySummary', { journeyId: journeyState.journeyId, babyId: currentBabyId.value } as UTSJSONObject)
    } catch (e) {
      // 失败时不能落成"今天没喂过"，交由 lbc-error 显式提示并可重试
      summary.value = null
      loadFailed.value = true
      errorMsg.value = (e as Error).message
    }
  }

  onPageReady(() => { load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .empty { font-size: 30rpx; color: var(--lb-text-2); margin-bottom: 24rpx; }
  .btn-save { width: 620rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-action); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 24rpx; transition: all 160ms ease-out; }
  .hero { width: 702rpx; background-color: var(--lb-card); border-width: 2rpx; border-color: var(--lb-line); border-radius: 40rpx; padding: 40rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); transition: all 160ms ease-out; }
  .hero-current { background-image: linear-gradient(135deg, var(--lb-grad-1), var(--lb-grad-2)); border-color: transparent; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .hero-name { font-size: 40rpx; font-weight: bold; color: var(--lb-primary-text); }
  .hero-sub { font-size: 24rpx; color: var(--lb-text-2); margin-top: 8rpx; }
  .hero-text-on { color: var(--lb-white); }
  .hero-sub-on { color: var(--lb-white); }
  .hero-cur { font-size: 24rpx; color: #FFFFFF; background-color: rgba(50,20,35,0.30); border-radius: 16rpx; padding: 4rpx 12rpx; margin-top: 12rpx; align-self: flex-start; }
  .summary { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 32rpx; margin-top: 16rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 20rpx; }
  .guide-text { font-size: 26rpx; color: var(--lb-text-2); line-height: 44rpx; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); line-height: 38rpx; margin-top: 12rpx; }
  .sum-row { flex-direction: row; justify-content: space-between; }
  .sum-col { align-items: center; flex: 1; }
  .sum-num { font-size: 36rpx; font-weight: bold; color: var(--lb-primary-text); }
  .sum-cap { font-size: 24rpx; color: var(--lb-text-3); margin-top: 8rpx; }
  .quick-row { flex-direction: row; margin-top: 24rpx; }
  .btn-quick { flex: 1; height: 80rpx; flex-direction: row; align-items: center; justify-content: center; background-color: var(--lb-primary-soft); border-radius: 24rpx; margin: 0 6rpx; transition: all 160ms ease-out; }
  .btn-quick-icon { width: 30rpx; height: 30rpx; margin-right: 8rpx; }
  .btn-quick-text { font-size: 24rpx; color: var(--lb-primary-deep); }
  .nav-row { flex-direction: row; align-items: center; padding: 24rpx 0; border-bottom-width: 1px; border-bottom-color: var(--lb-line); transition: all 160ms ease-out; }
  .nav-text { font-size: 28rpx; color: var(--lb-text-1); flex: 1; }
  .nav-icon { width: 36rpx; height: 36rpx; margin-right: 16rpx; }
  .nav-arrow { font-size: 36rpx; color: var(--lb-arrow); }

.card-head { flex-direction: row; align-items: center; margin-bottom: 20rpx; }
  .title-bar { width: 8rpx; height: 30rpx; border-radius: 4rpx; background-image: linear-gradient(180deg, var(--lb-grad-1), var(--lb-grad-2)); margin-right: 14rpx; }
  .card-title-flush { margin-bottom: 0; }
  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
