<template>
  <view class="page">
    <view class="card">
      <text class="card-title">免疫规划疫苗（免费，共 {{ plan.length }} 剂次）</text>
      <view class="v-row" v-for="(v, i) in plan" :key="i">
        <view class="v-dot" :class="v.getString('status') == 'done' ? 'v-dot-done' : (v.getString('status') == 'due' ? 'v-dot-due' : 'v-dot-upcoming')" />
        <view class="v-body">
          <text class="v-name">{{ v.getString('name') ?? '' }} 第 {{ v.getNumber('dose')?.toInt() }} 剂</text>
          <text class="v-sub">{{ v.getNumber('ageMonths')?.toInt() }} 月龄 · 应接种 {{ v.getString('dueDate') ?? '' }}</text>
          <text class="v-record" v-if="v.getString('status') == 'done'">已接种 {{ (v.getJSON('record') as UTSJSONObject | null)?.getString('date') ?? '' }}</text>
        </view>
        <button class="btn-record" v-if="v.getString('status') != 'done'" @click="record(v)">接种了</button>
      </view>
      <text class="hint">漏种会持续提醒；不同省份程序细节略有差异，可在接种门诊核实后微调</text>
    </view>

    <view class="card">
      <text class="card-title">自费疫苗（自愿，咨询接种门诊）</text>
      <view class="v-row" v-for="(v, i) in selfPaid" :key="i">
        <view class="v-body">
          <text class="v-name">{{ v.getString('name') ?? '' }}</text>
          <text class="v-sub">{{ v.getString('ages') ?? '' }}</text>
        </view>
      </view>
    </view>
  
    <!-- 自绘提示弹窗（web 端 uni.showModal 回调不触发） -->
    <view class="mask" v-if="infoVisible">
      <view class="dialog">
        <text class="dlg-title">{{ infoTitle }}</text>
        <text class="dlg-content">{{ infoContent }}</text>
        <view class="dlg-actions">
          <text class="dlg-btn dlg-btn-ok" @click="infoVisible = false">知道了</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onLoad } from '@dcloudio/uni-app'
  import { luckyBaby } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'

  const babyId = ref<string>('')
  const infoVisible = ref<boolean>(false)
  const infoTitle = ref<string>('')
  const infoContent = ref<string>('')
  const plan = ref<UTSJSONObject[]>([])
  const selfPaid = ref<UTSJSONObject[]>([])

  async function load() {
    try {
      const res = await luckyBaby('getVaccinePlan', { journeyId: journeyState.journeyId, babyId: babyId.value } as UTSJSONObject)
      plan.value = res.getArray<UTSJSONObject>('plan') ?? []
      selfPaid.value = res.getArray<UTSJSONObject>('selfPaidCatalog') ?? []
    } catch (e) { /* 忽略 */ }
  }
  async function record(v: UTSJSONObject) {
    const now = new Date()
    const today = `${now.getFullYear()}-${now.getMonth() + 1 < 10 ? '0' + (now.getMonth() + 1) : '' + (now.getMonth() + 1)}-${now.getDate() < 10 ? '0' + now.getDate() : '' + now.getDate()}`
    try {
      const res = await luckyBaby('recordVaccine', {
        journeyId: journeyState.journeyId, babyId: babyId.value,
        code: v.getString('code') ?? '', name: v.getString('name') ?? '',
        dose: v.getNumber('dose')?.toInt() ?? 1, free: v.getBoolean('free') ?? true, date: today
      } as UTSJSONObject)
      const rl = res.getJSON('redline')
      if (rl != null) {
        infoTitle.value = '接种反应提示'
        infoContent.value = (rl as UTSJSONObject).getString('message') ?? ''
        infoVisible.value = true
      } else {
        uni.showToast({ title: '已记录 ✓', icon: 'success' })
      }
      load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    }
  }

  onLoad(() => {
    const stored = uni.getStorageSync('current_baby_id') as string
    babyId.value = stored ?? ''
    if (babyId.value.length == 0) {
      uni.showToast({ title: '请先在宝宝页选择宝宝', icon: 'none' })
      setTimeout(() => { uni.reLaunch({ url: '/pages/baby/baby-home' }) }, 800)
      return
    }
    load()
  })
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 40rpx; margin-top: 24rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: #1F2329; margin-bottom: 20rpx; }
  .v-row { flex-direction: row; align-items: center; padding: 16rpx 0; border-bottom-width: 1px; border-bottom-color: #F2F1EF; }
  .v-dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; margin-right: 16rpx; }
  .v-dot-done { background-color: #4CAF7D; }
  .v-dot-due { background-color: #E5484D; }
  .v-dot-upcoming { background-color: #D8DCE1; }
  .v-body { flex: 1; }
  .v-name { font-size: 28rpx; color: #1F2329; }
  .v-sub { font-size: 22rpx; color: #A3AAB5; margin-top: 4rpx; }
  .v-record { font-size: 22rpx; color: #4CAF7D; margin-top: 4rpx; }
  .btn-record { width: 140rpx; height: 64rpx; line-height: 64rpx; background-color: #FFEFEA; color: #E85D4E; font-size: 24rpx; border-radius: 32rpx; }
  .hint { font-size: 20rpx; color: #A3AAB5; margin-top: 24rpx; }

  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.45); justify-content: center; align-items: center; }
  .dialog { width: 560rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 40rpx 32rpx 24rpx 32rpx; }
  .dlg-title { font-size: 32rpx; font-weight: bold; color: #1F2329; text-align: center; }
  .dlg-content { font-size: 27rpx; color: #6B7280; margin-top: 20rpx; text-align: center; line-height: 40rpx; }
  .dlg-actions { flex-direction: row; justify-content: center; margin-top: 36rpx; }
  .dlg-btn { width: 300rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 29rpx; color: #FFFFFF; background-color: #FF7A6B; border-radius: 40rpx; }
</style>
