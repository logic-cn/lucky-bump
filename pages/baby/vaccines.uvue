<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">免疫规划疫苗（免费，共 {{ plan.length }} 剂次）</text></view>
      <view class="v-row" v-for="(v, i) in plan" :key="i">
        <view class="v-dot" :class="v.getString('status') == 'done' ? 'v-dot-done' : (v.getString('status') == 'due' ? 'v-dot-due' : 'v-dot-upcoming')" />
        <view class="v-body">
          <text class="v-name">{{ v.getString('name') ?? '' }} 第 {{ v.getNumber('dose')?.toInt() }} 剂</text>
          <text class="v-sub">{{ v.getNumber('ageMonths')?.toInt() }} 月龄 · 应接种 {{ v.getString('dueDate') ?? '' }}</text>
          <text class="v-record" v-if="v.getString('status') == 'done'">已接种 {{ (v.getJSON('record') as UTSJSONObject | null)?.getString('date') ?? '' }}</text>
        </view>
        <button class="btn-record" :class="v.getString('status') == 'due' ? 'btn-record-due' : ''" v-if="v.getString('status') != 'done'" hover-class="lb-press" hover-stay-time="120" @click="record(v)">接种了</button>
      </view>
      <text class="hint">漏种会持续提醒；不同省份程序细节略有差异，可在接种门诊核实后微调</text>
    </view>

    <view class="card lb-rise-1">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">自费疫苗（自愿，咨询接种门诊）</text></view>
      <view class="v-row" v-for="(v, i) in selfPaid" :key="i">
        <view class="v-body">
          <text class="v-name">{{ v.getString('name') ?? '' }}</text>
          <text class="v-sub">{{ v.getString('ages') ?? '' }}</text>
        </view>
      </view>
    </view>
  
    <!-- 自绘提示弹窗（web 端 uni.showModal 回调不触发） -->
    <view class="mask lb-fade" v-if="infoVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">{{ infoTitle }}</text>
        <text class="dlg-content">{{ infoContent }}</text>
        <view class="dlg-actions">
          <text class="dlg-btn dlg-btn-ok" hover-class="lb-press" hover-stay-time="120" @click="infoVisible = false">知道了</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyBaby } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const babyId = ref<string>('')
  const infoVisible = ref<boolean>(false)
  const infoTitle = ref<string>('')
  const infoContent = ref<string>('')
  const plan = ref<UTSJSONObject[]>([])
  const selfPaid = ref<UTSJSONObject[]>([])

  async function load() {
    try {
      const res = await luckyBaby('getVaccinePlan', { journeyId: journeyState.journeyId, babyId: babyId.value } as UTSJSONObject)
      plan.value = res.getArray<UTSJSONObject>('plan') ?? []
      selfPaid.value = res.getArray<UTSJSONObject>('selfPaidCatalog') ?? []
    } catch (e) { /* 忽略 */ }
  }
  async function record(v: UTSJSONObject) {
    const now = new Date()
    const today = `${now.getFullYear()}-${now.getMonth() + 1 < 10 ? '0' + (now.getMonth() + 1) : '' + (now.getMonth() + 1)}-${now.getDate() < 10 ? '0' + now.getDate() : '' + now.getDate()}`
    try {
      const res = await luckyBaby('recordVaccine', {
        journeyId: journeyState.journeyId, babyId: babyId.value,
        code: v.getString('code') ?? '', name: v.getString('name') ?? '',
        dose: v.getNumber('dose')?.toInt() ?? 1, free: v.getBoolean('free') ?? true, date: today
      } as UTSJSONObject)
      const rl = res.getJSON('redline')
      if (rl != null) {
        infoTitle.value = '接种反应提示'
        infoContent.value = (rl as UTSJSONObject).getString('message') ?? ''
        infoVisible.value = true
      } else {
        uni.showToast({ title: '已记录 ✓', icon: 'success' })
      }
      load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    }
  }

  onPageReady(() => {
    const stored = uni.getStorageSync('current_baby_id') as string
    babyId.value = stored ?? ''
    if (babyId.value.length == 0) {
      uni.showToast({ title: '请先在宝宝页选择宝宝', icon: 'none' })
      setTimeout(() => { uni.reLaunch({ url: '/pages/baby/baby-home' }) }, 800)
      return
    }
    load()
  })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 20rpx; }
  .v-row { flex-direction: row; align-items: center; padding: 16rpx 0; border-bottom-width: 1px; border-bottom-color: var(--lb-line); }
  .v-dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; margin-right: 16rpx; }
  .v-dot-done { background-color: var(--lb-success); }
  .v-dot-due { background-color: var(--lb-warning); }
  .v-dot-upcoming { background-color: var(--lb-line-deep); }
  .v-body { flex: 1; }
  .v-name { font-size: 28rpx; color: var(--lb-text-1); }
  .v-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 4rpx; }
  .v-record { font-size: 24rpx; color: var(--lb-success-text); background-color: var(--lb-success-soft); border-radius: 999rpx; padding: 4rpx 16rpx; margin-top: 4rpx; align-self: flex-start; }
  .btn-record { width: 140rpx; height: 64rpx; line-height: 64rpx; background-color: var(--lb-primary-soft); color: var(--lb-primary-deep); font-size: 24rpx; border-radius: 36rpx; transition: all 160ms ease-out; }
  .btn-record-due { background-color: var(--lb-action); color: #FFFFFF; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin-top: 24rpx; }

  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--lb-mask); justify-content: center; align-items: center; }
  .dialog { width: 560rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx 32rpx 24rpx 32rpx; }
  .dlg-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); text-align: center; }
  .dlg-content { font-size: 27rpx; color: var(--lb-text-2); margin-top: 20rpx; text-align: center; line-height: 40rpx; }
  .dlg-actions { flex-direction: row; justify-content: center; margin-top: 36rpx; }
  .dlg-btn { width: 300rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 29rpx; color: #FFFFFF; background-image: linear-gradient(135deg, var(--lb-grad-1), var(--lb-grad-2)); border-radius: 999rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }

  .card-head { flex-direction: row; align-items: center; margin-bottom: 20rpx; }
  .title-bar { width: 8rpx; height: 30rpx; border-radius: 4rpx; background-image: linear-gradient(180deg, var(--lb-grad-1), var(--lb-grad-2)); margin-right: 14rpx; }
  .card-title-flush { margin-bottom: 0; }
  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
