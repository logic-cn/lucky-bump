<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">分娩日期</text>
      <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-date-field :value="deliveryDate" @change="onDateChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view hover-class="lb-press" hover-stay-time="120" @click="onPickDeliveryWeb">
        <view class="date-box" hover-class="lb-press" hover-stay-time="120"><text class="date-text">{{ deliveryDate == '' ? '选择日期' : deliveryDate }}</text></view>
      </view>
    <!-- #endif -->
      <text class="label">分娩方式</text>
      <view class="opts">
        <view class="opt" hover-class="lb-press" hover-stay-time="120" v-for="(m, i) in modes" :key="i" :class="mode == m.value ? 'opt-active' : ''" @click="mode = m.value">
          <text class="opt-text" :class="mode == m.value ? 'opt-text-active' : ''">{{ m.label }}</text>
        </view>
      </view>
      <text class="label">医院（选填）</text>
      <input class="input" v-model="hospital" placeholder="分娩医院" placeholder-class="ph" />
      <text class="label">宝宝信息</text>
      <view class="baby" v-for="(b, i) in babies" :key="i">
        <text class="baby-tag">{{ babies.length > 1 ? `宝宝 ${i + 1}` : '宝宝' }}</text>
        <view class="row2">
          <input class="input half" v-model="b.nickname" placeholder="小名" placeholder-class="ph" />
          <view class="half sex-row">
            <view class="sex-chip" :class="b.sex == 1 ? 'sex-chip-sel' : ''" hover-class="lb-press" hover-stay-time="120" @click="babies.value[i].sex = 1"><text class="sex-chip-text" :class="b.sex == 1 ? 'sex-chip-text-sel' : ''">{{ sexLabels[1] }}</text></view>
            <view class="sex-chip" :class="b.sex == 2 ? 'sex-chip-sel' : ''" hover-class="lb-press" hover-stay-time="120" @click="babies.value[i].sex = 2"><text class="sex-chip-text" :class="b.sex == 2 ? 'sex-chip-text-sel' : ''">{{ sexLabels[2] }}</text></view>
          </view>
        </view>
        <view class="row2">
          <input class="input half" type="number" v-model="b.weightG" placeholder="出生体重 g" placeholder-class="ph" />
          <input class="input half" type="number" v-model="b.lengthCm" placeholder="出生身长 cm" placeholder-class="ph" />
        </view>
      </view>
      <view class="add-baby" hover-class="lb-press" hover-stay-time="120" v-if="babies.length < fetusCount" @click="addBaby"><text class="add-baby-text">＋ 添加{{ fetusCount > 1 ? '另一个宝宝' : '' }}</text></view>
    </view>
    <button class="btn-save lb-rise-1" hover-class="lb-press" hover-stay-time="120" :disabled="saving" @click="save">{{ saving ? '登记中…' : '完成分娩登记' }}</button>
    <text class="hint">登记后自动生成宝宝档案、产褥期时钟、出生卡与疫苗计划</text>

    <!-- 出生卡（登记成功后展示，可复制分享文案） -->
    <view class="mask lb-fade" v-if="cardVisible">
      <view class="bcard lb-pop">
        <text class="bcard-kicker">BIRTH CARD</text>
        <text class="bcard-date">{{ deliveredAt }}</text>
        <text class="bcard-names">{{ cardNames }}</text>
        <text class="bcard-meta">{{ cardMeta }}</text>
        <text class="bcard-wish">欢迎来到这个世界，愿被温柔以待</text>
        <view class="bcard-actions">
          <text class="bcard-btn bcard-btn-ghost" @click="copyCard">复制分享文案</text>
          <text class="bcard-btn" @click="closeCard">进入宝宝首页</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  // #ifdef WEB
  import { pickDate } from '../../utils/pickDate.uts'
  // #endif
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyJourney } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type BabyForm = { nickname: string, sex: number, weightG: string, lengthCm: string }
  type MOpt = { value: string, label: string }

  const deliveryDate = ref<string>('')
  const mode = ref<string>('vaginal')
  const hospital = ref<string>('')
  const saving = ref<boolean>(false)
  const fetusCount = ref<number>(1)
  const babies = ref<BabyForm[]>([{ nickname: '', sex: 2, weightG: '', lengthCm: '' } as BabyForm])
  const modes = ref<MOpt[]>([
    { value: 'vaginal', label: '顺产' }, { value: 'assisted', label: '助产' }, { value: 'c_section', label: '剖宫产' }
  ])
  const sexLabels = ref<string[]>(['男', '女', '还不告诉你们'])
  const cardVisible = ref<boolean>(false)
  const deliveredAt = ref<string>('')
  const cardNames = ref<string>('')
  const cardMeta = ref<string>('')

  function buildCard(list: BabyForm[]) {
    deliveredAt.value = deliveryDate.value
    const names: string[] = []
    const metas: string[] = []
    for (let i = 0; i < list.length; i++) {
      names.push(list[i].nickname)
      const parts: string[] = []
      const w = parseInt(list[i].weightG)
      const l = parseFloat(list[i].lengthCm)
      if (w > 0) parts.push(`${w}g`)
      if (l > 0) parts.push(`${l}cm`)
      if (parts.length > 0) metas.push(`${list[i].nickname} ${parts.join(' · ')}`)
    }
    cardNames.value = names.join(' & ')
    cardMeta.value = metas.join('　')
  }
  function cardShareText(): string {
    return `${deliveredAt.value}，${cardNames.value} 平安出生啦 🎉${cardMeta.value.length > 0 ? '\n' + cardMeta.value : ''}\n—— 来自幸孕记`
  }
  function copyCard() {
    uni.setClipboardData({
      data: cardShareText(),
      success: () => { uni.showToast({ title: '文案已复制', icon: 'none' }) }
    })
  }
  function closeCard() {
    cardVisible.value = false
    uni.reLaunch({ url: '/pages/baby/baby-home' })
  }

  function onDateChange(v: string) { deliveryDate.value = v }
  function addBaby() { babies.value.push({ nickname: '', sex: 2, weightG: '', lengthCm: '' } as BabyForm) }
  async function save() {
    if (deliveryDate.value.length == 0) { uni.showToast({ title: '请选择分娩日期', icon: 'none' }); return }
    const list = babies.value.map((b, i) => ({
      nickname: b.nickname.trim().length > 0 ? b.nickname : `宝宝${i + 1}`,
      sex: ['male', 'female', 'unknown'][b.sex],
      weightG: parseInt(b.weightG) || 0,
      lengthCm: parseFloat(b.lengthCm) || 0
    }))
    saving.value = true
    try {
      const res = await luckyJourney('registerDelivery', {
        journeyId: journeyState.journeyId, deliveryDate: deliveryDate.value,
        deliveryMode: mode.value, hospital: hospital.value, babies: list
      } as UTSJSONObject)
      const ids = res.getArray('babyIds') ?? []
      if (ids.length > 0) {
        journeyState.currentBabyId = (ids[0] as string)
        uni.setStorageSync('current_baby_id', ids[0])
      }
      uni.showToast({ title: '欢迎小宝贝 🎉', icon: 'none' })
      buildCard(list)
      cardVisible.value = true
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }

  onPageReady(() => {
    fetusCount.value = journeyState.fetusCount > 0 ? journeyState.fetusCount : 1
  })

  // #ifdef WEB
  async function onPickDeliveryWeb() {
    const v = await pickDate(deliveryDate.value, '')
    if (v.length > 0) {
      onDateChange(v)
    }
  }
  // #endif
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 26rpx; color: var(--lb-text-1); margin: 20rpx 0 12rpx 0; }
  .date-box { width: 620rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; align-items: center; padding: 0 24rpx; transition: all 160ms ease-out; }
  .date-text { font-size: 28rpx; color: var(--lb-text-1); }
  .opts { flex-direction: row; }
  .opt { background-color: var(--lb-fill); border-radius: 24rpx; padding: 20rpx 28rpx; margin-right: 12rpx; transition: all 160ms ease-out; }
  .opt-active { background-color: var(--lb-primary-soft); }
  .opt-text { font-size: 26rpx; color: var(--lb-text-2); }
  .opt-text-active { color: var(--lb-primary-deep); font-weight: bold; }
  .input { width: 100%; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); }
  .center { align-items: center; justify-content: center; }
  .row2 { flex-direction: row; margin-bottom: 12rpx; }
  .half { flex: 1; margin-right: 12rpx; }
  .baby { background-color: var(--lb-fill); border-radius: 24rpx; padding: 20rpx; margin-bottom: 12rpx; }
  .baby-tag { font-size: 24rpx; color: var(--lb-primary-deep); font-weight: bold; margin-bottom: 8rpx; }
  .add-baby { align-items: center; padding: 16rpx; transition: all 160ms ease-out; }
  .add-baby-text { font-size: 26rpx; color: var(--lb-primary); }
  .ph { color: var(--lb-text-3); }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 32rpx; transition: all 160ms ease-out; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin-top: 24rpx; }

  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--lb-mask); justify-content: center; align-items: center; }
  .bcard { width: 600rpx; background-color: var(--lb-card); border-radius: 40rpx; padding: 48rpx 40rpx 32rpx 40rpx; align-items: center; }
  .bcard-kicker { font-size: 24rpx; color: var(--lb-text-3); letter-spacing: 6rpx; }
  .bcard-date { font-size: 30rpx; color: var(--lb-text-2); margin-top: 20rpx; }
  .bcard-names { font-size: 48rpx; font-weight: bold; color: var(--lb-primary-deep); margin-top: 16rpx; text-align: center; }
  .bcard-meta { font-size: 26rpx; color: var(--lb-text-2); margin-top: 16rpx; }
  .bcard-wish { font-size: 24rpx; color: var(--lb-text-3); margin-top: 28rpx; text-align: center; }
  .bcard-actions { flex-direction: row; margin-top: 40rpx; }
  .bcard-btn { font-size: 26rpx; color: #FFFFFF; background-color: var(--lb-primary); border-radius: 40rpx; padding: 16rpx 28rpx; margin-left: 16rpx; }
  .bcard-btn-ghost { color: var(--lb-text-2); background-color: var(--lb-fill); margin-left: 0; }

  .sex-row { flex-direction: row; }
  .sex-chip { flex: 1; height: 88rpx; border-radius: 24rpx; background-color: var(--lb-fill); align-items: center; justify-content: center; margin-right: 12rpx; }
  .sex-chip-sel { background-color: var(--lb-primary-soft); }
  .sex-chip-text { font-size: 28rpx; color: var(--lb-text-2); }
  .sex-chip-text-sel { color: var(--lb-primary-deep); font-weight: bold; }
  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
