<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">测量日期</text>
      <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-date-field :value="measureDate" @change="onDateChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view hover-class="lb-press" hover-stay-time="120" @click="onPickMeasureDateWeb">
        <view class="pick-box wide" hover-class="lb-press" hover-stay-time="120"><text class="pick-text">{{ measureDate }}</text></view>
      </view>
    <!-- #endif -->
      <text class="label">体重（kg）</text>
      <input class="input" type="number" v-model="weightKg" placeholder="如 6.8" placeholder-class="ph" />
      <text class="label">身长（cm，选填）</text>
      <input class="input" type="number" v-model="heightCm" placeholder="如 62.5" placeholder-class="ph" />
      <text class="label">头围（cm，选填）</text>
      <input class="input" type="number" v-model="headCm" placeholder="如 41.0" placeholder-class="ph" />
    </view>
    <button class="btn-save lb-rise-1" :disabled="saving" @click="save">{{ saving ? '计算中…' : '保存并看百分位' }}</button>

    <view class="card lb-rise-2" v-if="result != null">
      <text class="card-title">本次结果（{{ resultMonthAge }} 月龄，参照 WHO 标准）</text>
      <view class="pct-row">
        <view class="pct-col" v-if="pctWeight.length > 0"><text class="pct-num">{{ pctWeight }}</text><text class="pct-cap">体重百分位</text></view>
        <view class="pct-col" v-if="pctHeight.length > 0"><text class="pct-num">{{ pctHeight }}</text><text class="pct-cap">身长百分位</text></view>
        <view class="pct-col" v-if="pctHead.length > 0"><text class="pct-num">{{ pctHead }}</text><text class="pct-cap">头围百分位</text></view>
      </view>
      <view class="alert" v-if="alerts.length > 0">
        <text class="alert-text" v-for="(a, i) in alerts" :key="i">{{ a }}</text>
      </view>
      <text class="hint">百分位为参考趋势，不构成诊断；早产宝宝请按矫正月龄与医生沟通</text>
    </view>

    <lbc-error v-if="historyFailed" message="历史测量记录加载失败" @retry="load" />

    <view class="card lb-rise-2" v-if="chartRows.length > 0">
      <text class="card-title">体重趋势（最近 {{ chartRows.length }} 次）</text>
      <view class="chart">
        <view class="bar-col" v-for="(s, i) in chartRows" :key="i">
          <view class="bar" :style="{ height: kgBar(s.kg) + 'rpx' }" />
          <text class="bar-date">{{ s.date.slice(5) }}</text>
          <text class="bar-val">{{ s.kg }}</text>
        </view>
      </view>
    </view>

    <view class="card lb-rise-3" v-if="samples.length > 0">
      <text class="card-title">历史测量</text>
      <view class="s-row" v-for="(s, i) in samples" :key="i">
        <text class="s-date">{{ s.date }}</text>
        <text class="s-val">{{ s.val }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  // #ifdef WEB
  import { pickDate } from '../../utils/pickDate.uts'
  // #endif
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyBaby } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type SRow = { date: string, val: string, kg: number }

  const babyId = ref<string>('')
  const saving = ref<boolean>(false)
  const result = ref<UTSJSONObject | null>(null)
  const measureDate = ref<string>('')
  const weightKg = ref<string>('')
  const heightCm = ref<string>('')
  const headCm = ref<string>('')
  const resultMonthAge = ref<number>(0)
  const alerts = ref<string[]>([])
  const samples = ref<SRow[]>([])
  const historyFailed = ref<boolean>(false)

  function pctStr(key: string): string {
    const p = (result.value as UTSJSONObject | null)?.getJSON('percentiles') as UTSJSONObject | null
    const v = p?.getNumber(key)
    return v == null ? '' : `P${Math.round(v as number)}`
  }

  const pctWeight = computed((): string => pctStr('weightPct'))
  const pctHeight = computed((): string => pctStr('heightPct'))
  const pctHead = computed((): string => pctStr('headPct'))

  // 体重趋势：按时间正序取最近 7 次有体重的测量
  const chartRows = computed((): SRow[] => {
    const out: SRow[] = []
    for (let i = samples.value.length - 1; i >= 0; i--) {
      if (samples.value[i].kg > 0) out.push(samples.value[i])
    }
    return out.slice(Math.max(0, out.length - 7))
  })
  const maxKg = computed((): number => {
    let mx = 1
    for (let i = 0; i < chartRows.value.length; i++) {
      if (chartRows.value[i].kg > mx) mx = chartRows.value[i].kg
    }
    return mx
  })
  function kgBar(kg: number): number {
    return Math.max(24, Math.round(kg / maxKg.value * 150))
  }

  function onDateChange(v: string) { measureDate.value = v }
  async function load() {
    try {
      const res = await luckyBaby('getGrowthSeries', { journeyId: journeyState.journeyId, babyId: babyId.value } as UTSJSONObject)
      const arr = res.getArray('samples') ?? []
      const rows: SRow[] = []
      for (let i = arr.length - 1; i >= 0 && i >= arr.length - 8; i--) {
        const s = arr[i] as UTSJSONObject
        const w = s.getNumber('weight_kg') ?? 0
        const h = s.getNumber('height_cm') ?? 0
        rows.push({
          date: new Date(s.getNumber('measure_date') ?? 0).toISOString().slice(0, 10),
          val: `${w > 0 ? w + 'kg ' : ''}${h > 0 ? h + 'cm' : ''}`,
          kg: w
        })
      }
      samples.value = rows
      historyFailed.value = false
    } catch (e) {
      historyFailed.value = true
    }
  }
  async function save() {
    const w = parseFloat(weightKg.value)
    const h = parseFloat(heightCm.value)
    const head = parseFloat(headCm.value)
    if (!(w > 0) && !(h > 0) && !(head > 0)) { uni.showToast({ title: '至少填写一项测量值', icon: 'none' }); return }
    saving.value = true
    try {
      result.value = await luckyBaby('addGrowth', {
        journeyId: journeyState.journeyId, babyId: babyId.value, measureDate: measureDate.value,
        weightKg: w > 0 ? w : 0, heightCm: h > 0 ? h : 0, headCm: head > 0 ? head : 0
      } as UTSJSONObject)
      resultMonthAge.value = (result.value as UTSJSONObject).getNumber('monthAge')?.toInt() ?? 0
      const rawAlerts = (result.value as UTSJSONObject).getArray('alerts') ?? []
      alerts.value = rawAlerts.map(a => a as string)
      uni.showToast({ title: '已记录 ✓', icon: 'success' })
      load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }

  onPageReady(() => {
    const stored = uni.getStorageSync('current_baby_id') as string
    babyId.value = stored ?? ''
    if (babyId.value.length == 0) {
      uni.showToast({ title: '请先在宝宝页选择宝宝', icon: 'none' })
      setTimeout(() => { uni.reLaunch({ url: '/pages/baby/baby-home' }) }, 800)
      return
    }
    const now = new Date()
    measureDate.value = `${now.getFullYear()}-${now.getMonth() + 1 < 10 ? '0' + (now.getMonth() + 1) : '' + (now.getMonth() + 1)}-${now.getDate() < 10 ? '0' + now.getDate() : '' + now.getDate()}`
    load()
  })

  // #ifdef WEB
  async function onPickMeasureDateWeb() {
    const v = await pickDate(measureDate.value, '')
    if (v.length > 0) {
      onDateChange(v)
    }
  }
  // #endif
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 26rpx; color: var(--lb-text-1); margin: 16rpx 0 12rpx 0; }
  .pick-box { height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; align-items: center; justify-content: center; transition: all 160ms ease-out; }
  .pick-box.wide { width: 620rpx; }
  .pick-text { font-size: 28rpx; color: var(--lb-text-1); }
  .input { width: 620rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); }
  .ph { color: var(--lb-text-3); }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 32rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 20rpx; }
  .pct-row { flex-direction: row; }
  .pct-col { align-items: center; margin: 0 24rpx; }
  .pct-num { font-size: 44rpx; font-weight: bold; color: var(--lb-primary); }
  .pct-cap { font-size: 24rpx; color: var(--lb-text-3); margin-top: 8rpx; }
  .alert { width: 620rpx; background-color: var(--lb-warning-soft); border-radius: 24rpx; padding: 20rpx; margin-top: 20rpx; }
  .alert-text { font-size: 24rpx; color: var(--lb-warning); }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin-top: 20rpx; }
  .s-row { flex-direction: row; padding: 10rpx 0; }
  .chart { flex-direction: row; align-items: flex-end; justify-content: space-between; width: 622rpx; height: 220rpx; margin-top: 12rpx; }
  .bar-col { flex: 1; align-items: center; }
  .bar { width: 28rpx; background-color: var(--lb-primary-soft); border-radius: 8rpx 8rpx 0 0; }
  .bar-date { font-size: 24rpx; color: var(--lb-text-3); margin-top: 8rpx; }
  .bar-val { font-size: 24rpx; color: var(--lb-primary-deep); font-weight: bold; }
  .s-date { width: 220rpx; font-size: 24rpx; color: var(--lb-text-3); }
  .s-val { font-size: 26rpx; color: var(--lb-text-1); }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
