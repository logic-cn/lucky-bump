<template>
  <view class="page" :class="themeClass()">
    <text class="lock-icon">🔒</text>
    <text class="lock-title">幸孕记已锁定</text>
    <text class="lock-sub">{{ subText }}</text>
    <button class="btn-unlock" hover-class="lb-press" hover-stay-time="120" :disabled="unlocking" @click="tryUnlock">{{ unlocking ? '验证中…' : '解锁' }}</button>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { isBiometricAvailable, authenticate } from '../../utils/biometric.uts'
  import { markUnlocked } from '../../store/appStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const unlocking = ref<boolean>(false)
  const subText = ref<string>(isBiometricAvailable() ? '验证面容或指纹后继续使用' : '验证身份后继续使用')

  function goHome() {
    markUnlocked()
    uni.reLaunch({ url: '/pages/index/index' })
  }

  async function tryUnlock() {
    if (unlocking.value) return
    unlocking.value = true
    if (isBiometricAvailable()) {
      const ok = await authenticate('解锁幸孕记')
      unlocking.value = false
      if (ok) { goHome(); return }
      subText.value = '验证未通过，请重试'
      return
    }
    unlocking.value = false
    // 无生物识别能力：降级为直接进入（会话仍受 token 保护，见 docs/08 §8）
    goHome()
  }
</script>

<style>
  @import '../../theme.scss';
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); align-items: center; justify-content: center; padding: 48rpx; }
  .lock-icon { font-size: 96rpx; }
  .lock-title { font-size: 38rpx; font-weight: bold; color: var(--lb-text-1); margin-top: 24rpx; }
  .lock-sub { font-size: 26rpx; color: var(--lb-text-3); margin-top: 12rpx; text-align: center; }
  .btn-unlock { width: 400rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 48rpx; transition: all 160ms ease-out; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
