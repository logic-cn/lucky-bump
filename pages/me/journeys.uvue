<template>
  <view class="page" :class="themeClass()">
    <lbc-error v-if="loadFailed" :message="errorMsg" @retry="load" />

    <view class="card lb-rise" v-for="(j, i) in journeys" :key="i" :class="j.getString('_id') == currentId ? 'card-current' : ''">
      <view class="j-head">
        <view class="j-title-wrap">
          <text class="j-title">{{ titleOf(j) }}</text>
          <text class="j-badge" v-if="j.getString('_id') == currentId">当前</text>
          <text class="j-badge j-badge-archived" v-if="j.getBoolean('archived') == true">已归档</text>
          <text class="j-badge j-badge-mourning" v-if="j.getBoolean('mourning') == true">关怀模式</text>
        </view>
        <text class="j-stage">{{ stageLabel(j) }}</text>
      </view>
      <text class="j-sub">{{ dateLine(j) }}</text>
      <view class="j-actions">
        <view class="j-btn" v-if="j.getString('_id') != currentId && j.getBoolean('archived') != true" hover-class="lb-press" hover-stay-time="120" @click="switchTo(j)">
          <text class="j-btn-text">设为当前</text>
        </view>
        <view class="j-btn" hover-class="lb-press" hover-stay-time="120" @click="openRename(j)">
          <text class="j-btn-text">重命名</text>
        </view>
        <view class="j-btn j-btn-ghost" v-if="j.getBoolean('archived') != true" hover-class="lb-press" hover-stay-time="120" @click="askArchive(j)">
          <text class="j-btn-text j-btn-text-ghost">归档</text>
        </view>
      </view>
    </view>

    <lbc-empty v-if="!loadFailed && journeys.length == 0" title="还没有旅程" hint="完成建档后，旅程会出现在这里" ctaText="去建档" @cta="goOnboarding" />

    <text class="foot-hint">归档的旅程会完整保留数据，可随时回看；已归档旅程不能设为当前。</text>

    <!-- 重命名弹窗 -->
    <view class="mask lb-fade" v-if="renameVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">重命名旅程</text>
        <input class="dlg-input" v-model="renameText" placeholder="1-20 个字" placeholder-class="ph" confirm-type="done" @confirm="doRename" />
        <view class="dlg-actions">
          <text class="dlg-btn dlg-btn-cancel" hover-class="lb-press" hover-stay-time="120" @click="renameVisible = false">取消</text>
          <text class="dlg-btn dlg-btn-ok" hover-class="lb-press" hover-stay-time="120" @click="doRename">{{ saving ? '保存中…' : '保存' }}</text>
        </view>
      </view>
    </view>

    <lbc-dialog :visible="archiveVisible" title="归档这段旅程？" :content="'「' + archiveTitle + '」归档后数据完整保留，但不能继续记录；可在本页回看。'" confirmText="归档" tone="danger" @confirm="doArchive" @cancel="archiveVisible = false" />
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyJourney } from '../../utils/request.uts'
  import { journeyState, loadCurrentJourney, stageText } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const journeys = ref<UTSJSONObject[]>([])
  const currentId = ref<string>('')
  const loadFailed = ref<boolean>(false)
  const errorMsg = ref<string>('')

  const renameVisible = ref<boolean>(false)
  const renameText = ref<string>('')
  const renameId = ref<string>('')
  const saving = ref<boolean>(false)
  const archiveVisible = ref<boolean>(false)
  const archiveId = ref<string>('')
  const archiveTitle = ref<string>('')

  function titleOf(j: UTSJSONObject): string {
    const t = j.getString('title') ?? ''
    return t.length > 0 ? t : '未命名旅程'
  }

  function stageLabel(j: UTSJSONObject): string {
    if (j.getBoolean('archived') == true) return '已归档'
    if (j.getBoolean('mourning') == true) return '关怀模式'
    const s = j.getString('stage') ?? ''
    const t = stageText(s)
    return t.length > 0 ? t : s
  }

  function dateLine(j: UTSJSONObject): string {
    const d = j.getString('deliveryDate') ?? ''
    if (d.length > 0) return `分娩 ${d}`
    const e = j.getString('edd') ?? ''
    if (e.length > 0) return `预产期 ${e}`
    const l = j.getString('lmpDate') ?? ''
    if (l.length > 0) return `末次月经 ${l}`
    const c = j.getString('createdAt') ?? ''
    return c.length > 0 ? `创建于 ${c}` : ''
  }

  async function load() {
    try {
      const r = await luckyJourney('listJourneys', {} as UTSJSONObject)
      journeys.value = r.getArray<UTSJSONObject>('journeys') ?? []
      currentId.value = r.getString('currentId') ?? ''
      loadFailed.value = false
    } catch (e) {
      loadFailed.value = true
      errorMsg.value = (e as Error).message
    }
  }

  async function switchTo(j: UTSJSONObject) {
    try {
      await luckyJourney('setCurrentJourney', { journeyId: j.getString('_id') ?? '' } as UTSJSONObject)
      await loadCurrentJourney()
      uni.showToast({ title: '已切换旅程', icon: 'none' })
      setTimeout(() => { uni.switchTab({ url: '/pages/index/index' }) }, 400)
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    }
  }

  function openRename(j: UTSJSONObject) {
    renameId.value = j.getString('_id') ?? ''
    renameText.value = j.getString('title') ?? ''
    renameVisible.value = true
  }

  async function doRename() {
    if (saving.value) return
    const t = renameText.value.trim()
    if (t.length == 0) { uni.showToast({ title: '名称不能为空', icon: 'none' }); return }
    saving.value = true
    try {
      await luckyJourney('updateJourneyTitle', { journeyId: renameId.value, title: t } as UTSJSONObject)
      renameVisible.value = false
      if (renameId.value == journeyState.journeyId) journeyState.title = t
      await load()
      uni.showToast({ title: '已重命名', icon: 'none' })
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally {
      saving.value = false
    }
  }

  function askArchive(j: UTSJSONObject) {
    archiveId.value = j.getString('_id') ?? ''
    archiveTitle.value = titleOf(j)
    archiveVisible.value = true
  }

  async function doArchive() {
    archiveVisible.value = false
    try {
      await luckyJourney('archiveJourney', { journeyId: archiveId.value } as UTSJSONObject)
      await loadCurrentJourney()
      await load()
      uni.showToast({ title: '已归档', icon: 'none' })
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    }
  }

  function goOnboarding() { uni.reLaunch({ url: '/pages/onboarding/onboarding' }) }

  onPageReady(() => { load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 32rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-current { border-width: 2rpx; border-color: var(--lb-primary-soft); }
  .j-head { flex-direction: row; align-items: flex-start; }
  .j-title-wrap { flex: 1; flex-direction: row; flex-wrap: wrap; align-items: center; }
  .j-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); margin-right: 12rpx; }
  .j-badge { font-size: 24rpx; color: var(--lb-primary-text); background-color: var(--lb-primary-soft); border-radius: 10rpx; padding: 2rpx 10rpx; margin-right: 8rpx; }
  .j-badge-archived { color: var(--lb-text-3); background-color: var(--lb-fill); }
  .j-badge-mourning { color: var(--lb-secondary-deep); background-color: var(--lb-secondary-soft); }
  .j-stage { font-size: 26rpx; color: var(--lb-text-2); }
  .j-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 8rpx; }
  .j-actions { flex-direction: row; margin-top: 20rpx; }
  .j-btn { min-height: 64rpx; padding: 0 28rpx; border-radius: 32rpx; background-color: var(--lb-primary-soft); align-items: center; justify-content: center; margin-right: 16rpx; }
  .j-btn-ghost { background-color: var(--lb-fill); }
  .j-btn-text { font-size: 24rpx; color: var(--lb-primary-text); font-weight: bold; }
  .j-btn-text-ghost { color: var(--lb-text-3); }
  .foot-hint { font-size: 24rpx; color: var(--lb-text-3); line-height: 38rpx; margin-top: 24rpx; width: 702rpx; }
  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--lb-mask); align-items: center; justify-content: center; }
  .dialog { width: 600rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx 32rpx 32rpx 32rpx; align-items: center; }
  .dlg-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); text-align: center; }
  .dlg-input { width: 500rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); margin-top: 24rpx; }
  .ph { color: var(--lb-text-3); }
  .dlg-actions { flex-direction: row; margin-top: 28rpx; }
  .dlg-btn { min-width: 200rpx; height: 76rpx; line-height: 76rpx; padding: 0 32rpx; border-radius: 38rpx; text-align: center; font-size: 28rpx; margin: 0 10rpx; }
  .dlg-btn-cancel { background-color: var(--lb-fill); color: var(--lb-text-2); }
  .dlg-btn-ok { background-color: var(--lb-action); color: var(--lb-white); font-weight: bold; }
  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
