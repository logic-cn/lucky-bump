<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="card-title">家庭成员（{{ members.length }}）</text>
      <view class="m-row" v-for="(m, i) in members" :key="i">
        <view class="m-avatar"><text class="m-avatar-text">{{ (m.getString('nickname') ?? '?').slice(0, 1) }}</text></view>
        <view class="m-body">
          <text class="m-name">{{ m.getString('nickname') ?? '' }}{{ m.getBoolean('isMe') == true ? '（我）' : '' }}</text>
          <text class="m-role">{{ roleText(m.getString('role') ?? '') }}</text>
        </view>
        <view class="m-action-wrap" hover-class="lb-press" hover-stay-time="120" v-if="isOwner && !(m.getBoolean('isMe') == true)">
          <text class="m-action" @click="remove(m)">移除</text>
        </view>
      </view>
    </view>

    <view class="card lb-rise-1" v-if="isOwner">
      <text class="card-title">邀请家人</text>
      <text class="hint">爸爸成为"记录者"后可共同记录喂养、夜奶与产检；长辈默认只读。</text>
      <view class="btn-row">
        <button class="btn-half" hover-class="lb-press" hover-stay-time="120" @click="invite('recorder')">邀请爸爸（可记录）</button>
        <button class="btn-half btn-gray" hover-class="lb-press" hover-stay-time="120" @click="invite('viewer')">邀请长辈（只读）</button>
      </view>
      <view class="code-box" v-if="inviteCode.length > 0">
        <text class="code-text">邀请码：{{ inviteCode }}（3 天内有效）</text>
      </view>
    </view>

    <view class="card lb-rise-2" v-if="!isOwner && joinCodeMode">
      <text class="card-title">加入家庭</text>
      <input class="input" v-model="joinCode" placeholder="输入邀请码" placeholder-class="ph" />
      <button class="btn-save" hover-class="lb-press" hover-stay-time="120" @click="join">加入</button>
    </view>
    <view class="card lb-rise-2" v-if="!isOwner && !joinCodeMode">
      <text class="hint">你是受邀加入的成员，感谢一起记录宝宝的成长 🌟</text>
      <view class="link-wrap" hover-class="lb-press" hover-stay-time="120">
        <text class="link" @click="joinCodeMode = true">我要用邀请码加入其他家庭</text>
      </view>
    </view>

    <view class="card lb-rise-3" v-if="isOwner">
      <text class="card-title">数据组授权（记录者）</text>
      <view class="p-row" v-for="(g, i) in groups" :key="i">
        <text class="p-label">{{ g.label }}</text>
        <switch :checked="g.allow" @change="(e: UniSwitchChangeEvent) => togglePerm(g.value, e)" color="#E4537F" />
      </view>
      <text class="hint">同房记录与情绪自评永远仅本人可见，产品级不可授权。</text>
    </view>

    <!-- 自绘确认弹窗（web 端 uni.showModal 回调不触发） -->
    <view class="mask lb-fade" v-if="confirmVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">{{ confirmTitle }}</text>
        <text class="dlg-content">{{ confirmContent }}</text>
        <view class="dlg-actions">
          <text class="dlg-btn" @click="confirmVisible = false">取消</text>
          <text class="dlg-btn dlg-btn-ok" @click="onConfirmRemove">确定</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyFamily } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type GOpt = { value: string, label: string, allow: boolean }

  const members = ref<UTSJSONObject[]>([])
  const confirmVisible = ref<boolean>(false)
  const confirmTitle = ref<string>('')
  const confirmContent = ref<string>('')
  const confirmTarget = ref<string>('')
  const isOwner = ref<boolean>(false)
  const inviteCode = ref<string>('')
  const joinCode = ref<string>('')
  const joinCodeMode = ref<boolean>(false)
  const groups = ref<GOpt[]>([
    { value: 'prenatal', label: '产检与就诊', allow: true },
    { value: 'reports', label: '检查报告', allow: true },
    { value: 'emotions', label: '情绪与状态', allow: true },
    { value: 'diary', label: '日记', allow: true }
  ] as GOpt[])

  function roleText(r: string): string {
    if (r == 'admin') return '管理员'
    if (r == 'recorder') return '记录者'
    return '围观者'
  }
  async function load() {
    try {
      const res = await luckyFamily('getFamily', { journeyId: journeyState.journeyId } as UTSJSONObject)
      members.value = res.getArray<UTSJSONObject>('members') ?? []
      const fam = res.getJSON('family')
      isOwner.value = members.value.some(m => m.getBoolean('isMe') == true && m.getString('role') == 'admin')
      if (fam != null) {
        const matrix = (fam as UTSJSONObject).getJSON('matrix')
        const rec = (matrix as UTSJSONObject | null)?.getJSON('recorder')
        for (let i = 0; i < groups.value.length; i++) {
          const allow = (rec as UTSJSONObject | null)?.getBoolean(groups.value[i].value)
          if (allow != null) groups.value[i].allow = allow
        }
      }
    } catch (e) { /* 忽略 */ }
  }
  async function invite(role: string) {
    try {
      const res = await luckyFamily('invite', { journeyId: journeyState.journeyId, role } as UTSJSONObject)
      inviteCode.value = res.getString('code') ?? ''
    } catch (e) { uni.showToast({ title: (e as Error).message, icon: 'none' }) }
  }
  async function join() {
    try {
      await luckyFamily('join', { code: joinCode.value, nickname: '我' } as UTSJSONObject)
      uni.showToast({ title: '加入成功 🎉', icon: 'success' })
      load()
    } catch (e) { uni.showToast({ title: (e as Error).message, icon: 'none' }) }
  }
  async function togglePerm(group: string, e: UniSwitchChangeEvent) {
    try {
      await luckyFamily('setPermission', { journeyId: journeyState.journeyId, group, role: 'recorder', allow: e.detail.value } as UTSJSONObject)
    } catch (err) {
      uni.showToast({ title: (err as Error).message, icon: 'none' })
      load()
    }
  }
  async function remove(m: UTSJSONObject) {
    confirmTitle.value = '移除成员'
    confirmContent.value = `确定移除「${m.getString('nickname') ?? ''}」吗？`
    confirmTarget.value = m.getString('user_id') ?? ''
    confirmVisible.value = true
  }

  async function onConfirmRemove() {
    confirmVisible.value = false
    try {
      await luckyFamily('removeMember', { journeyId: journeyState.journeyId, memberUserId: confirmTarget.value } as UTSJSONObject)
      uni.showToast({ title: '已移除', icon: 'success' })
      load()
    } catch (err) {
      uni.showToast({ title: (err as Error).message, icon: 'none' })
    }
  }

  onPageReady(() => { load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 32rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 20rpx; }
  .m-row { flex-direction: row; align-items: center; padding: 16rpx 0; }
  .m-avatar { width: 72rpx; height: 72rpx; border-radius: 36rpx; background-color: var(--lb-secondary); align-items: center; justify-content: center; }
  .m-avatar-text { font-size: 30rpx; color: #FFFFFF; }
  .m-body { flex: 1; margin-left: 20rpx; }
  .m-name { font-size: 28rpx; color: var(--lb-text-1); }
  .m-role { font-size: 22rpx; color: var(--lb-text-3); margin-top: 4rpx; }
  .m-action-wrap { transition: all 160ms ease-out; }
  .m-action { font-size: 24rpx; color: var(--lb-danger); padding: 8rpx; }
  .hint { font-size: 22rpx; color: var(--lb-text-3); margin: 8rpx 0 16rpx 0; }
  .btn-row { flex-direction: row; }
  .btn-half { flex: 1; height: 88rpx; line-height: 88rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 24rpx; border-radius: 24rpx; margin: 0 8rpx; transition: all 160ms ease-out; }
  .btn-gray { background-color: var(--lb-fill); color: var(--lb-text-2); }
  .code-box { background-color: var(--lb-secondary-soft); border-radius: 24rpx; padding: 20rpx; margin-top: 20rpx; align-items: center; }
  .code-text { font-size: 30rpx; font-weight: bold; color: var(--lb-secondary-deep); }
  .input { width: 636rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); margin-bottom: 16rpx; }
  .ph { color: var(--lb-text-3); }
  .btn-save { width: 636rpx; height: 88rpx; line-height: 88rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 28rpx; border-radius: 24rpx; transition: all 160ms ease-out; }
  .p-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 14rpx 0; }
  .p-label { font-size: 26rpx; color: var(--lb-text-1); }
  .link-wrap { margin-top: 12rpx; padding: 8rpx 0; transition: all 160ms ease-out; }
  .link { font-size: 24rpx; color: var(--lb-primary); }

  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--lb-mask); justify-content: center; align-items: center; }
  .dialog { width: 560rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx 32rpx 24rpx 32rpx; }
  .dlg-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); text-align: center; }
  .dlg-content { font-size: 27rpx; color: var(--lb-text-2); margin-top: 20rpx; text-align: center; line-height: 40rpx; }
  .dlg-actions { flex-direction: row; justify-content: space-between; margin-top: 36rpx; }
  .dlg-btn { width: 230rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 29rpx; color: var(--lb-text-2); background-color: var(--lb-fill); border-radius: 40rpx; }
  .dlg-btn-ok { color: #FFFFFF; background-image: linear-gradient(135deg, #F0709D, #DC3D75); }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
