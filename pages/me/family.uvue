<template>
  <view class="page">
    <view class="card">
      <text class="card-title">家庭成员（{{ members.length }}）</text>
      <view class="m-row" v-for="(m, i) in members" :key="i">
        <view class="m-avatar"><text class="m-avatar-text">{{ (m.getString('nickname') ?? '?').slice(0, 1) }}</text></view>
        <view class="m-body">
          <text class="m-name">{{ m.getString('nickname') ?? '' }}{{ m.getBoolean('isMe') == true ? '（我）' : '' }}</text>
          <text class="m-role">{{ roleText(m.getString('role') ?? '') }}</text>
        </view>
        <text class="m-action" v-if="isOwner && !(m.getBoolean('isMe') == true)" @click="remove(m)">移除</text>
      </view>
    </view>

    <view class="card" v-if="isOwner">
      <text class="card-title">邀请家人</text>
      <text class="hint">爸爸成为"记录者"后可共同记录喂养、夜奶与产检；长辈默认只读。</text>
      <view class="btn-row">
        <button class="btn-half" @click="invite('recorder')">邀请爸爸（可记录）</button>
        <button class="btn-half btn-gray" @click="invite('viewer')">邀请长辈（只读）</button>
      </view>
      <view class="code-box" v-if="inviteCode.length > 0">
        <text class="code-text">邀请码：{{ inviteCode }}（3 天内有效）</text>
      </view>
    </view>

    <view class="card" v-if="!isOwner && joinCodeMode">
      <text class="card-title">加入家庭</text>
      <input class="input" v-model="joinCode" placeholder="输入邀请码" placeholder-class="ph" />
      <button class="btn-save" @click="join">加入</button>
    </view>
    <view class="card" v-if="!isOwner && !joinCodeMode">
      <text class="hint">你是受邀加入的成员，感谢一起记录宝宝的成长 🌟</text>
      <text class="link" @click="joinCodeMode = true">我要用邀请码加入其他家庭</text>
    </view>

    <view class="card" v-if="isOwner">
      <text class="card-title">数据组授权（记录者）</text>
      <view class="p-row" v-for="(g, i) in groups" :key="i">
        <text class="p-label">{{ g.label }}</text>
        <switch :checked="g.allow" @change="(e: UniSwitchChangeEvent) => togglePerm(g.value, e)" color="#FF7A6B" />
      </view>
      <text class="hint">同房记录与情绪自评永远仅本人可见，产品级不可授权。</text>
    </view>
  </view>
</template>

<script>
  import { luckyFamily } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'

  type GOpt = { value: string, label: string, allow: boolean }

  export default {
    data() {
      return {
        members: [] as UTSJSONObject[], isOwner: false,
        inviteCode: '', joinCode: '', joinCodeMode: false,
        groups: [
          { value: 'prenatal', label: '产检与就诊', allow: true },
          { value: 'reports', label: '检查报告', allow: true },
          { value: 'emotions', label: '情绪与状态', allow: true },
          { value: 'diary', label: '日记', allow: true }
        ] as GOpt[]
      }
    },
    onLoad() { this.load() },
    methods: {
      roleText(r: string): string {
        if (r == 'admin') return '管理员'
        if (r == 'recorder') return '记录者'
        return '围观者'
      },
      async load() {
        try {
          const res = await luckyFamily('getFamily', { journeyId: journeyState.journeyId } as UTSJSONObject)
          this.members = res.getArray('members') ?? []
          const fam = res.getJSON('family')
          this.isOwner = this.members.some(m => (m as UTSJSONObject).getBoolean('isMe') == true && (m as UTSJSONObject).getString('role') == 'admin')
          if (fam != null) {
            const matrix = (fam as UTSJSONObject).getJSON('matrix')
            const rec = (matrix as UTSJSONObject | null)?.getJSON('recorder')
            for (let i = 0; i < this.groups.length; i++) {
              const allow = (rec as UTSJSONObject | null)?.getBoolean(this.groups[i].value)
              if (allow != null) this.groups[i].allow = allow
            }
          }
        } catch (e) { /* 忽略 */ }
      },
      async invite(role: string) {
        try {
          const res = await luckyFamily('invite', { journeyId: journeyState.journeyId, role } as UTSJSONObject)
          this.inviteCode = res.getString('code') ?? ''
        } catch (e) { uni.showToast({ title: (e as Error).message, icon: 'none' }) }
      },
      async join() {
        try {
          await luckyFamily('join', { code: this.joinCode, nickname: '我' } as UTSJSONObject)
          uni.showToast({ title: '加入成功 🎉', icon: 'success' })
          this.load()
        } catch (e) { uni.showToast({ title: (e as Error).message, icon: 'none' }) }
      },
      async togglePerm(group: string, e: UniSwitchChangeEvent) {
        try {
          await luckyFamily('setPermission', { journeyId: journeyState.journeyId, group, role: 'recorder', allow: e.detail.value } as UTSJSONObject)
        } catch (err) {
          uni.showToast({ title: (err as Error).message, icon: 'none' })
          this.load()
        }
      },
      async remove(m: UTSJSONObject) {
        uni.showModal({
          title: '移除成员', content: `确定移除「${m.getString('nickname') ?? ''}」吗？`,
          success: async (r) => {
            if (r.confirm) {
              // 成员移除按 user_id；此处简化以成员 _id 为 key 的后端约定（memberUserId 传 user_id，占位实现）
              uni.showToast({ title: '请在服务端按用户 ID 移除', icon: 'none' })
            }
          }
        })
      }
    }
  }
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 32rpx; margin-top: 24rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: #1F2329; margin-bottom: 20rpx; }
  .m-row { flex-direction: row; align-items: center; padding: 16rpx 0; }
  .m-avatar { width: 72rpx; height: 72rpx; border-radius: 36rpx; background-color: #6BA3FF; align-items: center; justify-content: center; }
  .m-avatar-text { font-size: 30rpx; color: #FFFFFF; }
  .m-body { flex: 1; margin-left: 20rpx; }
  .m-name { font-size: 28rpx; color: #1F2329; }
  .m-role { font-size: 22rpx; color: #A3AAB5; margin-top: 4rpx; }
  .m-action { font-size: 24rpx; color: #E5484D; padding: 8rpx; }
  .hint { font-size: 22rpx; color: #A3AAB5; margin: 8rpx 0 16rpx 0; }
  .btn-row { flex-direction: row; }
  .btn-half { flex: 1; height: 88rpx; line-height: 88rpx; background-color: #FF7A6B; color: #FFFFFF; font-size: 24rpx; border-radius: 20rpx; margin: 0 8rpx; }
  .btn-gray { background-color: #F7F6F4; color: #6B7280; }
  .code-box { background-color: #EAF2FF; border-radius: 16rpx; padding: 20rpx; margin-top: 20rpx; align-items: center; }
  .code-text { font-size: 30rpx; font-weight: bold; color: #3B72D8; }
  .input { width: 636rpx; height: 88rpx; background-color: #F7F6F4; border-radius: 16rpx; padding: 0 24rpx; font-size: 28rpx; color: #1F2329; margin-bottom: 16rpx; }
  .ph { color: #A3AAB5; }
  .btn-save { width: 636rpx; height: 88rpx; line-height: 88rpx; background-color: #FF7A6B; color: #FFFFFF; font-size: 28rpx; border-radius: 20rpx; }
  .p-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 14rpx 0; }
  .p-label { font-size: 26rpx; color: #1F2329; }
  .link { font-size: 24rpx; color: #FF7A6B; margin-top: 12rpx; }
</style>
