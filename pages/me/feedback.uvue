<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise" v-if="!done">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">意见反馈</text></view>
      <text class="hint">遇到问题、想要的功能、对内容的建议，都可以写在这里。不要填写健康隐私信息。</text>
      <textarea class="ta" v-model="content" placeholder="请描述你遇到的问题或建议（5-2000 字）" placeholder-class="ph" :maxlength="2000" />
      <text class="label">联系方式（选填）</text>
      <input class="input" v-model="contact" placeholder="邮箱 / 手机号，方便我们回复" placeholder-class="ph" confirm-type="done" @confirm="submit" />
      <button class="btn-save" hover-class="lb-press" hover-stay-time="120" :disabled="saving" @click="submit">{{ saving ? '提交中…' : '提交反馈' }}</button>
      <text class="meta">{{ appVersion }} · {{ platform }}</text>
    </view>

    <view class="card lb-rise" v-else>
      <image class="done-art" src="/static/empty-scene.png" mode="aspectFit" />
      <text class="done-title">已收到，谢谢你的反馈</text>
      <text class="hint">我们会在后续版本里逐条评估；紧急问题可同时通过邮件联系开发者。</text>
      <view class="done-btn" hover-class="lb-press" hover-stay-time="120" @click="back">
        <text class="done-btn-text">返回</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { luckyId } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'
  import { APP_VERSION } from '../../utils/legal.uts'

  const content = ref<string>('')
  const contact = ref<string>('')
  const saving = ref<boolean>(false)
  const done = ref<boolean>(false)
  const appVersion = APP_VERSION
  let platform = 'app'
  // #ifdef APP-ANDROID
  platform = 'android'
  // #endif
  // #ifdef APP-IOS
  platform = 'ios'
  // #endif
  // #ifdef WEB
  platform = 'web'
  // #endif

  async function submit() {
    if (saving.value) return
    const text = content.value.trim()
    if (text.length < 5) { uni.showToast({ title: '请至少写 5 个字', icon: 'none' }); return }
    saving.value = true
    try {
      await luckyId('submitFeedback', {
        content: text, contact: contact.value.trim(),
        appVersion: appVersion, platform, journeyId: journeyState.journeyId
      } as UTSJSONObject)
      done.value = true
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally {
      saving.value = false
    }
  }

  function back() { uni.navigateBack({ delta: 1 }) }
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 36rpx; margin-top: 24rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-head { flex-direction: row; align-items: center; margin-bottom: 20rpx; align-self: flex-start; }
  .title-bar { width: 8rpx; height: 30rpx; border-radius: 4rpx; background-image: linear-gradient(180deg, var(--lb-grad-1), var(--lb-grad-2)); margin-right: 14rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); }
  .card-title-flush { margin-bottom: 0; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); line-height: 38rpx; align-self: flex-start; }
  .ta { width: 630rpx; height: 280rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 24rpx; font-size: 28rpx; color: var(--lb-text-1); margin-top: 20rpx; }
  .ph { color: var(--lb-text-3); }
  .label { font-size: 26rpx; color: var(--lb-text-1); margin: 24rpx 0 12rpx 0; align-self: flex-start; }
  .input { width: 630rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); }
  .btn-save { width: 630rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-action); color: var(--lb-white); font-size: 32rpx; border-radius: 48rpx; margin-top: 28rpx; transition: all 160ms ease-out; }
  .meta { font-size: 24rpx; color: var(--lb-text-3); margin-top: 16rpx; }
  .done-art { width: 240rpx; height: 240rpx; }
  .done-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); margin-top: 16rpx; }
  .done-btn { min-width: 240rpx; min-height: 76rpx; padding: 0 40rpx; border-radius: 38rpx; background-color: var(--lb-primary-soft); align-items: center; justify-content: center; margin-top: 28rpx; }
  .done-btn-text { font-size: 28rpx; color: var(--lb-primary-text); font-weight: bold; }
  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
