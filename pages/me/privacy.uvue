<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="card-title">应用锁</text>
      <view class="p-row">
        <text class="p-label">打开应用需验证（面容/指纹/密码）</text>
        <switch :checked="appLock" @change="onAppLock" color="#E4537F" />
      </view>
      <text class="hint" v-if="bioAvailable">启动时需面容/指纹验证</text>
      <text class="hint" v-else>当前设备暂未接入生物识别，启动时需输入登录密码解锁</text>
      <text class="hint">建议开启：你的记录里有最私密的旅程。</text>
    </view>
    <view class="card lb-rise-1">
      <text class="card-title">谁看过我的数据</text>
      <text class="hint" v-if="auditLogs.length == 0">暂无家庭成员访问记录；本人操作不记录</text>
      <view class="a-row" v-for="(a, i) in auditLogs" :key="i">
        <text class="a-name">{{ a.getString('nickname') ?? '家人' }}</text>
        <text class="a-time">{{ a.getString('date') ?? '' }} · 查看首页</text>
      </view>
      <text class="hint">留痕仅记录家庭成员的数据页访问，用于知情与追溯（docs/03 M7.2）</text>
    </view>

    <view class="card lb-rise-1">
      <text class="card-title">敏感记录组（默认仅本人）</text>
      <text class="hint">以下内容永远只有你自己可见，产品级不可授权、不可恢复为共享：</text>
      <view class="s-row"><image class="s-ico" src="/static/icons/heart.png" mode="aspectFit" /><text class="s-item">同房记录</text></view>
      <view class="s-row"><image class="s-ico" src="/static/icons/heart.png" mode="aspectFit" /><text class="s-item">验孕记录</text></view>
      <view class="s-row"><image class="s-ico" src="/static/icons/heart.png" mode="aspectFit" /><text class="s-item">产后情绪自评（EPDS）</text></view>
      <view class="p-row">
        <text class="p-label">通知内容脱敏（提醒只显示数量）</text>
        <switch :checked="quietPush" @change="onQuietPush" color="#E4537F" />
      </view>
      <text class="hint">该开关为推送能力接入后生效（当前无系统级推送，见 docs/08）</text>
    </view>
    <view class="card lb-rise-2">
      <text class="card-title">你的数据权利</text>
      <text class="hint">· 数据导出：结构化 JSON + 可读摘要（媒体打包待 V1.1）\n· 云备份：本期未开通；如后续提供将另行征得同意\n· 注销账号：30 天冷静期后由定时任务彻底删除（含云端）</text>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/data/data')"><text class="nav-text">去导出我的数据</text><text class="nav-arrow">›</text></view>
    </view>
    <view class="card lb-rise-3">
      <text class="card-title">账号</text>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="askDelete"><text class="nav-text-danger">注销账号</text><text class="nav-arrow">›</text></view>
      <text class="hint">注销后 30 天内可撤回；期满将彻底删除全部数据</text>
    </view>

    <!-- 自绘确认弹窗（web 端 uni.showModal 回调不触发，见 docs/08 §8） -->
    <view class="mask lb-fade" v-if="dlgVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">{{ dlgTitle }}</text>
        <text class="dlg-content">{{ dlgContent }}</text>
        <input class="dlg-input" type="text" :password="true" v-model="dlgPassword" placeholder="请输入登录密码确认" placeholder-class="ph" />
        <view class="dlg-actions">
          <text class="dlg-btn" @click="dlgVisible = false">取消</text>
          <text class="dlg-btn dlg-btn-ok" @click="onConfirmDelete">{{ deleting ? '提交中…' : '确认注销' }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyId, luckyData } from '../../utils/request.uts'
  import { clearToken } from '../../store/appStore.uts'
  import { isBiometricAvailable } from '../../utils/biometric.uts'
  import { themeClass } from '../../store/themeStore.uts'
  import { journeyState } from '../../store/journeyStore.uts'

  const bioAvailable = isBiometricAvailable()
  const auditLogs = ref<UTSJSONObject[]>([])

  async function loadAudit() {
    try {
      const res = await luckyData('listAuditLogs', { journeyId: journeyState.journeyId } as UTSJSONObject)
      auditLogs.value = res.getArray<UTSJSONObject>('logs') ?? []
    } catch (e) { /* 非主人或未登录时静默 */ }
  }
  onPageReady(() => { loadAudit() })

  // 安全读取：key 首次不存在时 getStorageSync 返回 null，不能强转 as boolean
  const rawLock = uni.getStorageSync('lb_app_lock')
  const appLock = ref<boolean>(rawLock != null && rawLock == true)
  const rawPush = uni.getStorageSync('lb_quiet_push')
  const quietPush = ref<boolean>(rawPush == null ? true : (rawPush == true || rawPush == 'true'))

  const dlgVisible = ref<boolean>(false)
  const dlgTitle = ref<string>('注销账号')
  const dlgContent = ref<string>('30 天冷静期内可随时撤回。期满后将彻底删除你在云端的全部记录，且无法恢复。')
  const dlgPassword = ref<string>('')
  const deleting = ref<boolean>(false)

  function go(url: string) { uni.navigateTo({ url }) }
  function onAppLock(e: UniSwitchChangeEvent) {
    appLock.value = e.detail.value
    uni.setStorageSync('lb_app_lock', e.detail.value)
  }
  function onQuietPush(e: UniSwitchChangeEvent) {
    quietPush.value = e.detail.value
    uni.setStorageSync('lb_quiet_push', e.detail.value)
  }
  function askDelete() {
    dlgPassword.value = ''
    deleting.value = false
    dlgVisible.value = true
  }
  async function onConfirmDelete() {
    if (deleting.value) return
    if (dlgPassword.value.length < 8) {
      uni.showToast({ title: '请输入正确的登录密码', icon: 'none' })
      return
    }
    deleting.value = true
    try {
      await luckyId('requestDeletion', { password: dlgPassword.value } as UTSJSONObject)
      dlgVisible.value = false
      // 注销成功后 token 已被服务端吊销，本地一并清理
      clearToken()
      uni.reLaunch({ url: '/pages/account/login' })
    } catch (e) {
      deleting.value = false
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    }
  }
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 32rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 16rpx; }
  .p-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 12rpx 0; }
  .p-label { font-size: 26rpx; color: var(--lb-text-1); flex: 1; }
  .s-row { flex-direction: row; align-items: center; }
  .s-ico { width: 28rpx; height: 28rpx; margin-right: 10rpx; }
  .s-item { font-size: 26rpx; color: var(--lb-text-2); padding: 6rpx 0; }
  .a-row { flex-direction: row; justify-content: space-between; padding: 10rpx 0; border-bottom-width: 1px; border-bottom-color: var(--lb-line); }
  .a-name { font-size: 26rpx; color: var(--lb-text-1); }
  .a-time { font-size: 24rpx; color: var(--lb-text-3); }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin: 8rpx 0 16rpx 0; }
  .nav-row { flex-direction: row; align-items: center; padding: 20rpx 0; transition: all 160ms ease-out; }
  .nav-text { flex: 1; font-size: 26rpx; color: var(--lb-primary); }
  .nav-text-danger { flex: 1; font-size: 26rpx; color: var(--lb-danger); }
  .nav-arrow { font-size: 32rpx; color: var(--lb-arrow); }
  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--lb-mask); justify-content: center; align-items: center; }
  .dialog { width: 560rpx; background-color: var(--lb-card); border-radius: 24rpx; padding: 40rpx 32rpx 24rpx 32rpx; }
  .dlg-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); text-align: center; }
  .dlg-content { font-size: 27rpx; color: var(--lb-text-2); margin-top: 20rpx; text-align: center; line-height: 40rpx; }
  .dlg-input { width: 100%; height: 88rpx; background-color: var(--lb-fill); border-radius: 16rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); margin-top: 24rpx; }
  .ph { color: var(--lb-text-3); }
  .dlg-actions { flex-direction: row; justify-content: space-between; margin-top: 36rpx; }
  .dlg-btn { width: 230rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 29rpx; color: var(--lb-text-2); background-color: var(--lb-fill); border-radius: 40rpx; }
  .dlg-btn-ok { color: #FFFFFF; background-color: var(--lb-danger); }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
