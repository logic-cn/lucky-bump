<template>
  <view class="page">
    <view class="card">
      <text class="card-title">应用锁</text>
      <view class="p-row">
        <text class="p-label">打开应用需验证（面容/指纹/密码）</text>
        <switch :checked="appLock" @change="onAppLock" color="#FF7A6B" />
      </view>
      <text class="hint">建议开启：你的记录里有最私密的旅程。</text>
    </view>
    <view class="card">
      <text class="card-title">敏感记录组（默认仅本人）</text>
      <text class="hint">以下内容永远只有你自己可见，产品级不可授权、不可恢复为共享：</text>
      <text class="s-item">💗 同房记录</text>
      <text class="s-item">💗 验孕记录</text>
      <text class="s-item">💗 产后情绪自评（EPDS）</text>
      <view class="p-row">
        <text class="p-label">锁屏通知只显示"你有 1 条新提醒"</text>
        <switch :checked="quietPush" @change="onQuietPush" color="#FF7A6B" />
      </view>
    </view>
    <view class="card">
      <text class="card-title">你的数据权利</text>
      <text class="hint">· 云备份默认关闭，开启时端侧加密\n· 完整导出：随时带走全部数据\n· 注销账号：30 天冷静期后彻底删除（含云端）</text>
      <view class="nav-row" @click="go('/pages/data/data')"><text class="nav-text">去导出我的数据</text><text class="nav-arrow">›</text></view>
    </view>
  </view>
</template>

<script>
  export default {
    data() {
      return {
        appLock: (uni.getStorageSync('lb_app_lock') as boolean ?? false),
        quietPush: (uni.getStorageSync('lb_quiet_push') as boolean ?? true)
      }
    },
    methods: {
      go(url: string) { uni.navigateTo({ url }) },
      onAppLock(e: UniSwitchChangeEvent) {
        this.appLock = e.detail.value
        uni.setStorageSync('lb_app_lock', e.detail.value)
      },
      onQuietPush(e: UniSwitchChangeEvent) {
        this.quietPush = e.detail.value
        uni.setStorageSync('lb_quiet_push', e.detail.value)
      }
    }
  }
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 32rpx; margin-top: 24rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: #1F2329; margin-bottom: 16rpx; }
  .p-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 12rpx 0; }
  .p-label { font-size: 26rpx; color: #1F2329; flex: 1; }
  .s-item { font-size: 26rpx; color: #6B7280; padding: 6rpx 0; }
  .hint { font-size: 22rpx; color: #A3AAB5; margin: 8rpx 0 16rpx 0; }
  .nav-row { flex-direction: row; align-items: center; padding: 20rpx 0; }
  .nav-text { flex: 1; font-size: 26rpx; color: #FF7A6B; }
  .nav-arrow { font-size: 32rpx; color: #C9CDD4; }
</style>
