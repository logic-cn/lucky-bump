<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">提醒</text></view>
      <view class="r-row" v-for="(r, i) in rules" :key="i">
        <view class="r-body">
          <text class="r-title">{{ r.getString('title') ?? '' }}</text>
          <text class="r-sub">{{ ruleTypeText(r.getString('type') ?? '') }}</text>
        </view>
        <switch :checked="r.getBoolean('enabled') ?? true" @change="(e: UniSwitchChangeEvent) => toggleRule(r, e)" color="#E4537F" />
        <text class="r-del" @click="askRemoveRule(r)">删除</text>
      </view>
      <text class="hint" v-if="rules.length == 0">产检、疫苗等提醒会在相应功能启用时自动创建</text>
    </view>

    <view class="card lb-rise-1">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">新建提醒</text></view>
      <input class="input" v-model="title" placeholder="提醒名称，如：叶酸打卡" placeholder-class="ph" />
      <view class="opts">
        <view class="opt" hover-class="lb-press" hover-stay-time="120" v-for="(t, i) in medTemplates" :key="i" @click="applyMedTemplate(t)">
          <image class="med-ico" src="/static/icons/pill.png" mode="aspectFit" /><text class="opt-text">{{ t }}</text>
        </view>
      </view>
      <text class="hint" v-if="medTemplates.length > 0">点常用模板一键创建每日提醒（含喝水）</text>
      <view class="opts">
        <view class="opt" hover-class="lb-press" hover-stay-time="120" v-for="(t, i) in types" :key="i" :class="type == t.value ? 'opt-active' : ''" @click="type = t.value">
          <text class="opt-text" :class="type == t.value ? 'opt-text-active' : ''">{{ t.label }}</text>
        </view>
      </view>
      <!-- #ifdef APP-ANDROID || APP-IOS -->
      <lbc-date-field v-if="type == 'absolute'" :value="anchorDate" @change="onAnchorChange" />
      <!-- #endif -->
      <!-- #ifdef WEB -->
      <view v-if="type == 'absolute'" hover-class="lb-press" hover-stay-time="120" @click="onPickAnchorWeb">
        <view class="pick-box"><text class="pick-text">{{ anchorDate == '' ? '选择日期' : anchorDate }}</text></view>
      </view>
      <!-- #endif -->
      <input v-if="type == 'by_week'" class="input" type="number" v-model="week" placeholder="孕周，如 28" placeholder-class="ph" />
      <input v-if="type == 'by_month'" class="input" type="number" v-model="month" placeholder="月龄，如 6" placeholder-class="ph" />
      <input v-if="type == 'recurring'" class="input" type="number" v-model="intervalDays" placeholder="间隔天数，如 1" placeholder-class="ph" />
      <button class="btn-save" hover-class="lb-press" hover-stay-time="120" :disabled="saving" @click="add">{{ saving ? '保存中…' : '添加提醒' }}</button>
      <text class="hint">免打扰期间不弹到期提醒（待办列表仍保留）；紧急提醒不受限制</text>
    </view>

    <view class="card lb-rise-1">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">免打扰时段</text></view>
      <view class="p-row">
        <text class="p-label">开始</text>
        <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-time-field :value="quietStartTime" @change="onQuietStartChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view hover-class="lb-press" hover-stay-time="120" @click="onPickQuietStartWeb">
          <text class="pick-text">{{ quietStartTime }}</text>
        </view>
    <!-- #endif -->
      </view>
      <view class="p-row">
        <text class="p-label">结束</text>
        <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-time-field :value="quietEndTime" @change="onQuietEndChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view hover-class="lb-press" hover-stay-time="120" @click="onPickQuietEndWeb">
          <text class="pick-text">{{ quietEndTime }}</text>
        </view>
    <!-- #endif -->
      </view>
      <text class="hint">默认 22:00-7:00；仅影响前台提醒弹层，不隐藏待办</text>
    </view>

    <view class="card lb-rise-2">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">通用</text></view>
      <view class="p-row"><text class="p-label">暗色模式</text><switch :checked="darkMode" @change="onDark" color="#E4537F" /></view>
      <!-- #ifdef WEB -->
      <view class="p-row"><text class="p-label">浏览器通知</text><switch :checked="webNotify" @change="onWebNotify" color="#E4537F" /></view>
      <!-- #endif -->
      <!-- #ifndef WEB -->
      <text class="hint">App 端提醒将通过系统通知推送（锁屏可达）；请在系统设置中允许"幸孕记"的通知权限，响铃遵循系统勿扰</text>
      <!-- #endif -->
      <view class="p-row"><text class="p-label">体重单位</text><text class="p-value">kg</text></view>
      <view class="p-row"><text class="p-label">当前版本</text><text class="p-value">1.0.0</text></view>
    </view>

    <view class="card lb-rise-3">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">身体档案</text></view>
      <view class="p-row">
        <text class="p-label">身高（cm）</text>
        <input class="mini-input" type="number" v-model="heightCm" placeholder="如 165" placeholder-class="ph" />
      </view>
      <view class="p-row">
        <text class="p-label">孕前体重（kg）</text>
        <input class="mini-input" type="number" v-model="preWeightKg" placeholder="如 52" placeholder-class="ph" />
      </view>
      <button class="btn-save" hover-class="lb-press" hover-stay-time="120" :disabled="profileSaving" @click="saveProfile">{{ profileSaving ? '保存中…' : '保存身体档案' }}</button>
      <text class="hint">用于孕期增重推荐区间与 BMI 判断（docs/03 M2.2），仅本人可见</text>
    </view>

    <view class="card lb-rise-2" v-if="opsAdmin">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">内部</text></view>
      <view class="p-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/me/ops')">
        <text class="p-label">运营看板</text>
        <text class="p-value">打开 ›</text>
      </view>
    </view>

    <view class="card lb-rise-2" v-if="canStartNewJourney">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">旅程</text></view>
      <text class="hint">已经进入新阶段？可以开启一段新的旅程（再备孕）。旧旅程数据完整保留，时间线随时回看。</text>
      <button class="btn-journey" hover-class="lb-press" hover-stay-time="120" @click="confirmNewJourney = true">开始新的旅程</button>
    </view>

    <lbc-dialog :visible="confirmNewJourney" title="开始新的旅程？" content="当前旅程会完整保留；新旅程从备孕阶段开始，可以重新记录周期与试纸。" confirmText="开始" @confirm="doStartNewJourney" @cancel="confirmNewJourney = false" />

    <view class="card lb-rise-3">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">账号安全</text></view>
      <view class="p-row" hover-class="lb-press" hover-stay-time="120" @click="openRecovery">
        <text class="p-label">找回凭证</text>
        <text class="p-value">{{ recoverySaving ? '生成中…' : '生成 ›' }}</text>
      </view>
      <view class="p-row" hover-class="lb-press" hover-stay-time="120" @click="openPwd">
        <text class="p-label">修改密码</text>
        <text class="p-value">›</text>
      </view>
      <text class="hint">忘记密码时用恢复凭证重置，无需短信；凭证只显示一次，请自行保存</text>
    </view>

    <!-- 删除提醒确认 -->
    <view class="mask lb-fade" v-if="ruleDelVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">删除提醒？</text>
        <text class="dlg-content">「{{ ruleDelTitle }}」删除后不再提醒，历史完成记录保留。</text>
        <view class="dlg-actions">
          <text class="dlg-btn" @click="ruleDelVisible = false">取消</text>
          <text class="dlg-btn dlg-btn-ok" @click="doRemoveRule">删除</text>
        </view>
      </view>
    </view>

    <!-- 恢复凭证弹窗 -->
    <view class="mask lb-fade" v-if="recoveryVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">你的恢复凭证</text>
        <text class="dlg-code">{{ recoveryCode }}</text>
        <text class="dlg-content">请立即复制或抄下保存。它只显示这一次，用于忘记密码时重置。</text>
        <view class="dlg-actions">
          <text class="dlg-btn" @click="copyRecovery">复制</text>
          <text class="dlg-btn dlg-btn-ok" @click="recoveryVisible = false">我已保存</text>
        </view>
      </view>
    </view>

    <!-- 修改密码弹窗（web 端 uni.showModal 回调不触发，统一自绘） -->
    <view class="mask lb-fade" v-if="pwdVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">修改密码</text>
        <input class="dlg-input" type="text" :password="true" v-model="oldPwd" placeholder="原密码" placeholder-class="ph" />
        <input class="dlg-input" type="text" :password="true" v-model="newPwd" placeholder="新密码（8-32 位）" placeholder-class="ph" />
        <view class="dlg-actions">
          <text class="dlg-btn" @click="pwdVisible = false">取消</text>
          <text class="dlg-btn dlg-btn-ok" @click="onChangePwd">{{ pwdSaving ? '提交中…' : '确认修改' }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyReminder, luckyId, luckyJourney } from '../../utils/request.uts'
  import { journeyState, loadCurrentJourney } from '../../store/journeyStore.uts'
  import { themeState, setThemeMode, themeClass } from '../../store/themeStore.uts'
  import { quietStart, quietEnd, setQuietRange } from '../../utils/quiet.uts'
  import { notifyEnabled, notifyPermission, setNotifyEnabled } from '../../utils/webNotify.uts'
  import { todayDateStr } from '../../utils/recordDate.uts'
  // #ifdef WEB
  import { pickDate, pickTime } from '../../utils/pickDate.uts'
  // #endif

  type TOpt = { value: string, label: string }

  const rules = ref<UTSJSONObject[]>([])
  const saving = ref<boolean>(false)
  const title = ref<string>('')
  const type = ref<string>('absolute')
  const anchorDate = ref<string>('')
  const week = ref<string>('')
  const month = ref<string>('')
  const intervalDays = ref<string>('')
  // 产褥期/孕期常用用药模板：一键生成每日重复提醒（用药提醒不改诊断边界，仅提醒）
  const medTemplates = ref<string[]>(['叶酸', '铁剂', '钙片', '维生素 D', 'DHA', '喝水'])
  const confirmNewJourney = ref<boolean>(false)
  const canStartNewJourney = computed((): boolean => {
    const s = journeyState.stage
    return s == 'POSTPARTUM' || s == 'RECOVERY' || s == 'PARENTING'
  })
  async function doStartNewJourney() {
    confirmNewJourney.value = false
    try {
      await luckyJourney('startNewJourney', { fromJourneyId: journeyState.journeyId, title: '新的旅程' } as UTSJSONObject)
      await loadCurrentJourney()
      uni.showToast({ title: '新旅程已开启', icon: 'none' })
      setTimeout(() => { uni.switchTab({ url: '/pages/index/index' }) }, 500)
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    }
  }
  function applyMedTemplate(name: string) {
    if (saving.value) return
    title.value = `${name}（每日）`
    type.value = 'recurring'
    intervalDays.value = '1'
    // 模板区文案承诺“一键创建”，点击即落库，避免用户以为已添加
    add()
  }
  const darkMode = ref<boolean>(themeState.resolved == 'dark')
  const webNotify = ref<boolean>(notifyEnabled())
  const quietStartTime = ref<string>(quietStart())
  const quietEndTime = ref<string>(quietEnd())
  const pwdVisible = ref<boolean>(false)
  const pwdSaving = ref<boolean>(false)
  const oldPwd = ref<string>('')
  const newPwd = ref<string>('')
  const recoveryVisible = ref<boolean>(false)
  const recoveryCode = ref<string>('')
  const recoverySaving = ref<boolean>(false)
  const ruleDelVisible = ref<boolean>(false)
  const ruleDelId = ref<string>('')
  const ruleDelTitle = ref<string>('')
  const heightCm = ref<string>('')
  const preWeightKg = ref<string>('')
  const profileSaving = ref<boolean>(false)
  const opsAdmin = ref<boolean>(false)

  function go(url: string) { uni.navigateTo({ url }) }

  async function loadProfile() {
    try {
      const p = await luckyId('getProfile', {} as UTSJSONObject)
      const info = p.getJSON('userInfo')
      if (info != null) {
        const h = info.getNumber('heightCm') ?? 0
        const w = info.getNumber('prePregnancyWeightKg') ?? 0
        heightCm.value = h > 0 ? `${h}` : ''
        preWeightKg.value = w > 0 ? `${w}` : ''
        opsAdmin.value = info.getBoolean('opsAdmin') ?? false
      }
    } catch (e) { /* 未登录或网络异常时保持空值 */ }
  }
  async function saveProfile() {
    const h = parseFloat(heightCm.value)
    const w = parseFloat(preWeightKg.value)
    if (!(h >= 120 && h <= 220)) { uni.showToast({ title: '请输入有效身高（120-220cm）', icon: 'none' }); return }
    if (!(w >= 30 && w <= 200)) { uni.showToast({ title: '请输入有效体重（30-200kg）', icon: 'none' }); return }
    profileSaving.value = true
    try {
      await luckyId('updateProfile', { heightCm: h, prePregnancyWeightKg: w } as UTSJSONObject)
      uni.showToast({ title: '已保存', icon: 'success' })
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { profileSaving.value = false }
  }
  function openPwd() {
    oldPwd.value = ''
    newPwd.value = ''
    pwdVisible.value = true
  }
  async function openRecovery() {
    if (recoverySaving.value) return
    recoverySaving.value = true
    try {
      const res = await luckyId('createRecoveryCode', {} as UTSJSONObject)
      recoveryCode.value = res.getString('code') ?? ''
      recoveryVisible.value = true
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { recoverySaving.value = false }
  }
  function copyRecovery() {
    uni.setClipboardData({
      data: recoveryCode.value,
      success: () => { uni.showToast({ title: '已复制，请妥善保存', icon: 'none' }) }
    })
  }
  async function onChangePwd() {
    if (pwdSaving.value) return
    if (oldPwd.value.length < 8 || newPwd.value.length < 8) {
      uni.showToast({ title: '密码长度需 8-32 位', icon: 'none' })
      return
    }
    pwdSaving.value = true
    try {
      await luckyId('changePassword', { oldPassword: oldPwd.value, newPassword: newPwd.value } as UTSJSONObject)
      pwdVisible.value = false
      uni.showToast({ title: '密码已更新', icon: 'success' })
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { pwdSaving.value = false }
  }
  function onQuietStartChange(v: string) {
    quietStartTime.value = v
    setQuietRange(quietStartTime.value, quietEndTime.value)
  }
  function onQuietEndChange(v: string) {
    quietEndTime.value = v
    setQuietRange(quietStartTime.value, quietEndTime.value)
  }
  const types = ref<TOpt[]>([
    { value: 'absolute', label: '指定日期' },
    { value: 'by_week', label: '按孕周' },
    { value: 'by_month', label: '按月龄' },
    { value: 'recurring', label: '周期重复' }
  ])

  function ruleTypeText(t: string): string {
    for (let i = 0; i < types.value.length; i++) { if (types.value[i].value == t) return types.value[i].label }
    return t
  }
  function onAnchorChange(v: string) { anchorDate.value = v }
  function onDark(e: UniSwitchChangeEvent) {
    darkMode.value = e.detail.value
    setThemeMode(e.detail.value ? 'dark' : 'light')
  }
  function onWebNotify(e: UniSwitchChangeEvent) {
    webNotify.value = e.detail.value
    setNotifyEnabled(e.detail.value)
    if (e.detail.value && notifyPermission() != 'granted') {
      uni.showToast({ title: '请在浏览器地址栏允许通知', icon: 'none' })
    }
  }
  async function load() {
    try {
      const res = await luckyReminder('listRules', { journeyId: journeyState.journeyId } as UTSJSONObject)
      rules.value = res.getArray<UTSJSONObject>('rules') ?? []
    } catch (e) { /* 忽略 */ }
  }
  async function toggleRule(r: UTSJSONObject, e: UniSwitchChangeEvent) {
    try {
      await luckyReminder('updateRule', { journeyId: journeyState.journeyId, ruleId: r.getString('_id') ?? '', enabled: e.detail.value } as UTSJSONObject)
    } catch (err) { uni.showToast({ title: (err as Error).message, icon: 'none' }) }
  }
  function askRemoveRule(r: UTSJSONObject) {
    ruleDelId.value = r.getString('_id') ?? ''
    ruleDelTitle.value = r.getString('title') ?? ''
    ruleDelVisible.value = true
  }
  async function doRemoveRule() {
    ruleDelVisible.value = false
    try {
      await luckyReminder('removeRule', { ruleId: ruleDelId.value } as UTSJSONObject)
      uni.showToast({ title: '已删除', icon: 'none' })
      load()
    } catch (err) {
      uni.showToast({ title: (err as Error).message, icon: 'none' })
    }
  }
  async function add() {
    if (title.value.trim().length == 0) { uni.showToast({ title: '请填写提醒名称', icon: 'none' }); return }
    if (journeyState.journeyId.length == 0) { uni.showToast({ title: '旅程加载中，请稍后再试', icon: 'none' }); return }
    const params = { journeyId: journeyState.journeyId, type: type.value, title: title.value } as UTSJSONObject
    if (type.value == 'absolute') {
      if (anchorDate.value.length == 0) { uni.showToast({ title: '请选择日期', icon: 'none' }); return }
      params['anchorDate'] = anchorDate.value
    } else if (type.value == 'by_week') params['week'] = parseInt(week.value) || 0
    else if (type.value == 'by_month') params['month'] = parseInt(month.value) || 0
    else params['intervalDays'] = parseInt(intervalDays.value) || 1
    saving.value = true
    try {
      await luckyReminder('addRule', params)
      title.value = ''
      uni.showToast({ title: '已添加 ✓', icon: 'success' })
      load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }

  // 首屏与 tab 切回统一走 onPageReady（uni-app x 5.34 页面钩子不触发，见 utils/pageLifecycle.uts）
  onPageReady(() => { load(); loadProfile() })

  // #ifdef WEB
  async function onPickAnchorWeb() {
    const v = await pickDate(anchorDate.value, '')
    if (v.length > 0) {
      onAnchorChange(v)
    }
  }
  // #endif

  // #ifdef WEB
  async function onPickQuietStartWeb() {
    const v = await pickTime(quietStartTime.value)
    if (v.length > 0) {
      onQuietStartChange(v)
    }
  }
  // #endif

  // #ifdef WEB
  async function onPickQuietEndWeb() {
    const v = await pickTime(quietEndTime.value)
    if (v.length > 0) {
      onQuietEndChange(v)
    }
  }
  // #endif
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 32rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 16rpx; }
  .btn-journey { width: 560rpx; height: 88rpx; line-height: 88rpx; margin-top: 20rpx; background-color: var(--lb-primary-soft); color: var(--lb-primary-deep); font-size: 28rpx; border-radius: 48rpx; transition: all 160ms ease-out; }
  .r-row { flex-direction: row; align-items: center; padding: 14rpx 0; border-bottom-width: 1px; border-bottom-color: var(--lb-line); }
  .r-body { flex: 1; }
  .r-title { font-size: 28rpx; color: var(--lb-text-1); }
  .r-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 4rpx; }
  .r-del { font-size: 24rpx; color: var(--lb-danger-text); padding: 10rpx; margin-left: 8rpx; }
  .input { width: 636rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); margin-bottom: 16rpx; }
  .ph { color: var(--lb-text-3); }
  .opts { flex-direction: row; flex-wrap: wrap; margin-bottom: 16rpx; }
  .opt { flex-direction: row; align-items: center; background-color: var(--lb-fill); border-radius: 24rpx; padding: 16rpx 24rpx; margin: 6rpx; transition: all 160ms ease-out; }
  .med-ico { width: 28rpx; height: 28rpx; margin-right: 8rpx; }
  .opt-active { background-color: var(--lb-primary-soft); }
  .opt-text { font-size: 24rpx; color: var(--lb-text-2); }
  .opt-text-active { color: var(--lb-primary-deep); font-weight: bold; }
  .pick-box { width: 636rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; align-items: center; justify-content: center; margin-bottom: 16rpx; transition: all 160ms ease-out; }
  .pick-text { font-size: 28rpx; color: var(--lb-text-1); }
  .btn-save { width: 636rpx; height: 88rpx; line-height: 88rpx; background-color: var(--lb-action); color: #FFFFFF; font-size: 28rpx; border-radius: 24rpx; margin-top: 8rpx; transition: all 160ms ease-out; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin-top: 16rpx; }
