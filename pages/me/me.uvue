<template>
  <view class="page">
    <view class="profile">
      <view class="avatar"><text class="avatar-text">{{ avatarText }}</text></view>
      <view class="profile-body">
        <text class="nickname">{{ nickname }}</text>
        <text class="stage">{{ stageText }}{{ journeyState.title.length > 0 ? ' · ' + journeyState.title : '' }}</text>
      </view>
    </view>

    <view class="card">
      <view class="row" @click="go('/pages/baby/baby-home')"><text class="row-text">👶 宝宝档案</text><text class="arrow">›</text></view>
      <view class="row" @click="go('/pages/me/family')"><text class="row-text">👪 家庭组（邀请爸爸）</text><text class="arrow">›</text></view>
      <view class="row" @click="go('/pages/me/privacy')"><text class="row-text">🔒 隐私与安全</text><text class="arrow">›</text></view>
      <view class="row" @click="go('/pages/me/settings')"><text class="row-text">⚙️ 提醒与设置</text><text class="arrow">›</text></view>
      <view class="row" @click="go('/pages/me/about')"><text class="row-text">ℹ️ 关于与免责声明</text><text class="arrow">›</text></view>
    </view>

    <button class="btn-logout" @click="logout">退出登录</button>

    <!-- 自绘确认弹窗（web 端 uni.showModal 回调不触发，见 docs/08 已知限制） -->
    <view class="mask" v-if="confirmVisible">
      <view class="dialog">
        <text class="dlg-title">{{ confirmTitle }}</text>
        <text class="dlg-content">{{ confirmContent }}</text>
        <view class="dlg-actions">
          <text class="dlg-btn" v-if="confirmShowCancel" @click="confirmVisible = false">取消</text>
          <text class="dlg-btn dlg-btn-ok" @click="onConfirm">确定</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onLoad } from '@dcloudio/uni-app'
  import { appState, clearToken } from '../../store/appStore.uts'
  import { journeyState, stageText as journeyStageText } from '../../store/journeyStore.uts'
  import { luckyId } from '../../utils/request.uts'

  const nickname = computed((): string => appState.nickname.length > 0 ? appState.nickname : '未设置昵称')
  const avatarText = computed((): string => appState.nickname.length > 0 ? appState.nickname.slice(0, 1) : '?')
  const stageText = computed((): string => journeyStageText(journeyState.stage))

  function go(url: string) { uni.navigateTo({ url }) }

  async function loadProfile() {
    try {
      const res = await luckyId('getProfile', {} as UTSJSONObject)
      const u = res.getJSON('userInfo')
      if (u != null) {
        appState.nickname = (u as UTSJSONObject).getString('nickname') ?? ''
      }
    } catch (e) { /* 已登录态校验由请求层兜底 */ }
  }

  const confirmVisible = ref<boolean>(false)
  const confirmTitle = ref<string>('')
  const confirmContent = ref<string>('')
  const confirmShowCancel = ref<boolean>(true)

  function logout() {
    confirmTitle.value = '退出登录'
    confirmContent.value = '你的记录会安全保存在云端，随时可以回来。'
    confirmShowCancel.value = true
    confirmVisible.value = true
  }

  async function onConfirm() {
    confirmVisible.value = false
    try { await luckyId('logout', {} as UTSJSONObject) } catch (e) { /* 忽略 */ }
    clearToken()
    uni.reLaunch({ url: '/pages/account/login' })
  }

  onLoad(() => { loadProfile() })
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .profile { width: 700rpx; flex-direction: row; align-items: center; padding: 32rpx 16rpx; }
  .avatar { width: 112rpx; height: 112rpx; border-radius: 56rpx; background-color: #FF7A6B; align-items: center; justify-content: center; }
  .avatar-text { font-size: 44rpx; color: #FFFFFF; font-weight: bold; }
  .profile-body { margin-left: 24rpx; }
  .nickname { font-size: 34rpx; font-weight: bold; color: #1F2329; }
  .stage { font-size: 24rpx; color: #A3AAB5; margin-top: 8rpx; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 8rpx 32rpx; }
  .row { flex-direction: row; align-items: center; padding: 30rpx 0; border-bottom-width: 1px; border-bottom-color: #F2F1EF; }
  .row-text { flex: 1; font-size: 30rpx; color: #1F2329; }
  .arrow { font-size: 36rpx; color: #C9CDD4; }
  .btn-logout { width: 700rpx; height: 96rpx; line-height: 96rpx; background-color: #FFFFFF; color: #E5484D; font-size: 30rpx; border-radius: 24rpx; margin-top: 40rpx; }

  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.45); justify-content: center; align-items: center; }
  .dialog { width: 560rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 40rpx 32rpx 24rpx 32rpx; }
  .dlg-title { font-size: 32rpx; font-weight: bold; color: #1F2329; text-align: center; }
  .dlg-content { font-size: 27rpx; color: #6B7280; margin-top: 20rpx; text-align: center; line-height: 40rpx; }
  .dlg-actions { flex-direction: row; justify-content: space-between; margin-top: 36rpx; }
  .dlg-btn { width: 230rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 29rpx; color: #6B7280; background-color: #F5F4F2; border-radius: 40rpx; }
  .dlg-btn-ok { color: #FFFFFF; background-color: #FF7A6B; }
</style>
