<template>
  <view class="page" :class="themeClass()">
    <view class="profile lb-rise">
      <view class="avatar"><text class="avatar-text">{{ avatarText }}</text></view>
      <view class="profile-body">
        <text class="nickname">{{ nickname }}</text>
        <text class="stage">{{ stageText }}{{ journeyState.title.length > 0 ? ' · ' + journeyState.title : '' }}</text>
      </view>
    </view>

    <view class="card lb-rise-1">
      <view class="row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/baby/baby-home')"><text class="row-text">👶 宝宝档案</text><text class="arrow">›</text></view>
      <view class="row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/me/family')"><text class="row-text">👪 家庭组（邀请爸爸）</text><text class="arrow">›</text></view>
      <view class="row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/me/privacy')"><text class="row-text">🔒 隐私与安全</text><text class="arrow">›</text></view>
      <view class="row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/me/settings')"><text class="row-text">⚙️ 提醒与设置</text><text class="arrow">›</text></view>
      <view class="row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/me/about')"><text class="row-text">ℹ️ 关于与免责声明</text><text class="arrow">›</text></view>
    </view>

    <button class="btn-logout lb-rise-2" @click="logout">退出登录</button>

    <!-- 自绘确认弹窗（web 端 uni.showModal 回调不触发，见 docs/08 已知限制） -->
    <view class="mask lb-fade" v-if="confirmVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">{{ confirmTitle }}</text>
        <text class="dlg-content">{{ confirmContent }}</text>
        <view class="dlg-actions">
          <text class="dlg-btn" v-if="confirmShowCancel" @click="confirmVisible = false">取消</text>
          <text class="dlg-btn dlg-btn-ok" @click="onConfirm">确定</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { appState, clearToken } from '../../store/appStore.uts'
  import { journeyState, stageText as journeyStageText } from '../../store/journeyStore.uts'
  import { luckyId } from '../../utils/request.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const nickname = computed((): string => appState.nickname.length > 0 ? appState.nickname : '未设置昵称')
  const avatarText = computed((): string => appState.nickname.length > 0 ? appState.nickname.slice(0, 1) : '?')
  const stageText = computed((): string => journeyStageText(journeyState.stage))

  function go(url: string) { uni.navigateTo({ url }) }

  async function loadProfile() {
    try {
      const res = await luckyId('getProfile', {} as UTSJSONObject)
      const u = res.getJSON('userInfo')
      if (u != null) {
        appState.nickname = (u as UTSJSONObject).getString('nickname') ?? ''
      }
    } catch (e) { /* 已登录态校验由请求层兜底 */ }
  }

  const confirmVisible = ref<boolean>(false)
  const confirmTitle = ref<string>('')
  const confirmContent = ref<string>('')
  const confirmShowCancel = ref<boolean>(true)

  function logout() {
    confirmTitle.value = '退出登录'
    confirmContent.value = '你的记录会安全保存在云端，随时可以回来。'
    confirmShowCancel.value = true
    confirmVisible.value = true
  }

  async function onConfirm() {
    confirmVisible.value = false
    try { await luckyId('logout', {} as UTSJSONObject) } catch (e) { /* 忽略 */ }
    clearToken()
    uni.reLaunch({ url: '/pages/account/login' })
  }

  onPageReady(() => { loadProfile() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .profile { width: 702rpx; flex-direction: row; align-items: center; padding: 36rpx 8rpx; }
  .avatar { width: 116rpx; height: 116rpx; border-radius: 58rpx; background-image: linear-gradient(135deg, #F376A0, #D43770); align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(228,83,127,0.28); }
  .avatar-text { font-size: 46rpx; color: #FFFFFF; font-weight: bold; }
  .profile-body { margin-left: 26rpx; }
  .nickname { font-size: 36rpx; font-weight: bold; color: var(--lb-text-1); }
  .stage { font-size: 24rpx; color: var(--lb-text-3); margin-top: 8rpx; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 8rpx 32rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .row { flex-direction: row; align-items: center; padding: 30rpx 8rpx; border-bottom-width: 1px; border-bottom-color: var(--lb-line); transition: all 160ms ease-out; }
  .row-text { flex: 1; font-size: 30rpx; color: var(--lb-text-1); }
  .arrow { font-size: 36rpx; color: var(--lb-arrow); }
  .btn-logout { width: 702rpx; height: 100rpx; line-height: 100rpx; background-color: var(--lb-card); color: var(--lb-danger); font-size: 30rpx; border-radius: 36rpx; margin-top: 40rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }

  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--lb-mask); justify-content: center; align-items: center; }
  .dialog { width: 560rpx; background-color: var(--lb-card); border-radius: 40rpx; padding: 44rpx 32rpx 28rpx 32rpx; }
  .dlg-title { font-size: 34rpx; font-weight: bold; color: var(--lb-text-1); text-align: center; }
  .dlg-content { font-size: 28rpx; color: var(--lb-text-2); margin-top: 20rpx; text-align: center; line-height: 44rpx; }
  .dlg-actions { flex-direction: row; justify-content: space-between; margin-top: 36rpx; }
  .dlg-btn { width: 230rpx; height: 84rpx; line-height: 84rpx; text-align: center; font-size: 29rpx; color: var(--lb-text-2); background-color: var(--lb-fill); border-radius: 999rpx; }
  .dlg-btn-ok { color: #FFFFFF; background-image: linear-gradient(135deg, #F376A0, #D43770); }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
