<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">产检日期</text>
      <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-date-field :value="visitDate" @change="onDateChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view hover-class="lb-press" hover-stay-time="120" @click="onPickVisitDateWeb">
        <view class="date-box" hover-class="lb-press" hover-stay-time="120"><text class="date-text">{{ visitDate }}</text></view>
      </view>
    <!-- #endif -->
      <text class="label">孕周（周）</text>
      <input class="input" type="number" v-model="week" placeholder="如 24" placeholder-class="ph" />
      <text class="label">医院 / 医生</text>
      <view class="row2">
        <input class="input half" v-model="hospital" placeholder="医院" placeholder-class="ph" />
        <input class="input half" v-model="doctor" placeholder="医生（选填）" placeholder-class="ph" />
      </view>
      <text class="label">本次项目与结果</text>
      <view class="exam" v-for="(e, i) in exams" :key="i">
        <input class="input exam-name" v-model="e.name" placeholder="项目，如 NT 超声" placeholder-class="ph" />
        <input class="input exam-result" v-model="e.result" placeholder="结果" placeholder-class="ph" />
        <text class="exam-del" @click="exams.splice(i, 1)">✕</text>
      </view>
      <text class="add-exam" @click="exams.push({ name: '', result: '', abnormal: false } as Exam)">＋ 添加项目</text>
      <text class="label">费用（元，选填）</text>
      <input class="input" type="number" v-model="cost" placeholder="0.00" placeholder-class="ph" />
      <text class="label">医生结论与叮嘱</text>
      <textarea class="ta" v-model="conclusion" placeholder="如：一切正常，继续补铁…" placeholder-class="ph" :maxlength="500" />
      <text class="label">报告照片（按孕周自动归档）</text>
      <view class="photo-row">
        <view class="photo" v-for="(p, i) in reportPreviews" :key="i">
          <image class="photo-img" :src="p" mode="aspectFill" />
          <text class="photo-del" @click="removeReport(i)">✕</text>
        </view>
        <view class="photo-add" hover-class="lb-press" hover-stay-time="120" v-if="reportPreviews.length < 9 && !uploading" @click="chooseReport"><text class="photo-add-text">＋ 照片</text></view>
      </view>
      <text class="hint" v-if="uploading">上传中…</text>
      <text class="label">下次产检时间（医生口径优先）</text>
      <!-- #ifdef APP-ANDROID || APP-IOS -->
    <lbc-date-field :value="nextDate" @change="onNextChange" />
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view hover-class="lb-press" hover-stay-time="120" @click="onPickNextDateWeb">
        <view class="date-box" hover-class="lb-press" hover-stay-time="120"><text class="date-text">{{ nextDate == '' ? '选填' : nextDate }}</text></view>
      </view>
    <!-- #endif -->
    </view>
    <button class="btn-save lb-rise-1" hover-class="lb-press" hover-stay-time="120" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存本次产检' }}</button>

    <view class="list lb-rise-2" v-if="visits.length > 0">
      <view class="card-head"><view class="title-bar" /><text class="list-title list-title-flush">历史产检</text></view>
      <view class="v-item" v-for="(v, i) in visits" :key="i">
        <view class="v-row1">
          <text class="v-date">{{ v.getString('visitDate') ?? '' }}</text>
          <text class="v-week">孕 {{ v.getNumber('week')?.toInt() ?? 0 }} 周</text>
        </view>
        <text class="v-conclusion" v-if="(v.getString('conclusion') ?? '').length > 0">{{ v.getString('conclusion') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  // #ifdef WEB
  import { pickDate } from '../../utils/pickDate.uts'
  // #endif
  import { onPageReady, currentPageQuery } from '../../utils/pageLifecycle.uts'
  import { luckyCare } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type Exam = { name: string, result: string, abnormal: boolean }

  // 注：chooseImage/uploadFile 回调类型在 HBuilderX 首次编译时如与当前 uni-app-x 版本有出入，仅需微调本文件标注。

  const scheduleId = ref<string>('')
  const week = ref<string>('')
  const nextDate = ref<string>('')
  const hospital = ref<string>('')
  const doctor = ref<string>('')
  const cost = ref<string>('')
  const conclusion = ref<string>('')
  const exams = ref<Exam[]>([{ name: '', result: '', abnormal: false } as Exam])
  const saving = ref<boolean>(false)
  const visits = ref<UTSJSONObject[]>([])
  const reportFileIds = ref<string[]>([])
  const reportPreviews = ref<string[]>([])
  const uploading = ref<boolean>(false)

  function todayStr(): string {
    const d = new Date()
    const m = d.getMonth() + 1 < 10 ? '0' + (d.getMonth() + 1) : '' + (d.getMonth() + 1)
    const dd = d.getDate() < 10 ? '0' + d.getDate() : '' + d.getDate()
    return `${d.getFullYear()}-${m}-${dd}`
  }
  const visitDate = ref<string>(todayStr())

  function onDateChange(v: string) { visitDate.value = v }
  function onNextChange(v: string) { nextDate.value = v }
  /** 报告照片：选择 → 上传 uniCloud 存储 → 记录 fileID（预览用本地临时路径） */
  function chooseReport() {
    uni.chooseImage({
      count: 9 - reportPreviews.value.length,
      success: async (res) => {
        const paths = res.tempFilePaths
        uploading.value = true
        try {
          for (let i = 0; i < paths.length; i++) {
            const cloudPath = `reports/${journeyState.journeyId}/${Date.now()}_${i}.jpg`
            const up = await uploadOne(paths[i], cloudPath)
            reportFileIds.value.push(up)
            reportPreviews.value.push(paths[i])
          }
        } catch (e) {
          uni.showToast({ title: (e as Error).message, icon: 'none' })
        } finally { uploading.value = false }
      }
    })
  }
  function uploadOne(filePath: string, cloudPath: string): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      uniCloud.uploadFile({
        filePath: filePath,
        cloudPath: cloudPath,
        success: (res) => { resolve(res.fileID) },
        fail: (err) => { reject(new Error(err.errMsg ?? '上传失败')) }
      } as UploadFileOptions)
    })
  }
  function removeReport(i: number) {
    reportFileIds.value.splice(i, 1)
    reportPreviews.value.splice(i, 1)
  }
  async function loadVisits() {
    try {
      const res = await luckyCare('listVisits', { journeyId: journeyState.journeyId } as UTSJSONObject)
      visits.value = res.getArray<UTSJSONObject>('visits') ?? []
    } catch (e) { /* 忽略 */ }
  }
  async function save() {
    const w = parseInt(week.value)
    if (!(w >= 0 && w <= 45)) { uni.showToast({ title: '请填写孕周', icon: 'none' }); return }
    const items = exams.value.filter(e => e.name.trim().length > 0)
    saving.value = true
    try {
      const res = await luckyCare('addVisit', {
        journeyId: journeyState.journeyId, visitDate: visitDate.value,
        hospital: hospital.value, doctor: doctor.value, week: w,
        items: items, costYuan: parseFloat(cost.value) || 0,
        conclusion: conclusion.value, nextVisitDate: nextDate.value,
        reportFileIds: reportFileIds.value
      } as UTSJSONObject)
      if (scheduleId.value.length > 0) {
        await luckyCare('updateItem', { journeyId: journeyState.journeyId, itemId: scheduleId.value, status: 'done' } as UTSJSONObject)
      }
      uni.showToast({ title: '已保存 ✓', icon: 'success' })
      loadVisits()
      setTimeout(() => { uni.navigateBack() }, 700)
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }

  onPageReady(() => {
    const options = currentPageQuery()
    scheduleId.value = options.getString('scheduleId') ?? ''
    const w = options.getString('week') ?? ''
    if (w.length > 0) week.value = w
    loadVisits()
  })

  // #ifdef WEB
  async function onPickVisitDateWeb() {
    const v = await pickDate(visitDate.value, '')
    if (v.length > 0) {
      onDateChange(v)
    }
  }
  // #endif

  // #ifdef WEB
  async function onPickNextDateWeb() {
    const v = await pickDate(nextDate.value, '')
    if (v.length > 0) {
      onNextChange(v)
    }
  }
  // #endif
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 26rpx; color: var(--lb-text-1); margin: 20rpx 0 12rpx 0; }
  .date-box { width: 620rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; align-items: center; padding: 0 24rpx; transition: all 160ms ease-out; }
  .date-text { font-size: 28rpx; color: var(--lb-text-1); }
  .input { width: 620rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); }
  .row2 { flex-direction: row; }
  .half { flex: 1; margin-right: 16rpx; }
  .exam { flex-direction: row; align-items: center; margin-bottom: 12rpx; }
  .exam-name { flex: 1.2; margin-right: 12rpx; }
  .exam-result { flex: 1; margin-right: 12rpx; }
  .exam-del { font-size: 32rpx; color: var(--lb-text-3); padding: 8rpx; }
  .add-exam { font-size: 26rpx; color: var(--lb-primary-text); padding: 8rpx 0; }
  .ta { width: 620rpx; height: 140rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 20rpx; font-size: 26rpx; color: var(--lb-text-1); }
  .photo-row { flex-direction: row; flex-wrap: wrap; margin-bottom: 8rpx; }
  .photo { width: 140rpx; height: 140rpx; border-radius: 20rpx; margin: 8rpx; position: relative; }
  .photo-img { width: 140rpx; height: 140rpx; border-radius: 20rpx; }
  .photo-del { position: absolute; top: 4rpx; right: 8rpx; font-size: 28rpx; color: #FFFFFF; text-shadow: 0 0 4rpx var(--lb-mask); }
  .photo-add { width: 140rpx; height: 140rpx; border-radius: 20rpx; background-color: var(--lb-fill); align-items: center; justify-content: center; margin: 8rpx; transition: all 160ms ease-out; }
  .photo-add-text { font-size: 24rpx; color: var(--lb-text-3); }
  .ph { color: var(--lb-text-3); }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-action); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 32rpx; transition: all 160ms ease-out; }
  .list { width: 702rpx; margin-top: 40rpx; }
  .list-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 16rpx; }
  .v-item { background-color: var(--lb-card); border-radius: 36rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .v-row1 { flex-direction: row; }
  .v-date { font-size: 26rpx; font-weight: bold; color: var(--lb-text-1); flex: 1; }
  .v-week { font-size: 24rpx; color: var(--lb-text-3); }
  .v-conclusion { font-size: 24rpx; color: var(--lb-text-2); margin-top: 10rpx; }

.card-head { flex-direction: row; align-items: center; margin-bottom: 16rpx; }
  .title-bar { width: 8rpx; height: 30rpx; border-radius: 4rpx; background-image: linear-gradient(180deg, var(--lb-grad-1), var(--lb-grad-2)); margin-right: 14rpx; }
  .list-title-flush { margin-bottom: 0; }
  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
