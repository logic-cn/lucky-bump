<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise" v-if="items.length == 0">
      <text class="empty">还没有产检排程</text>
      <text class="hint">按国内常规产检指南自动生成（28 周前每 4 周、28-35 周每 2 周、36 周起每周）</text>
      <button class="btn-save" hover-class="lb-press" hover-stay-time="120" :disabled="generating" @click="generate">{{ generating ? '生成中…' : '一键生成产检排程' }}</button>
      <text class="hint" v-if="highRiskNote.length > 0">{{ highRiskNote }}</text>
    </view>

    <view class="item lb-rise-1" v-for="(it, i) in items" :key="i" hover-class="lb-press" hover-stay-time="120" @click="openVisit(it)">
      <view class="dot-col">
        <view class="dot" :class="dotClass(it)" />
        <view class="dot-line" v-if="i < items.length - 1" />
      </view>
      <view class="item-body">
        <view class="row1">
          <text class="item-title">{{ it.getString('title') ?? '' }}</text>
          <text class="status" :class="'status-' + (it.getString('displayStatus') ?? '')">{{ statusText(it.getString('displayStatus') ?? '') }}</text>
        </view>
        <text class="item-sub">孕 {{ it.getNumber('week')?.toInt() }} 周 · {{ it.getString('planDate') ?? '' }}</text>
        <text class="item-prep" v-if="(it.getString('prep') ?? '').length > 0">📋 {{ it.getString('prep') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onLoad, onPageShow } from '@dcloudio/uni-app'
  import { luckyCare } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const items = ref<UTSJSONObject[]>([])
  const generating = ref<boolean>(false)
  const highRiskNote = ref<string>('')

  function statusText(s: string): string {
    if (s == 'done') return '已完成'
    if (s == 'skipped') return '已跳过'
    if (s == 'due') return '该去产检了'
    return '未到'
  }
  function dotClass(it: UTSJSONObject): string {
    const s = it.getString('displayStatus') ?? ''
    if (s == 'done') return 'dot-done'
    if (s == 'due') return 'dot-due'
    return 'dot-upcoming'
  }
  async function load() {
    try {
      const res = await luckyCare('listPlan', { journeyId: journeyState.journeyId } as UTSJSONObject)
      items.value = res.getArray<UTSJSONObject>('items') ?? []
      highRiskNote.value = res.getString('highRiskNote') ?? ''
    } catch (e) { /* 忽略 */ }
  }
  async function generate() {
    generating.value = true
    try {
      const res = await luckyCare('generatePlan', { journeyId: journeyState.journeyId } as UTSJSONObject)
      uni.showToast({ title: `已生成 ${res.getNumber('count')?.toInt() ?? 0} 次产检计划 ✓`, icon: 'none' })
      load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { generating.value = false }
  }
  function openVisit(it: UTSJSONObject) {
    const status = it.getString('displayStatus') ?? ''
    if (status == 'done' || status == 'skipped') return
    uni.navigateTo({ url: `/pages/care/visit?scheduleId=${it.getString('_id') ?? ''}&week=${it.getNumber('week')?.toInt() ?? 0}` })
  }

  onLoad(() => { load() })
  onPageShow(() => { if (items.value.length > 0) load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 40rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .empty { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); }
  .hint { font-size: 22rpx; color: var(--lb-text-3); margin: 16rpx 0; text-align: center; }
  .btn-save { width: 620rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 24rpx; transition: all 160ms ease-out; }
  .item { width: 702rpx; flex-direction: row; background-color: var(--lb-card); border-radius: 36rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); transition: all 160ms ease-out; }
  .dot-col { align-items: center; margin-right: 20rpx; }
  .dot { width: 20rpx; height: 20rpx; border-radius: 10rpx; margin-top: 10rpx; }
  .dot-done { background-color: var(--lb-success); }
  .dot-due { background-color: var(--lb-danger); }
  .dot-upcoming { background-color: var(--lb-line-deep); }
  .dot-line { width: 2px; flex: 1; background-color: var(--lb-line); margin: 8rpx 0; }
  .item-body { flex: 1; }
  .row1 { flex-direction: row; align-items: center; }
  .item-title { font-size: 30rpx; font-weight: bold; color: var(--lb-text-1); flex: 1; }
  .status { font-size: 20rpx; border-radius: 16rpx; padding: 4rpx 12rpx; }
  .status-done { color: var(--lb-success); background-color: var(--lb-success-soft); }
  .status-due { color: var(--lb-danger); background-color: var(--lb-danger-soft); }
  .status-upcoming { color: var(--lb-text-3); background-color: var(--lb-line); }
  .status-skipped { color: var(--lb-text-3); background-color: var(--lb-line); }
  .item-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 8rpx; }
  .item-prep { font-size: 22rpx; color: var(--lb-text-2); margin-top: 8rpx; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
