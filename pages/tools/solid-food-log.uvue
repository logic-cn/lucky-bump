<template>
  <view class="page" :class="themeClass()">
    <lbc-error v-if="loadFailed" :message="errorMsg" @retry="load" />
    <lbc-empty v-if="noBaby && !loadFailed" title="还没有宝宝档案" hint="先在宝宝页添加档案，才能记录辅食与过敏观察" ctaText="去添加" @cta="goBaby" />

    <view class="body" v-if="!noBaby && !loadFailed">
      <view class="card lb-rise">
        <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">辅食记录</text></view>
        <view class="input-row">
          <input class="input" v-model="foodName" placeholder="新食物名称，如：南瓜泥" placeholder-class="ph" confirm-type="done" @confirm="add" />
          <view class="btn-add" hover-class="lb-press" hover-stay-time="120" @click="add"><text class="btn-add-text">{{ adding ? '记录中…' : '记录' }}</text></view>
        </view>
        <text class="hint">新增食物连续观察 3 天，留意皮疹、呕吐、腹泻等反应；1 岁前不加盐糖蜂蜜。</text>
      </view>

      <view class="card lb-rise-1">
        <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">尝试概览</text></view>
        <view class="stat-row">
          <view class="stat-col"><text class="stat-num">{{ triedCount }}</text><text class="stat-cap">种食物</text></view>
          <view class="stat-col"><text class="stat-num stat-danger">{{ allergenCount }}</text><text class="stat-cap">待复试/过敏</text></view>
        </view>
        <text class="allergen-line" v-if="allergenCount > 0">已标记：{{ allergenNames }}</text>
      </view>

      <view class="card lb-rise-2" v-if="logs.length > 0">
        <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">最近记录</text></view>
        <view class="log-row" v-for="(l, i) in logs" :key="i">
          <view class="log-body">
            <view class="log-head">
              <text class="log-name">{{ l.getString('name') }}</text>
              <text class="log-tag" v-if="l.getBoolean('first') == true">首次</text>
              <text class="log-tag log-tag-danger" v-if="l.getBoolean('confirmed_allergy') == true">待复试</text>
            </view>
            <text class="log-sub">{{ l.getString('date') }} · {{ reactionText(l.getString('reaction') ?? '') }}</text>
          </view>
          <view class="log-mark" hover-class="lb-press" hover-stay-time="120" @click="openMark(l)"><text class="log-mark-text">标记反应</text></view>
        </view>
      </view>

      <view class="card lb-rise-3">
        <text class="gray">观察记录用于家长自查与就诊沟通，不构成诊断；出现呼吸急促、面唇肿胀等严重表现请立即就医。</text>
      </view>
    </view>

    <!-- 标记反应弹窗 -->
    <view class="mask lb-fade" v-if="markVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">「{{ markName }}」的反应</text>
        <view class="opt-wrap">
          <view class="opt" v-for="(r, i) in reactions" :key="i" :class="markReaction == r.value ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="markReaction = r.value">
            <text class="opt-text" :class="markReaction == r.value ? 'opt-text-active' : ''">{{ r.label }}</text>
          </view>
        </view>
        <text class="hint" v-if="markReaction != '' && markReaction != 'none'">标记后该食物会进入「待复试」，暂停添加 1–2 周，少量复试并咨询医生。</text>
        <view class="dlg-actions">
          <text class="dlg-btn dlg-btn-cancel" hover-class="lb-press" hover-stay-time="120" @click="markVisible = false">取消</text>
          <text class="dlg-btn dlg-btn-ok" hover-class="lb-press" hover-stay-time="120" @click="saveMark">{{ marking ? '保存中…' : '保存' }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyBaby, luckyJourney } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type Reaction = { value: string, label: string }

  const babyId = ref<string>('')
  const noBaby = ref<boolean>(false)
  const loadFailed = ref<boolean>(false)
  const errorMsg = ref<string>('')
  const logs = ref<UTSJSONObject[]>([])
  const allergens = ref<string[]>([])
  const triedFoods = ref<string[]>([])
  const foodName = ref<string>('')
  const adding = ref<boolean>(false)

  const markVisible = ref<boolean>(false)
  const marking = ref<boolean>(false)
  const markId = ref<string>('')
  const markName = ref<string>('')
  const markReaction = ref<string>('')

  const reactions = ref<Reaction[]>([
    { value: 'none', label: '无异常' }, { value: 'rash', label: '皮疹' },
    { value: 'vomiting', label: '呕吐' }, { value: 'diarrhea', label: '腹泻' }, { value: 'other', label: '其他' }
  ])

  const triedCount = computed((): number => triedFoods.value.length)
  const allergenCount = computed((): number => allergens.value.length)
  const allergenNames = computed((): string => allergens.value.join('、'))

  function reactionText(r: string): string {
    if (r == 'rash') return '皮疹待观察'
    if (r == 'vomiting') return '呕吐待观察'
    if (r == 'diarrhea') return '腹泻待观察'
    if (r == 'other') return '其他反应待观察'
    if (r == 'none') return '暂无异常'
    return '待观察'
  }

  async function ensureBaby(): Promise<boolean> {
    const stored = uni.getStorageSync('current_baby_id') as string
    babyId.value = stored ?? ''
    if (babyId.value.length == 0) {
      const res = await luckyJourney('listBabies', { journeyId: journeyState.journeyId } as UTSJSONObject)
      const babies = res.getArray<UTSJSONObject>('babies') ?? []
      if (babies.length > 0) {
        babyId.value = babies[0].getString('_id') ?? ''
        uni.setStorageSync('current_baby_id', babyId.value)
      }
    }
    return babyId.value.length > 0
  }

  async function load() {
    try {
      if (!(await ensureBaby())) {
        noBaby.value = true
        loadFailed.value = false
        return
      }
      const r = await luckyBaby('foodDashboard', { journeyId: journeyState.journeyId, babyId: babyId.value } as UTSJSONObject)
      logs.value = r.getArray<UTSJSONObject>('logs') ?? []
      allergens.value = r.getArray<string>('allergens') ?? []
      triedFoods.value = r.getArray<string>('triedFoods') ?? []
      noBaby.value = false
      loadFailed.value = false
    } catch (e) {
      loadFailed.value = true
      errorMsg.value = (e as Error).message
    }
  }

  async function add() {
    if (adding.value) return
    const name = foodName.value.trim()
    if (name.length == 0) {
      uni.showToast({ title: '先填写食物名称', icon: 'none' })
      return
    }
    adding.value = true
    try {
      const r = await luckyBaby('addFood', { journeyId: journeyState.journeyId, babyId: babyId.value, name } as UTSJSONObject)
      foodName.value = ''
      uni.showToast({ title: r.getBoolean('first') == true ? '已记录，开始 3 天观察' : '已记录', icon: 'none' })
      await load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally {
      adding.value = false
    }
  }

  function openMark(l: UTSJSONObject) {
    markId.value = l.getString('_id') ?? ''
    markName.value = l.getString('name') ?? ''
    markReaction.value = l.getString('reaction') ?? ''
    markVisible.value = true
  }

  async function saveMark() {
    if (marking.value || markReaction.value.length == 0) return
    marking.value = true
    try {
      const r = await luckyBaby('logFoodReaction', { foodLogId: markId.value, reaction: markReaction.value } as UTSJSONObject)
      markVisible.value = false
      const alert = r.getString('alert') ?? ''
      uni.showToast({ title: alert.length > 0 ? alert : '已更新', icon: 'none' })
      await load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally {
      marking.value = false
    }
  }

  function goBaby() { uni.navigateBack({ delta: 1 }) }

  onPageReady(() => { load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .body { width: 702rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 36rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-head { flex-direction: row; align-items: center; margin-bottom: 20rpx; }
  .title-bar { width: 8rpx; height: 30rpx; border-radius: 4rpx; background-image: linear-gradient(180deg, var(--lb-grad-1), var(--lb-grad-2)); margin-right: 14rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); }
  .card-title-flush { margin-bottom: 0; }
  .input-row { flex-direction: row; align-items: center; }
  .input { flex: 1; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); }
  .ph { color: var(--lb-text-3); }
  .btn-add { margin-left: 16rpx; padding: 20rpx 34rpx; border-radius: 999rpx; background-image: linear-gradient(135deg, var(--lb-grad-1), var(--lb-grad-2)); }
  .btn-add-text { font-size: 26rpx; color: var(--lb-white); font-weight: bold; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); line-height: 38rpx; margin-top: 16rpx; }
  .gray { font-size: 24rpx; color: var(--lb-text-3); line-height: 38rpx; }
  .stat-row { flex-direction: row; }
  .stat-col { flex: 1; align-items: center; }
  .stat-num { font-size: 48rpx; font-weight: bold; color: var(--lb-primary); }
  .stat-danger { color: var(--lb-danger); }
  .stat-cap { font-size: 24rpx; color: var(--lb-text-3); margin-top: 4rpx; }
  .allergen-line { font-size: 26rpx; color: var(--lb-danger); margin-top: 16rpx; }
  .log-row { flex-direction: row; align-items: center; padding: 20rpx 0; border-bottom-width: 1px; border-bottom-color: var(--lb-line); }
  .log-body { flex: 1; }
  .log-head { flex-direction: row; align-items: center; }
  .log-name { font-size: 28rpx; color: var(--lb-text-1); font-weight: bold; }
  .log-tag { font-size: 24rpx; color: var(--lb-primary-deep); background-color: var(--lb-primary-soft); border-radius: 10rpx; padding: 2rpx 10rpx; margin-left: 10rpx; }
  .log-tag-danger { color: var(--lb-danger); background-color: var(--lb-danger-soft); }
  .log-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 4rpx; }
  .log-mark { padding: 10rpx 20rpx; border-radius: 999rpx; background-color: var(--lb-fill); }
  .log-mark-text { font-size: 24rpx; color: var(--lb-text-2); }
  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(50,36,48,0.5); align-items: center; justify-content: center; }
  .dialog { width: 620rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 44rpx 36rpx 36rpx 36rpx; align-items: center; }
  .dlg-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); text-align: center; }
  .opt-wrap { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 20rpx; }
  .opt { padding: 16rpx 28rpx; border-radius: 20rpx; background-color: var(--lb-fill); margin: 8rpx; }
  .opt-active { background-color: var(--lb-primary-soft); }
  .opt-text { font-size: 26rpx; color: var(--lb-text-2); }
  .opt-text-active { color: var(--lb-primary-deep); font-weight: bold; }
  .dlg-actions { flex-direction: row; margin-top: 32rpx; }
  .dlg-btn { padding: 18rpx 44rpx; border-radius: 999rpx; font-size: 28rpx; margin: 0 10rpx; }
  .dlg-btn-cancel { background-color: var(--lb-fill); color: var(--lb-text-2); }
  .dlg-btn-ok { background-image: linear-gradient(135deg, var(--lb-grad-1), var(--lb-grad-2)); color: var(--lb-white); font-weight: bold; }
  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
