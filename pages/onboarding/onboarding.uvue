<template>
  <view class="page" :class="themeClass()">
    <text class="title lb-rise">你好，欢迎来到幸孕记</text>
    <text class="sub lb-rise">你现在处于哪个阶段？我们会据此为你安排一切</text>

    <view v-if="step == 0" class="options lb-rise-1">
      <view class="option" hover-class="lb-press" hover-stay-time="120" @click="choose('ttc')">
        <text class="opt-title">我在备孕</text>
        <text class="opt-sub">记录经期与排卵，迎接好孕</text>
      </view>
      <view class="option" hover-class="lb-press" hover-stay-time="120" @click="choose('pregnant')">
        <text class="opt-title">我已经怀孕</text>
        <text class="opt-sub">产检提醒、孕期记录、宝宝发育</text>
      </view>
      <view class="option" hover-class="lb-press" hover-stay-time="120" @click="choose('parenting')">
        <text class="opt-title">宝宝已出生</text>
        <text class="opt-sub">喂养睡眠记录、成长曲线、疫苗</text>
      </view>
    </view>

    <view v-if="step == 1" class="card lb-rise-1">
      <text class="q">{{ questionText }}</text>
      <picker mode="date" :value="dateValue" @change="onDateChange">
        <view class="date-box" hover-class="lb-press" hover-stay-time="120"><text class="date-text">{{ dateValue == '' ? '点这里选择日期' : dateValue }}</text></view>
      </picker>
      <text class="q q-top">身高与孕前体重（选填，用于个性化增重区间）</text>
      <view class="row-inputs">
        <input class="mini-input" type="number" v-model="heightCm" placeholder="身高 cm" placeholder-class="ph" />
        <input class="mini-input" type="number" v-model="preWeightKg" placeholder="孕前体重 kg" placeholder-class="ph" />
      </view>
      <button class="btn-primary" hover-class="lb-press" hover-stay-time="120" :disabled="loading" @click="submit">{{ loading ? '保存中…' : '开始' }}</button>
      <view class="link-wrap" hover-class="lb-press" hover-stay-time="120">
        <text class="link" @click="step = 0">返回上一步</text>
      </view>
    </view>

    <text class="tip lb-rise-2">日期不确定也没关系，之后可随时修正（页面会标注"估算"）。</text>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { luckyJourney, luckyId } from '../../utils/request.uts'
  import { themeClass } from '../../store/themeStore.uts'
  import { track } from '../../utils/track.uts'

  const step = ref<number>(0)        // 0 选阶段 / 1 录日期
  const mode = ref<string>('ttc')
  const dateValue = ref<string>('')
  const heightCm = ref<string>('')
  const preWeightKg = ref<string>('')
  const loading = ref<boolean>(false)

  const questionText = computed((): string => {
    if (mode.value == 'ttc') return '最近一次月经（末次月经）是哪天？'
    if (mode.value == 'pregnant') return '末次月经第一天是哪天？（记不清可选 B 超推算的孕周，稍后在"我的-旅程设置"中修正）'
    return '宝宝的出生日期是哪天？'
  })

  function choose(m: string) {
    mode.value = m
    dateValue.value = ''
    step.value = 1
  }
  function onDateChange(e: UniPickerChangeEvent) {
    dateValue.value = (e.detail.value as string) ?? ''
  }
  async function submit() {
    if (loading.value) return
    if (dateValue.value.length == 0) { uni.showToast({ title: '请选择日期', icon: 'none' }); return }
    loading.value = true
    try {
      if (mode.value == 'parenting') {
        // 宝宝已出生：先建旅程占位，引导到分娩登记补录
        const res = await luckyJourney('createJourney', { mode: 'ttc', title: '我的旅程' } as UTSJSONObject)
        loading.value = false
        uni.showToast({ title: '请先补充分娩登记', icon: 'none' })
        uni.reLaunch({ url: '/pages/baby/birth-register' })
        return
      }
      const res = await luckyJourney('createJourney', { mode: mode.value, lmpDate: dateValue.value } as UTSJSONObject)
      if (res.getNumber('errCode') == 0) {
        track('onboarding_complete', { mode: mode.value } as UTSJSONObject)
        // 选填身体档案：失败不阻塞建档（体重页可再补录）
        const h = parseFloat(heightCm.value)
        const w = parseFloat(preWeightKg.value)
        if (h >= 120 && h <= 220 && w >= 30 && w <= 200) {
          try { await luckyId('updateProfile', { heightCm: h, prePregnancyWeightKg: w } as UTSJSONObject) } catch (e) { /* 忽略 */ }
        }
        // 不在跳转前 applyJourney：首页 onShow 会经 loadCurrentJourney 拉取最新旅程并写入状态；
        // 此处若先改全局 reactive 再立即 reLaunch，会触发 web 端 vdom 回退渲染的 proxy 竞态
        loading.value = false
        uni.reLaunch({ url: '/pages/index/index' })
        return
      }
      loading.value = false
      uni.showToast({ title: res.getString('errMsg') ?? '创建失败', icon: 'none' })
    } catch (e) {
      loading.value = false
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    }
  }
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); align-items: center; padding-top: 100rpx; }
  .title { font-size: 44rpx; font-weight: bold; color: var(--lb-text-1); }
  .sub { font-size: 26rpx; color: var(--lb-text-2); margin-top: 16rpx; margin-bottom: 64rpx; }
  .options { width: 640rpx; }
  .option { background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); transition: all 160ms ease-out; }
  .opt-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); }
  .opt-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 8rpx; }
  .card { width: 640rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 48rpx 40rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .q { font-size: 30rpx; color: var(--lb-text-1); margin-bottom: 32rpx; }
  .q-top { margin-top: 40rpx; margin-bottom: 20rpx; }
  .row-inputs { flex-direction: row; margin-bottom: 24rpx; }
  .mini-input { flex: 1; height: 80rpx; background-color: var(--lb-fill); border-radius: 20rpx; padding: 0 20rpx; font-size: 26rpx; color: var(--lb-text-1); margin-right: 16rpx; }
  .ph { color: var(--lb-text-3); }
  .date-box { width: 560rpx; height: 96rpx; background-color: var(--lb-fill); border-radius: 24rpx; align-items: center; justify-content: center; margin-bottom: 40rpx; transition: all 160ms ease-out; }
  .date-text { font-size: 30rpx; color: var(--lb-text-1); }
  .btn-primary { background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; height: 96rpx; line-height: 96rpx; border-radius: 48rpx; width: 560rpx; transition: all 160ms ease-out; }
  .link-wrap { margin-top: 32rpx; padding: 8rpx 24rpx; border-radius: 24rpx; transition: all 160ms ease-out; }
  .link { color: var(--lb-primary); font-size: 26rpx; }
  .tip { font-size: 24rpx; color: var(--lb-text-3); margin-top: 48rpx; width: 640rpx; text-align: center; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
