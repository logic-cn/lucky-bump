<template>
  <view class="page">
    <view class="card">
      <text class="label">今天的排卵试纸结果</text>
      <view class="opts">
        <view class="opt" v-for="(o, i) in opts" :key="i" :class="result == o.value ? 'opt-active' : ''" @click="result = o.value">
          <text class="opt-emoji">{{ o.emoji }}</text>
          <text class="opt-text" :class="result == o.value ? 'opt-text-active' : ''">{{ o.label }}</text>
        </view>
      </view>
      <text class="hint" v-if="result == 'strong_positive'">强阳通常预示未来 24-48 小时内排卵，易孕窗口已更新</text>
      <text class="hint" v-else>建议每天同一时间测，接近强阳时缩短至 4-6 小时一次</text>
      <button class="btn-save" :disabled="saving || result.length == 0" @click="save">{{ saving ? '保存中…' : '保存' }}</button>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'

  type Opt = { value: string, label: string, emoji: string }

  const result = ref('')
  const opts = ref<Opt[]>([
    { value: 'negative', label: '阴性', emoji: '⚪' },
    { value: 'weak_positive', label: '弱阳', emoji: '🌥' },
    { value: 'strong_positive', label: '强阳', emoji: '🔥' }
  ])
  const saving = ref(false)

  async function save() {
    saving.value = true
    try {
      await luckyRecord('addCycleEvent', { journeyId: journeyState.journeyId, type: 'ovulation_test', value: { result: result.value } } as UTSJSONObject)
      uni.showToast({ title: '已记录 ✓', icon: 'success' })
      setTimeout(() => { uni.navigateBack() }, 600)
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 40rpx; margin-top: 40rpx; align-items: center; }
  .label { font-size: 30rpx; color: #1F2329; margin-bottom: 32rpx; }
  .opts { flex-direction: row; margin-bottom: 24rpx; }
  .opt { width: 200rpx; align-items: center; background-color: #F7F6F4; border-radius: 20rpx; padding: 32rpx 0; margin: 0 10rpx; }
  .opt-active { background-color: #FFEFEA; }
  .opt-emoji { font-size: 44rpx; }
  .opt-text { font-size: 26rpx; color: #6B7280; margin-top: 12rpx; }
  .opt-text-active { color: #FF7A6B; font-weight: bold; }
  .hint { font-size: 22rpx; color: #A3AAB5; margin: 16rpx 0 32rpx 0; }
  .btn-save { width: 620rpx; height: 96rpx; line-height: 96rpx; background-color: #FF7A6B; color: #FFFFFF; font-size: 32rpx; border-radius: 44rpx; }
</style>
