<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">今天的排卵试纸结果</text>
      <view class="opts">
        <view class="opt" v-for="(o, i) in opts" :key="i" :class="result == o.value ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="result = o.value">
          <image class="opt-emoji" :src="'/static/icons/' + o.icon + '.png'" mode="aspectFit" />
          <text class="opt-text" :class="result == o.value ? 'opt-text-active' : ''">{{ o.label }}</text>
        </view>
      </view>
      <text class="hint" v-if="result == 'strong_positive'">强阳通常预示未来 24-48 小时内排卵，易孕窗口已更新</text>
      <text class="hint" v-else>建议每天同一时间测，接近强阳时缩短至 4-6 小时一次</text>
      <text class="label">试纸照片（选填，便于对比 LH 深浅）</text>
      <view class="photo-row" v-if="photoUrl.length > 0">
        <image class="photo" :src="photoUrl" mode="aspectFill" />
        <text class="photo-del" @click="photoUrl = ''">移除</text>
      </view>
      <view class="photo-add" v-else hover-class="lb-press" hover-stay-time="120" @click="choosePhoto">
        <text class="photo-add-text">{{ uploading ? '上传中…' : '拍照 / 从相册选择' }}</text>
      </view>
      <button class="btn-save" :disabled="saving || uploading || result.length == 0" @click="save">{{ saving ? '保存中…' : '保存' }}</button>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type Opt = { value: string, label: string, icon: string }

  const result = ref('')
  const photoUrl = ref('')
  const uploading = ref(false)
  const opts = ref<Opt[]>([
    { value: 'negative', label: '阴性', icon: 'strip-neg' },
    { value: 'weak_positive', label: '弱阳', icon: 'strip-weak' },
    { value: 'strong_positive', label: '强阳', icon: 'strip-strong' }
  ])
  const saving = ref(false)

  /** 试纸拍照（复用相册上传链路：chooseImage → uniCloud.uploadFile → fileID） */
  function choosePhoto() {
    if (uploading.value) return
    uni.chooseImage({
      count: 1,
      sizeType: ['compressed'],
      success: (res: any) => {
        const paths = res.tempFilePaths as string[]
        if (paths.length > 0) uploadPhoto(paths[0])
      },
      fail: () => { }
    })
  }
  async function uploadPhoto(path: string): Promise<void> {
    uploading.value = true
    try {
      const dot = path.lastIndexOf('.')
      const ext = dot >= 0 ? path.slice(dot + 1) : 'jpg'
      const cloudPath = `ovulation-test/${journeyState.journeyId}/${Date.now()}.${ext}`
      const up = await uniCloud.uploadFile({ filePath: path, cloudPath } as UTSJSONObject)
      const fileId = (up as UTSJSONObject).getString('fileID') ?? ''
      if (fileId.length == 0) throw new Error('上传失败，请重试')
      photoUrl.value = fileId
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { uploading.value = false }
  }

  async function save() {
    saving.value = true
    try {
      // UTSJSONObject 动态键写入各端行为不一，经 JSON 往返构造最稳妥
      const raw = photoUrl.value.length > 0 ? { result: result.value, photoUrl: photoUrl.value } : { result: result.value }
      const value = JSON.parse(JSON.stringify(raw)) as UTSJSONObject
      await luckyRecord('addCycleEvent', { journeyId: journeyState.journeyId, type: 'ovulation_test', value } as UTSJSONObject)
      uni.showToast({ title: '已记录 ✓', icon: 'success' })
      setTimeout(() => { uni.navigateBack() }, 600)
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 40rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 30rpx; color: var(--lb-text-1); margin-bottom: 32rpx; }
  .opts { flex-direction: row; justify-content: space-between; margin-bottom: 24rpx; }
  .opt { flex: 1; align-items: center; background-color: var(--lb-fill); border-radius: 24rpx; padding: 32rpx 0; margin: 0 8rpx; transition: all 160ms ease-out; }
  .opt-active { background-color: var(--lb-primary-soft); }
  .opt-emoji { width: 52rpx; height: 52rpx; }
  .opt-text { font-size: 26rpx; color: var(--lb-text-1); margin-top: 12rpx; }
  .opt-text-active { color: var(--lb-primary-deep); font-weight: bold; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin: 16rpx 0 32rpx 0; }
  .photo-row { flex-direction: row; align-items: center; margin-bottom: 24rpx; }
  .photo { width: 160rpx; height: 160rpx; border-radius: 24rpx; background-color: var(--lb-fill); }
  .photo-del { font-size: 26rpx; color: var(--lb-danger); margin-left: 24rpx; padding: 16rpx 24rpx; }
  .photo-add { width: 620rpx; height: 140rpx; border-radius: 24rpx; background-color: var(--lb-fill); align-items: center; justify-content: center; margin-bottom: 24rpx; transition: all 160ms ease-out; }
  .photo-add-text { font-size: 28rpx; color: var(--lb-text-2); }
  .btn-save { width: 620rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
