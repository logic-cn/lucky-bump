<template>
  <view class="page" :class="themeClass()">
    <view class="group lb-rise" v-for="(g, gi) in groups" :key="gi">
      <view class="group-head">
        <view class="title-bar" />
        <text class="group-title">{{ g.title }}</text>
      </view>
      <view class="grid">
        <view class="grid-item" v-for="(item, i) in g.items" :key="i" hover-class="lb-press" hover-stay-time="120" @click="go(item.url)">
          <view class="grid-chip" :class="chipClass(item.url)">
            <image class="grid-icon" :src="'/static/icons/' + item.icon + '.png'" mode="aspectFit" />
          </view>
          <text class="grid-label">{{ item.label }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'
  import { recentUrls, rememberRecent, recentRank } from '../../utils/recentGrid.uts'

  type RItem = { icon: string, label: string, url: string }
  type RGroup = { title: string, items: RItem[] }

  // 最近使用：本地记录打开过的记录页
  const recent = ref<string[]>([])

  function loadRecent() { recent.value = recentUrls() }
  function remember(url: string) { recent.value = rememberRecent(url) }
  // 组内稳定排序：用过的按最近先后前置，未用过的保持原有顺序
  function orderByRecent(items: RItem[]): RItem[] {
    if (recent.value.length == 0) return items
    const used: RItem[] = []
    const rest: RItem[] = []
    for (let i = 0; i < items.length; i++) {
      if (recentRank(items[i].url, recent.value) < 999) used.push(items[i]); else rest.push(items[i])
    }
    for (let i = 0; i < used.length; i++) {
      for (let j = i + 1; j < used.length; j++) {
        if (recentRank(used[j].url, recent.value) < recentRank(used[i].url, recent.value)) {
          const t = used[i]
          used[i] = used[j]
          used[j] = t
        }
      }
    }
    return used.concat(rest)
  }

  const groups = computed((): RGroup[] => {
        const s = journeyState.stage
        const groups: RGroup[] = []
        const ttc: RItem[] = [
          { icon: 'cycle', label: '经期', url: '/pages/record/cycle' },
          { icon: 'test', label: '排卵试纸', url: '/pages/record/ovulation-test' },
          { icon: 'thermo', label: '基础体温', url: '/pages/record/cycle' },
          { icon: 'preg', label: '验孕', url: '/pages/record/pregnancy-test' },
          { icon: 'privacy', label: '同房', url: '/pages/record/cycle' },
          { icon: 'glucose', label: '饮水记录', url: '/pages/record/water' },
          { icon: 'pill', label: '用药记录', url: '/pages/record/medication' }
        ]
        const pregnancy: RItem[] = [
          { icon: 'weight', label: '体重', url: '/pages/record/weight' },
          { icon: 'bp', label: '血压', url: '/pages/record/blood-pressure' },
          { icon: 'glucose', label: '血糖', url: '/pages/record/blood-glucose' },
          { icon: 'fetal', label: '胎动', url: '/pages/record/fetal-movement' },
          { icon: 'timer', label: '宫缩计时', url: '/pages/record/contraction-timer' },
          { icon: 'symptom', label: '症状情绪', url: '/pages/record/symptom' },
          { icon: 'pill', label: '用药记录', url: '/pages/record/medication' },
          { icon: 'glucose', label: '饮水记录', url: '/pages/record/water' },
          { icon: 'diary', label: '日记', url: '/pages/record/diary' },
          { icon: 'bag', label: '待产包', url: '/pages/tools/hospital-bag' }
        ]
        const postpartum: RItem[] = [
          { icon: 'lochia', label: '恶露', url: '/pages/record/lochia' },
          { icon: 'heart', label: '情绪自评', url: '/pages/record/epds' },
          { icon: 'pill', label: '用药记录', url: '/pages/record/medication' },
          { icon: 'glucose', label: '饮水记录', url: '/pages/record/water' },
          { icon: 'weight', label: '体重', url: '/pages/record/weight' }
        ]
        const baby: RItem[] = [
          { icon: 'feeding', label: '喂养', url: '/pages/baby/feeding' },
          { icon: 'diaper', label: '尿布', url: '/pages/baby/diaper' },
          { icon: 'sleep', label: '睡眠', url: '/pages/baby/sleep' },
          { icon: 'growth', label: '成长', url: '/pages/baby/growth' },
          { icon: 'album', label: '相册', url: '/pages/baby/album' },
          { icon: 'bowl', label: '辅食计划', url: '/pages/tools/solid-food' },
          { icon: 'bowl', label: '辅食记录', url: '/pages/tools/solid-food-log' },
          { icon: 'pill', label: '用药记录', url: '/pages/record/medication' },
          { icon: 'vaccine', label: '疫苗', url: '/pages/baby/vaccines' }
        ]
        if (s == 'PRECONCEPTION') groups.push({ title: '备孕', items: orderByRecent(ttc) })
        if (s == 'T1' || s == 'T2' || s == 'T3') groups.push({ title: '孕期', items: orderByRecent(pregnancy) })
        if (s == 'POSTPARTUM' || s == 'RECOVERY' || s == 'PARENTING') {
          groups.push({ title: '产后恢复', items: orderByRecent(postpartum) })
          groups.push({ title: '宝宝', items: orderByRecent(baby) })
        }
        groups.push({ title: '产检', items: [{ icon: 'clinic', label: '产检中心', url: '/pages/care/schedule' }] })
        return groups
  })

  // 芯片颜色按 url 稳定哈希：颜色跟条目走，不随重排漂移（与首页同规则）
  function chipClass(url: string): string {
    let h = 0
    for (let i = 0; i < url.length; i++) { h = (h * 31 + url.charCodeAt(i)) % 997 }
    return 'grid-chip-' + (h % 5)
  }

  function go(url: string) {
    remember(url)
    uni.navigateTo({ url })
  }

  onPageReady(() => { loadRecent() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; }
  .group { background-color: var(--lb-card); border-radius: 36rpx; padding: 36rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 28rpx rgba(61,35,48,0.05); }
  .group-head { flex-direction: row; align-items: center; margin-bottom: 24rpx; }
  .title-bar { width: 8rpx; height: 30rpx; border-radius: 4rpx; background-image: linear-gradient(180deg, #F376A0, #D43770); margin-right: 14rpx; }
  .group-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); }
  .grid { flex-direction: row; flex-wrap: wrap; }
  .grid-item { width: 25%; align-items: center; padding: 16rpx 0; border-radius: 24rpx; transition: all 160ms ease-out; }
  .grid-chip { width: 92rpx; height: 92rpx; border-radius: 30rpx; align-items: center; justify-content: center; }
  .grid-chip-0 { background-image: linear-gradient(160deg, #FDEDF3, #F9D6E4); }
  .grid-chip-1 { background-image: linear-gradient(160deg, #F1EEFE, #E1DBFA); }
  .grid-chip-2 { background-image: linear-gradient(160deg, #E6F7F0, #D0EFE2); }
  .grid-chip-3 { background-image: linear-gradient(160deg, #FDF3E0, #FAE5C6); }
  .grid-chip-4 { background-image: linear-gradient(160deg, #FFF0E8, #FEDFD0); }
  .grid-icon { width: 52rpx; height: 52rpx; }
  .grid-label { font-size: 24rpx; color: var(--lb-text-2); margin-top: 12rpx; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
