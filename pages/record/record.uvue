<template>
  <view class="page" :class="themeClass()">
    <view class="group lb-rise" v-for="(g, gi) in groups" :key="gi">
      <text class="group-title">{{ g.title }}</text>
      <view class="grid">
        <view class="grid-item" v-for="(item, i) in g.items" :key="i" hover-class="lb-press" hover-stay-time="120" @click="go(item.url)">
          <view class="grid-chip" :class="'grid-chip-' + (i % 5)">
            <text class="grid-icon">{{ item.icon }}</text>
          </view>
          <text class="grid-label">{{ item.label }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed } from 'vue'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type RItem = { icon: string, label: string, url: string }
  type RGroup = { title: string, items: RItem[] }

  const groups = computed((): RGroup[] => {
        const s = journeyState.stage
        const groups: RGroup[] = []
        const ttc: RItem[] = [
          { icon: '🌸', label: '经期', url: '/pages/record/cycle' },
          { icon: '🧪', label: '排卵试纸', url: '/pages/record/ovulation-test' },
          { icon: '🌡', label: '基础体温', url: '/pages/record/cycle' },
          { icon: '🤰', label: '验孕', url: '/pages/record/pregnancy-test' },
          { icon: '💗', label: '同房(隐私)', url: '/pages/record/cycle' }
        ]
        const pregnancy: RItem[] = [
          { icon: '⚖️', label: '体重', url: '/pages/record/weight' },
          { icon: '🩺', label: '血压', url: '/pages/record/blood-pressure' },
          { icon: '🩸', label: '血糖', url: '/pages/record/blood-glucose' },
          { icon: '🦶', label: '胎动', url: '/pages/record/fetal-movement' },
          { icon: '⏱', label: '宫缩计时', url: '/pages/record/contraction-timer' },
          { icon: '🌸', label: '症状情绪', url: '/pages/record/symptom' },
          { icon: '📔', label: '日记', url: '/pages/record/diary' }
        ]
        const postpartum: RItem[] = [
          { icon: '🩸', label: '恶露', url: '/pages/record/lochia' },
          { icon: '💗', label: '情绪自评', url: '/pages/record/epds' },
          { icon: '⚖️', label: '体重', url: '/pages/record/weight' }
        ]
        const baby: RItem[] = [
          { icon: '🍼', label: '喂养', url: '/pages/baby/feeding' },
          { icon: '🧷', label: '尿布', url: '/pages/baby/diaper' },
          { icon: '😴', label: '睡眠', url: '/pages/baby/sleep' },
          { icon: '📏', label: '成长', url: '/pages/baby/growth' },
          { icon: '💉', label: '疫苗', url: '/pages/baby/vaccines' }
        ]
        if (s == 'PRECONCEPTION') groups.push({ title: '备孕', items: ttc })
        if (s == 'T1' || s == 'T2' || s == 'T3') groups.push({ title: '孕期', items: pregnancy })
        if (s == 'POSTPARTUM' || s == 'RECOVERY' || s == 'PARENTING') {
          groups.push({ title: '产后恢复', items: postpartum })
          groups.push({ title: '宝宝', items: baby })
        }
        groups.push({ title: '产检', items: [{ icon: '🏥', label: '产检中心', url: '/pages/care/schedule' }] })
        return groups
  })

  function go(url: string) { uni.navigateTo({ url }) }
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; }
  .group { background-color: var(--lb-card); border-radius: 36rpx; padding: 36rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .group-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 24rpx; }
  .grid { flex-direction: row; flex-wrap: wrap; }
  .grid-item { width: 25%; align-items: center; padding: 16rpx 0; border-radius: 24rpx; transition: all 160ms ease-out; }
  .grid-chip { width: 84rpx; height: 84rpx; border-radius: 24rpx; align-items: center; justify-content: center; }
  .grid-chip-0 { background-color: var(--lb-primary-soft); }
  .grid-chip-1 { background-color: var(--lb-secondary-soft); }
  .grid-chip-2 { background-color: var(--lb-success-soft); }
  .grid-chip-3 { background-color: var(--lb-warning-soft); }
  .grid-chip-4 { background-color: var(--lb-chip-5); }
  .grid-icon { font-size: 40rpx; }
  .grid-label { font-size: 22rpx; color: var(--lb-text-2); margin-top: 12rpx; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
