<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise" v-if="!counting">
      <text class="label">选择计数方式</text>
      <view class="opts">
        <view class="opt" :class="mode == 'count' ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="mode = 'count'">
          <text class="opt-text" :class="mode == 'count' ? 'opt-text-active' : ''">🦶 数到 10 次</text>
        </view>
        <view class="opt" :class="mode == 'timed' ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="mode = 'timed'">
          <text class="opt-text" :class="mode == 'timed' ? 'opt-text-active' : ''">⏰ 定时 1 小时</text>
        </view>
      </view>
      <text class="hint" v-if="mode == 'count'">记录感受 10 次胎动所需的时间，建议每天固定时段</text>
      <text class="hint" v-else>计时 1 小时，感受 1 次点一下</text>
      <button class="btn-save" @click="start">开始数胎动</button>
    </view>

    <view class="card lb-rise-1" v-else>
      <text class="count">{{ count }}</text>
      <text class="hint">{{ mode == 'count' ? '每感受到一次胎动点一下' : '已计时 ' + elapsedText }}</text>
      <view class="big-btn" hover-class="lb-press" hover-stay-time="120" @click="tap"><text class="big-btn-text">感到胎动了</text></view>
      <text class="elapsed" v-if="mode == 'count' && count > 0">用时 {{ elapsedText }}</text>
      <button class="btn-save btn-gray" @click="finish">完成并保存</button>
    </view>

    <view class="card lb-rise-2" v-if="today.length > 0">
      <text class="card-title">今天已记录</text>
      <view class="s-row" v-for="(s, i) in today" :key="i">
        <text class="s-time">{{ s.time }}</text>
        <text class="s-val">{{ s.count }} 次 · 用时 {{ s.dur }}</text>
      </view>
    </view>

    <lbc-redline v-if="alertText.length > 0" level="warn" :message="alertText" action="安静侧卧观察 1 小时，仍少请联系医生或就诊" />
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onUnload } from '@dcloudio/uni-app'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type SRow = { time: string, count: number, dur: string }

  let tickTimer = -1

  const mode = ref('count')
  const counting = ref(false)
  const count = ref(0)
  const startedAt = ref(0)
  const now = ref(0)
  const saving = ref(false)
  const today = ref<SRow[]>([])
  const alertText = ref('')

  const elapsedText = computed((): string => {
    const s = Math.floor((now.value - startedAt.value) / 1000)
    return `${Math.floor(s / 60)} 分 ${s % 60} 秒`
  })

  async function load() {
    try {
      const res = await luckyRecord('listMetrics', { journeyId: journeyState.journeyId, code: 'fetal_movement', limit: 10 } as UTSJSONObject)
      const arr = res.getArray<UTSJSONObject>('records') ?? []
      const rows: SRow[] = []
      for (let i = 0; i < arr.length; i++) {
        const m = arr[i] as UTSJSONObject
        const v = m.getJSON('value') as UTSJSONObject | null
        rows.push({
          time: new Date(m.getNumber('ts') ?? 0).toISOString().slice(11, 16),
          count: (v?.getNumber('count') ?? 0).toInt(),
          dur: `${(v?.getNumber('durationMin') ?? 0).toInt()} 分钟`
        })
      }
      today.value = rows
    } catch (e) { /* 忽略 */ }
  }

  function start() {
    count.value = 0
    startedAt.value = Date.now()
    now.value = startedAt.value
    counting.value = true
    tickTimer = setInterval(() => { now.value = Date.now() }, 1000)
  }

  function tap() { count.value += 1 }

  async function finish() {
    clearInterval(tickTimer)
    if (count.value == 0) { counting.value = false; return }
    const durMin = Math.max(1, Math.round((Date.now() - startedAt.value) / 60000))
    // 数到 10 次模式：若提前数满，durationMin 按实际用时；定时模式固定 60 分钟
    saving.value = true
    try {
      const res = await luckyRecord('addMetric', {
        journeyId: journeyState.journeyId, code: 'fetal_movement',
        value: { count: count.value, durationMin: durMin } as UTSJSONObject
      } as UTSJSONObject)
      counting.value = false
      // 明显低于近期均值提示（服务端趋势提醒的端上简化版）
      if (today.value.length >= 3) {
        const avg = today.value.reduce((a, b) => a + b.count, 0) / today.value.length
        if (count.value < avg * 0.5) {
          alertText.value = `今天这次（${count.value} 次）明显少于平时（约 ${Math.round(avg)} 次）`
        }
      }
      uni.showToast({ title: '已记录 ✓', icon: 'success' })
      load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }

  onPageReady(() => { load() })
  onUnload(() => { clearInterval(tickTimer) })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 28rpx; color: var(--lb-text-1); margin-bottom: 16rpx; }
  .opts { flex-direction: row; margin-bottom: 16rpx; }
  .opt { background-color: var(--lb-fill); border-radius: 24rpx; padding: 20rpx 40rpx; margin: 0 12rpx; transition: all 160ms ease-out; }
  .opt-active { background-color: var(--lb-primary-soft); }
  .opt-text { font-size: 28rpx; color: var(--lb-text-1); }
  .opt-text-active { color: var(--lb-primary-deep); font-weight: bold; }
  .hint { font-size: 22rpx; color: var(--lb-text-3); margin: 8rpx 0 24rpx 0; text-align: center; }
  .btn-save { width: 620rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 8rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .btn-gray { background-color: var(--lb-fill); color: var(--lb-text-2); box-shadow: none; }
  .count { font-size: 120rpx; font-weight: bold; color: var(--lb-primary); }
  .big-btn { width: 320rpx; height: 320rpx; border-radius: 160rpx; background-image: linear-gradient(135deg, #F0709D, #DC3D75); align-items: center; justify-content: center; margin: 32rpx 0; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); transition: all 160ms ease-out; }
  .big-btn-text { font-size: 36rpx; font-weight: bold; color: #FFFFFF; text-align: center; }
  .elapsed { font-size: 24rpx; color: var(--lb-text-2); margin-bottom: 24rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 16rpx; align-self: flex-start; }
  .s-row { flex-direction: row; padding: 10rpx 0; align-self: stretch; }
  .s-time { width: 140rpx; font-size: 24rpx; color: var(--lb-text-3); }
  .s-val { font-size: 26rpx; color: var(--lb-text-1); }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
