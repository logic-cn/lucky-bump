<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">记录用药</text></view>

      <view class="opt-wrap" v-if="babies.length > 0">
        <view class="opt" :class="babyId == '' ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="babyId = ''">
          <text class="opt-text" :class="babyId == '' ? 'opt-text-active' : ''">我自己</text>
        </view>
        <view class="opt" v-for="(b, i) in babies" :key="i" :class="babyId == b.getString('_id') ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="pickBaby(b)">
          <text class="opt-text" :class="babyId == b.getString('_id') ? 'opt-text-active' : ''">{{ b.getString('nickname') }}</text>
        </view>
      </view>

      <text class="label">药名</text>
      <input class="input" v-model="name" placeholder="如：对乙酰氨基酚" placeholder-class="ph" />
      <text class="label">剂量（按说明书 / 医嘱填写）</text>
      <input class="input" v-model="dose" placeholder="如：0.5 片 / 5ml" placeholder-class="ph" confirm-type="done" @confirm="save" />
      <text class="label">备注（选填）</text>
      <input class="input" v-model="note" placeholder="如：发热 38.6℃ 时服用" placeholder-class="ph" confirm-type="done" @confirm="save" />

      <button class="btn-save" hover-class="lb-press" hover-stay-time="120" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存记录' }}</button>
      <text class="hint">{{ disclaimer }}</text>
    </view>

    <lbc-error v-if="loadFailed" :message="errorMsg" @retry="load" />

    <view class="card lb-rise-1" v-if="!loadFailed && logs.length > 0">
      <view class="card-head"><view class="title-bar" /><text class="card-title card-title-flush">最近用药</text></view>
      <view class="log-row" v-for="(l, i) in logs" :key="i">
        <view class="log-body">
          <view class="log-head">
            <text class="log-name">{{ l.getString('name') }}</text>
            <text class="log-tag" v-if="(l.getString('babyId') ?? '').length > 0">宝宝</text>
          </view>
          <text class="log-sub">{{ l.getString('date') }} · {{ l.getString('dose') }}{{ (l.getString('note') ?? '').length > 0 ? ' · ' + l.getString('note') : '' }}</text>
        </view>
      </view>
    </view>

    <view class="card lb-rise-2" v-if="!loadFailed && logs.length == 0">
      <text class="empty-text">还没有用药记录。记录只为就诊时回溯，本应用不提供剂量建议。</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyBaby, luckyJourney } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const name = ref<string>('')
  const dose = ref<string>('')
  const note = ref<string>('')
  const babyId = ref<string>('')
  const babies = ref<UTSJSONObject[]>([])
  const logs = ref<UTSJSONObject[]>([])
  const saving = ref<boolean>(false)
  const loadFailed = ref<boolean>(false)
  const errorMsg = ref<string>('')
  const disclaimer = ref<string>('本应用不做剂量建议，请以说明书与医嘱为准')

  function pickBaby(b: UTSJSONObject) {
    babyId.value = b.getString('_id') ?? ''
  }

  async function load() {
    try {
      const jr = await luckyJourney('listBabies', { journeyId: journeyState.journeyId } as UTSJSONObject)
      babies.value = jr.getArray<UTSJSONObject>('babies') ?? []
      const r = await luckyBaby('listMedications', { journeyId: journeyState.journeyId } as UTSJSONObject)
      logs.value = r.getArray<UTSJSONObject>('logs') ?? []
      loadFailed.value = false
    } catch (e) {
      loadFailed.value = true
      errorMsg.value = (e as Error).message
    }
  }

  async function save() {
    if (saving.value) return
    const n = name.value.trim()
    if (n.length == 0) {
      uni.showToast({ title: '先填写药名', icon: 'none' })
      return
    }
    saving.value = true
    try {
      const r = await luckyBaby('addMedication', {
        journeyId: journeyState.journeyId, babyId: babyId.value, name: n,
        dose: dose.value.trim(), note: note.value.trim()
      } as UTSJSONObject)
      disclaimer.value = r.getString('disclaimer') ?? disclaimer.value
      name.value = ''
      dose.value = ''
      note.value = ''
      uni.showToast({ title: '已记录', icon: 'none' })
      await load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally {
      saving.value = false
    }
  }

  onPageReady(() => { load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 36rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-head { flex-direction: row; align-items: center; margin-bottom: 20rpx; }
  .title-bar { width: 8rpx; height: 30rpx; border-radius: 4rpx; background-image: linear-gradient(180deg, var(--lb-grad-1), var(--lb-grad-2)); margin-right: 14rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); }
  .card-title-flush { margin-bottom: 0; }
  .label { font-size: 26rpx; color: var(--lb-text-1); margin: 20rpx 0 10rpx 0; align-self: flex-start; }
  .input { width: 630rpx; height: 88rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--lb-text-1); }
  .ph { color: var(--lb-text-3); }
  .opt-wrap { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; }
  .opt { padding: 14rpx 28rpx; border-radius: 20rpx; background-color: var(--lb-fill); margin: 0 12rpx 12rpx 0; }
  .opt-active { background-color: var(--lb-primary-soft); }
  .opt-text { font-size: 26rpx; color: var(--lb-text-2); }
  .opt-text-active { color: var(--lb-primary-deep); font-weight: bold; }
  .btn-save { width: 630rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: var(--lb-white); font-size: 32rpx; border-radius: 48rpx; margin-top: 28rpx; transition: all 160ms ease-out; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); line-height: 38rpx; margin-top: 16rpx; }
  .log-row { flex-direction: row; align-items: center; padding: 20rpx 0; border-bottom-width: 1px; border-bottom-color: var(--lb-line); }
  .log-body { flex: 1; }
  .log-head { flex-direction: row; align-items: center; }
  .log-name { font-size: 28rpx; color: var(--lb-text-1); font-weight: bold; }
  .log-tag { font-size: 24rpx; color: var(--lb-primary-deep); background-color: var(--lb-primary-soft); border-radius: 10rpx; padding: 2rpx 10rpx; margin-left: 10rpx; }
  .log-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 4rpx; }
  .empty-text { font-size: 26rpx; color: var(--lb-text-3); line-height: 40rpx; }
  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
