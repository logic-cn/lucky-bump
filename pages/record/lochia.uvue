<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">恶露颜色</text>
      <view class="opts">
        <view class="opt" v-for="(o, i) in colors" :key="i" :class="color == o.value ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="color = o.value">
          <view class="color-dot" :style="{ backgroundColor: o.dot }" />
          <text class="opt-text" :class="color == o.value ? 'opt-text-active' : ''">{{ o.label }}</text>
        </view>
      </view>
      <text class="label">量（以卫生巾用量为参照）</text>
      <view class="opts">
        <view class="opt" v-for="(a, i) in amounts" :key="i" :class="amount == a.value ? 'opt-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="amount = a.value">
          <text class="opt-text" :class="amount == a.value ? 'opt-text-active' : ''">{{ a.label }}</text>
        </view>
      </view>
      <view class="switch-row">
        <text class="switch-label">有血块</text>
        <switch :checked="clots" @change="onClotsChange" color="#E4537F" />
      </view>
      <view class="switch-row">
        <text class="switch-label">有异味</text>
        <switch :checked="odor" @change="onOdorChange" color="#E4537F" />
      </view>
      <text class="hint">参考进程：血性 3-4 天 → 浆液约 10 天 → 白色持续 2-3 周；个体差异大，异常以医生判断为准</text>
    </view>
    <button class="btn-save lb-rise-1" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存' }}</button>

    <view class="redline lb-rise-2" v-if="redlineMsg.length > 0">
      <text class="redline-title">⚠️ 需要关注</text>
      <text class="redline-msg">{{ redlineMsg }}</text>
      <text class="redline-action">{{ redlineAction }}</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type COpt = { value: string, label: string, dot: string }
  type AOpt = { value: string, label: string }

  const color = ref<string>('dark_red')
  const amount = ref<string>('medium')
  const clots = ref<boolean>(false)
  const odor = ref<boolean>(false)
  const saving = ref<boolean>(false)
  const redlineMsg = ref<string>('')
  const redlineAction = ref<string>('')
  const colors = ref<COpt[]>([
    { value: 'bright_red', label: '鲜红', dot: '#E5484D' },
    { value: 'dark_red', label: '暗红', dot: '#B2353A' },
    { value: 'pink', label: '粉', dot: '#F2B7CB' },
    { value: 'white_brown', label: '白/褐', dot: '#D8CBD3' }
  ])
  const amounts = ref<AOpt[]>([
    { value: 'light', label: '少' }, { value: 'medium', label: '中' }, { value: 'heavy', label: '多' }
  ])

  function onClotsChange(e: UniSwitchChangeEvent) { clots.value = e.detail.value }
  function onOdorChange(e: UniSwitchChangeEvent) { odor.value = e.detail.value }
  async function save() {
    saving.value = true
    try {
      const res = await luckyRecord('addMetric', {
        journeyId: journeyState.journeyId, code: 'lochia',
        value: { color: color.value, amount: amount.value, clots: clots.value, odor: odor.value } as UTSJSONObject
      } as UTSJSONObject)
      const rl = res.getJSON('redline')
      if (rl != null) {
        const r = rl as UTSJSONObject
        redlineMsg.value = r.getString('message') ?? ''
        redlineAction.value = r.getString('action') ?? ''
      } else {
        uni.showToast({ title: '已记录 ✓', icon: 'success' })
        setTimeout(() => { uni.navigateBack() }, 600)
      }
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 40rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 28rpx; color: var(--lb-text-1); margin: 16rpx 0 20rpx 0; }
  .opts { flex-direction: row; justify-content: center; flex-wrap: wrap; }
  .opt { align-items: center; background-color: var(--lb-fill); border-radius: 24rpx; padding: 24rpx 32rpx; margin: 8rpx; flex-direction: row; transition: all 160ms ease-out; }
  .opt-active { background-color: var(--lb-primary-soft); }
  .color-dot { width: 28rpx; height: 28rpx; border-radius: 14rpx; margin-right: 12rpx; }
  .opt-text { font-size: 26rpx; color: var(--lb-text-1); }
  .opt-text-active { color: var(--lb-primary-deep); font-weight: bold; }
  .switch-row { flex-direction: row; align-items: center; justify-content: space-between; width: 620rpx; padding: 12rpx 0; }
  .switch-label { font-size: 28rpx; color: var(--lb-text-1); }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin-top: 24rpx; }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 40rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .redline { width: 702rpx; background-color: var(--lb-warning-soft); border-radius: 36rpx; padding: 40rpx; margin-top: 32rpx; }
  .redline-title { font-size: 34rpx; font-weight: bold; color: var(--lb-danger); }
  .redline-msg { font-size: 28rpx; color: var(--lb-text-1); margin-top: 16rpx; }
  .redline-action { font-size: 30rpx; font-weight: bold; color: var(--lb-danger); margin-top: 16rpx; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
