<template>
  <view class="page">
    <view class="hero">
      <text class="timer-text">{{ display }}</text>
      <text class="hint" v-if="!running && lastInterval.length > 0">上次间隔 {{ lastInterval }} · 上次时长 {{ lastDur }}</text>
      <text class="hint" v-else-if="!running">宫缩开始时按下按钮，结束时再按一次</text>
    </view>
    <view class="big-btn" :class="running ? 'big-btn-stop' : ''" @click="toggle">
      <text class="big-btn-text">{{ running ? '结束' : (startedAt > 0 ? '继续' : '开始') }}</text>
    </view>

    <view class="card" v-if="recent.length > 0">
      <text class="card-title">最近宫缩（间隔 / 时长）</text>
      <view class="row" v-for="(r, i) in recent" :key="i">
        <text class="row-time">{{ r.time }}</text>
        <text class="row-dur">{{ r.dur }}</text>
      </view>
    </view>

    <view class="redline" v-if="advice.length > 0">
      <text class="redline-title">⚠️ 宫缩提示</text>
      <text class="redline-msg">{{ advice }}</text>
      <text class="redline-note">破水时无论有无宫缩：立即平躺并前往医院</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed, ref } from 'vue'
  import { onLoad, onUnload } from '@dcloudio/uni-app'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'

  type Row = { time: string, dur: string, startedAt: number }

  let tickTimer = -1

  const running = ref(false)
  const startedAt = ref(0)
  const sessionId = ref('')
  const now = ref(0)
  const lastInterval = ref('')
  const lastDur = ref('')
  const recent = ref<Row[]>([])
  const advice = ref('')

  function fmt(s: number): string {
    const m = Math.floor(s / 60), sec = s % 60
    return `${m < 10 ? '0' + m : m}:${sec < 10 ? '0' + sec : sec}`
  }

  const display = computed((): string => {
    if (running.value) {
      const s = Math.floor((now.value - startedAt.value) / 1000)
      return fmt(s)
    }
    return '00:00'
  })

  function timeStr(ts: number): string {
    const d = new Date(ts)
    const hh = d.getHours() < 10 ? '0' + d.getHours() : '' + d.getHours()
    const mm = d.getMinutes() < 10 ? '0' + d.getMinutes() : '' + d.getMinutes()
    return `${hh}:${mm}`
  }

  async function load() {
    try {
      const res = await luckyRecord('listTrackers', { journeyId: journeyState.journeyId, type: 'contraction' } as UTSJSONObject)
      const arr = res.getArray<UTSJSONObject>('sessions') ?? []
      const rows: Row[] = []
      for (let i = 0; i < arr.length && i < 10; i++) {
        const s = arr[i] as UTSJSONObject
        const startedAtVal = (s.getNumber('started_at') ?? 0)
        const endedAt = (s.getNumber('ended_at') ?? 0)
        if (endedAt <= 0) continue
        let interval = ''
        if (i + 1 < arr.length) {
          const prev = (arr[i + 1] as UTSJSONObject).getNumber('started_at') ?? 0
          if (prev > 0) interval = `${Math.round((startedAtVal - prev) / 60000)} 分钟`
        }
        rows.push({ time: timeStr(startedAtVal), dur: fmt(Math.floor((endedAt - startedAtVal) / 1000)) + (interval.length > 0 ? ` · 间隔 ${interval}` : ''), startedAt: startedAtVal })
      }
      recent.value = rows
    } catch (e) { /* 忽略 */ }
  }

  async function toggle() {
    if (!running.value) {
      try {
        const res = await luckyRecord('startTracker', { journeyId: journeyState.journeyId, type: 'contraction' } as UTSJSONObject)
        sessionId.value = res.getString('sessionId') ?? ''
        startedAt.value = (res.getNumber('startedAt') ?? Date.now())
        running.value = true
        tickTimer = setInterval(() => { now.value = Date.now() }, 500)
      } catch (e) { uni.showToast({ title: (e as Error).message, icon: 'none' }) }
    } else {
      clearInterval(tickTimer)
      running.value = false
      try {
        await luckyRecord('stopTracker', { journeyId: journeyState.journeyId, sessionId: sessionId.value } as UTSJSONObject)
        lastDur.value = fmt(Math.floor((Date.now() - startedAt.value) / 1000))
        lastInterval.value = recent.value.length > 0 ? `${Math.round((startedAt.value - recent.value[0].startedAt) / 60000)} 分钟` : ''
        const adv = await luckyRecord('contractionAdvice', { journeyId: journeyState.journeyId } as UTSJSONObject)
        advice.value = adv.getBoolean('qualified') == true ? (adv.getString('message') ?? '') : ''
        load()
      } catch (e) { uni.showToast({ title: (e as Error).message, icon: 'none' }) }
    }
  }

  onLoad(() => { load() })
  onUnload(() => { if (running.value) clearInterval(tickTimer) })
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .hero { align-items: center; margin-top: 40rpx; }
  .timer-text { font-size: 96rpx; font-weight: bold; color: #1F2329; }
  .hint { font-size: 24rpx; color: #A3AAB5; margin-top: 16rpx; }
  .big-btn { width: 320rpx; height: 320rpx; border-radius: 160rpx; background-color: #FF7A6B; align-items: center; justify-content: center; margin: 40rpx 0; }
  .big-btn-stop { background-color: #E5484D; }
  .big-btn-text { font-size: 44rpx; font-weight: bold; color: #FFFFFF; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 32rpx; }
  .card-title { font-size: 28rpx; font-weight: bold; color: #1F2329; margin-bottom: 16rpx; }
  .row { flex-direction: row; padding: 12rpx 0; }
  .row-time { width: 160rpx; font-size: 26rpx; color: #A3AAB5; }
  .row-dur { font-size: 26rpx; color: #1F2329; }
  .redline { width: 700rpx; background-color: #FDECEC; border-radius: 24rpx; padding: 40rpx; margin-top: 24rpx; }
  .redline-title { font-size: 34rpx; font-weight: bold; color: #E5484D; }
  .redline-msg { font-size: 28rpx; color: #1F2329; margin-top: 16rpx; }
  .redline-note { font-size: 20rpx; color: #A3AAB5; margin-top: 24rpx; }
</style>
