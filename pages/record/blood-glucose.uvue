<template>
  <view class="page">
    <view class="card">
      <text class="label">测量时段</text>
      <view class="slots">
        <view class="slot" v-for="(s, i) in slots" :key="i" :class="slot == s.value ? 'slot-active' : ''" @click="slot = s.value">
          <text class="slot-text" :class="slot == s.value ? 'slot-text-active' : ''">{{ s.label }}</text>
        </view>
      </view>
      <text class="label">血糖值（mmol/L）</text>
      <view class="input-row">
        <input class="num-input" type="digit" v-model="mmol" placeholder="5.2" placeholder-class="ph" />
        <text class="unit">mmol/L</text>
      </view>
      <text class="hint">糖耐参考切点：空腹 ≥5.1 / 餐后1h ≥10.0 / 餐后2h ≥8.5，超出将提示与医生确认（不构成诊断）</text>
    </view>
    <button class="btn-save" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存' }}</button>

    <view class="redline" v-if="redlineMsg.length > 0">
      <text class="redline-title">⚠️ 需要关注</text>
      <text class="redline-msg">{{ redlineMsg }}</text>
      <text class="redline-action">{{ redlineAction }}</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'

  type Slot = { value: string, label: string }

  const slot = ref<string>('fasting')
  const slots = ref<Slot[]>([
    { value: 'fasting', label: '空腹' },
    { value: '1h', label: '餐后 1h' },
    { value: '2h', label: '餐后 2h' },
    { value: 'random', label: '随机' }
  ] as Slot[])
  const mmol = ref<string>('')
  const saving = ref<boolean>(false)
  const redlineMsg = ref<string>('')
  const redlineAction = ref<string>('')

  async function save() {
    const mmolVal = parseFloat(mmol.value)
    if (!(mmolVal >= 1 && mmolVal <= 35)) { uni.showToast({ title: '请输入有效血糖值', icon: 'none' }); return }
    saving.value = true
    try {
      const res = await luckyRecord('addMetric', { journeyId: journeyState.journeyId, code: 'blood_glucose', value: { slot: slot.value, mmol: mmolVal } } as UTSJSONObject)
      const rl = res.getJSON('redline')
      if (rl != null) {
        const r = rl as UTSJSONObject
        redlineMsg.value = r.getString('message') ?? ''
        redlineAction.value = r.getString('action') ?? ''
      } else {
        uni.showToast({ title: '已记录 ✓', icon: 'success' })
        setTimeout(() => { uni.navigateBack() }, 600)
      }
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 48rpx 40rpx; align-items: center; margin-top: 40rpx; }
  .label { font-size: 30rpx; color: #1F2329; margin-bottom: 24rpx; }
  .slots { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-bottom: 40rpx; }
  .slot { background-color: #F7F6F4; border-radius: 32rpx; padding: 16rpx 32rpx; margin: 8rpx; }
  .slot-active { background-color: #FFEFEA; }
  .slot-text { font-size: 26rpx; color: #6B7280; }
  .slot-text-active { color: #FF7A6B; font-weight: bold; }
  .input-row { flex-direction: row; align-items: center; }
  .num-input { width: 320rpx; height: 120rpx; font-size: 64rpx; font-weight: bold; color: #1F2329; text-align: center; border-bottom-width: 2px; border-bottom-color: #FF7A6B; }
  .unit { font-size: 26rpx; color: #A3AAB5; margin-left: 16rpx; }
  .ph { color: #E3E5E8; }
  .hint { font-size: 20rpx; color: #A3AAB5; margin-top: 32rpx; }
  .btn-save { width: 700rpx; height: 96rpx; line-height: 96rpx; background-color: #FF7A6B; color: #FFFFFF; font-size: 32rpx; border-radius: 44rpx; margin-top: 48rpx; }
  .redline { width: 700rpx; background-color: #FDF3E3; border-radius: 24rpx; padding: 40rpx; margin-top: 32rpx; }
  .redline-title { font-size: 34rpx; font-weight: bold; color: #E5484D; }
  .redline-msg { font-size: 28rpx; color: #1F2329; margin-top: 16rpx; }
  .redline-action { font-size: 30rpx; font-weight: bold; color: #E5484D; margin-top: 16rpx; }
</style>
