<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">身体信号（可多选）</text>
      <view class="chips">
        <view class="chip" v-for="(s, i) in symptoms" :key="i"
          :class="selected.indexOf(s.code) >= 0 ? (s.redline ? 'chip-danger-active' : 'chip-active') : ''"
          hover-class="lb-press" hover-stay-time="120" @click="toggle(s.code)">
          <text class="chip-text" :class="selected.indexOf(s.code) >= 0 ? 'chip-text-active' : ''">{{ s.label }}</text>
        </view>
      </view>
      <text class="label">严重程度</text>
      <view class="sev-row">
        <view class="sev" v-for="(s, i) in ['轻', '中', '重']" :key="i" :class="severity == i + 1 ? 'sev-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="severity = i + 1">
          <text class="sev-text">{{ s }}</text>
        </view>
      </view>
      <text class="label">备注（选填）</text>
      <textarea class="note" v-model="note" placeholder="什么时候明显、有没有缓解的办法…" placeholder-class="ph" :maxlength="200" />
    </view>
    <button class="btn-save lb-rise-1" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存' }}</button>

    <view class="redline lb-rise-2" v-if="redlineMsg.length > 0">
      <view class="redline-title-row"><image class="redline-ico" src="/static/icons/warn-danger.png" mode="aspectFit" /><text class="redline-title">请注意</text></view>
      <text class="redline-msg">{{ redlineMsg }}</text>
      <text class="redline-note">本提示仅描述现象与常规建议，不构成诊断</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type Sym = { code: string, label: string, redline: boolean }

  const symptoms = ref<Sym[]>([
    { code: 'nausea', label: '孕吐', redline: false },
    { code: 'fatigue', label: '乏力', redline: false },
    { code: 'edema', label: '水肿', redline: false },
    { code: 'insomnia', label: '失眠', redline: false },
    { code: 'backache', label: '腰痛', redline: false },
    { code: 'cramp', label: '腿抽筋', redline: false },
    { code: 'constipation', label: '便秘', redline: false },
    { code: 'heartburn', label: '烧心', redline: false },
    { code: 'dizzy', label: '头晕', redline: false },
    { code: 'low_mood', label: '情绪低落', redline: false },
    { code: 'bleeding', label: '出血', redline: true },
    { code: 'severe_pain', label: '剧烈腹痛', redline: true },
    { code: 'reduced_fm', label: '胎动明显减少', redline: true },
    { code: 'water_broke', label: '破水', redline: true },
    { code: 'severe_vomiting', label: '孕吐严重无法进食', redline: true }
  ] as Sym[])
  const selected = ref<string[]>([])
  const severity = ref<number>(1)
  const note = ref<string>('')
  const saving = ref<boolean>(false)
  const redlineMsg = ref<string>('')

  function toggle(code: string) {
    const idx = selected.value.indexOf(code)
    if (idx >= 0) selected.value.splice(idx, 1)
    else selected.value.push(code)
  }

  async function save() {
    if (selected.value.length == 0) { uni.showToast({ title: '至少选择一项', icon: 'none' }); return }
    saving.value = true
    try {
      const res = await luckyRecord('addMetric', {
        journeyId: journeyState.journeyId, code: 'symptom',
        value: { codes: selected.value, severity: severity.value, note: note.value } as UTSJSONObject
      } as UTSJSONObject)
      const rl = res.getJSON('redline')
      if (rl != null) {
        redlineMsg.value = (rl as UTSJSONObject).getString('message') ?? ''
      } else {
        uni.showToast({ title: '已记录 ✓', icon: 'success' })
        setTimeout(() => { uni.navigateBack() }, 600)
      }
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 40rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 28rpx; color: var(--lb-text-1); margin: 24rpx 0 16rpx 0; }
  .chips { flex-direction: row; flex-wrap: wrap; }
  .chip { background-color: var(--lb-fill); border-radius: 36rpx; padding: 14rpx 28rpx; margin: 8rpx; transition: all 160ms ease-out; }
  .chip-active { background-color: var(--lb-primary-soft); }
  .chip-danger-active { background-color: var(--lb-danger-soft); }
  .chip-text { font-size: 26rpx; color: var(--lb-text-2); }
  .chip-text-active { color: var(--lb-danger-text); font-weight: bold; }
  .sev-row { flex-direction: row; margin-bottom: 16rpx; }
  .sev { width: 120rpx; height: 72rpx; background-color: var(--lb-fill); border-radius: 24rpx; align-items: center; justify-content: center; margin-right: 16rpx; transition: all 160ms ease-out; }
  .sev-active { background-color: var(--lb-primary-soft); }
  .sev-text { font-size: 26rpx; color: var(--lb-text-2); }
  .note { width: 620rpx; height: 160rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 20rpx; font-size: 26rpx; color: var(--lb-text-1); }
  .ph { color: var(--lb-text-3); }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-action); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 48rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .redline { width: 702rpx; background-color: var(--lb-danger-soft); border-radius: 36rpx; padding: 40rpx; margin-top: 32rpx; }
  .redline-title-row { flex-direction: row; align-items: center; }
  .redline-ico { width: 36rpx; height: 36rpx; margin-right: 8rpx; }
  .redline-title { font-size: 34rpx; font-weight: bold; color: var(--lb-danger-text); }
  .redline-msg { font-size: 28rpx; color: var(--lb-text-1); margin-top: 16rpx; }
  .redline-note { font-size: 24rpx; color: var(--lb-text-3); margin-top: 24rpx; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
