<template>
  <view class="page" :class="themeClass()">
    <!-- 遗留会话提示（超 24h 不自动接续，交用户决定） -->
    <view class="stale lb-pop" v-if="staleVisible">
      <text class="stale-text">{{ staleInfo }}</text>
      <view class="stale-actions">
        <text class="stale-btn" @click="finishStale">结束并保存</text>
        <text class="stale-btn stale-btn-ghost" @click="discardStale">放弃这条</text>
      </view>
    </view>
    <view class="hero lb-rise">
      <text class="timer-text">{{ running ? display : '亲喂' }}</text>
      <text class="hint lb-pulse" v-if="running">当前：{{ side == 'left' ? '左侧' : '右侧' }} · 记得换边哦</text>
      <text class="hint" v-else>选择侧别开始计时，睡意朦胧也能 3 秒完成</text>
    </view>
    <view class="side-row lb-rise-1" v-if="!running">
      <view class="side-btn" hover-class="lb-press" hover-stay-time="120" @click="start('left')"><text class="side-text">左侧开始</text></view>
      <view class="side-btn" hover-class="lb-press" hover-stay-time="120" @click="start('right')"><text class="side-text">右侧开始</text></view>
    </view>
    <view class="big-btn lb-rise-1" v-if="running" hover-class="lb-press" hover-stay-time="120" @click="stop"><text class="big-btn-text">结束本次</text></view>

    <view class="card lb-rise-2" v-if="hint.length > 0">
      <text class="hint-strong">💡 {{ hint }}</text>
    </view>

    <view class="card lb-rise-3" v-if="recent.length > 0">
      <text class="card-title">最近亲喂</text>
      <view class="row" v-for="(r, i) in recent" :key="i">
        <text class="row-time">{{ r.time }}</text>
        <text class="row-dur">{{ r.sideText }} · {{ r.dur }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type Row = { time: string, dur: string, sideText: string }

  let tickTimer = -1

  const running = ref(false)
  const side = ref('')
  const sessionId = ref('')
  const startedAt = ref(0)
  const now = ref(0)
  const hint = ref('')
  const recent = ref<Row[]>([])
  const staleVisible = ref(false)
  const staleInfo = ref('')
  const staleSessionId = ref('')

  const STALE_MS = 24 * 3600 * 1000

  const display = computed((): string => {
    const s = Math.floor((now.value - startedAt.value) / 1000)
    const m = Math.floor(s / 60), sec = s % 60
    return `${m < 10 ? '0' + m : m}:${sec < 10 ? '0' + sec : sec}`
  })

  async function load() {
    try {
      const res = await luckyRecord('listTrackers', { journeyId: journeyState.journeyId, type: 'nursing' } as UTSJSONObject)
      const arr = res.getArray<UTSJSONObject>('sessions') ?? []
      const rows: Row[] = []
      for (let i = 0; i < arr.length && i < 8; i++) {
        const s = arr[i] as UTSJSONObject
        const startedAtVal = (s.getNumber('started_at') ?? 0)
        const endedAt = (s.getNumber('ended_at') ?? 0)
        if (endedAt <= 0) continue
        const sideVal = s.getString('side') ?? ''
        const sec = Math.floor((endedAt - startedAtVal) / 1000)
        rows.push({
          time: timeStr(startedAtVal),
          dur: `${Math.floor(sec / 60)} 分 ${sec % 60} 秒`,
          sideText: sideVal == 'left' ? '左侧' : (sideVal == 'right' ? '右侧' : '')
        })
      }
      recent.value = rows
    } catch (e) { /* 首次无数据 */ }
  }

  function timeStr(ts: number): string {
    const d = new Date(ts)
    const hh = d.getHours() < 10 ? '0' + d.getHours() : '' + d.getHours()
    const mm = d.getMinutes() < 10 ? '0' + d.getMinutes() : '' + d.getMinutes()
    return `${hh}:${mm}`
  }

  async function start(sideVal: string) {
    try {
      const res = await luckyRecord('startTracker', { journeyId: journeyState.journeyId, type: 'nursing', side: sideVal } as UTSJSONObject)
      sessionId.value = res.getString('sessionId') ?? ''
      startedAt.value = (res.getNumber('startedAt') ?? Date.now())
      side.value = sideVal
      running.value = true
      tickTimer = setInterval(() => { now.value = Date.now() }, 500)
    } catch (e) { uni.showToast({ title: (e as Error).message, icon: 'none' }) }
  }

  async function stop() {
    clearInterval(tickTimer)
    running.value = false
    try {
      const res = await luckyRecord('stopTracker', { journeyId: journeyState.journeyId, sessionId: sessionId.value } as UTSJSONObject)
      hint.value = res.getString('hint') ?? ''
      uni.showToast({ title: '已记录 ✓', icon: 'success' })
      load()
    } catch (e) { uni.showToast({ title: (e as Error).message, icon: 'none' }) }
  }

  /** 恢复未结束会话：服务端为准，避免锁屏/被杀后计时丢失（docs/03 M5）；亲喂需同时恢复侧别 */
  async function restoreActive() {
    if (running.value || staleVisible.value) return
    try {
      const res = await luckyRecord('listTrackers', { journeyId: journeyState.journeyId, type: 'nursing', activeOnly: true } as UTSJSONObject)
      const arr = res.getArray<UTSJSONObject>('sessions') ?? []
      if (arr.length == 0) return
      const s = arr[0] as UTSJSONObject
      const startedAtVal = s.getNumber('started_at') ?? 0
      const sessionIdVal = s.getString('_id') ?? ''
      if (startedAtVal <= 0 || sessionIdVal.length == 0) return
      const elapsed = Date.now() - startedAtVal
      if (elapsed > STALE_MS) {
        // 超 24 小时视为遗忘：不自动接续，交由用户决定
        staleSessionId.value = sessionIdVal
        staleInfo.value = `检测到未结束的亲喂计时（${Math.floor(elapsed / 3600000)} 小时前开始）`
        staleVisible.value = true
        return
      }
      startedAt.value = startedAtVal
      sessionId.value = sessionIdVal
      side.value = s.getString('side') ?? ''
      running.value = true
      now.value = Date.now()
      clearInterval(tickTimer)
      tickTimer = setInterval(() => { now.value = Date.now() }, 500)
    } catch (e) { /* 恢复失败不阻塞页面 */ }
  }

  async function finishStale() {
    try {
      await luckyRecord('stopTracker', { journeyId: journeyState.journeyId, sessionId: staleSessionId.value } as UTSJSONObject)
    } catch (e) { /* 已结束等情况忽略 */ }
    staleVisible.value = false
    load()
  }

  function discardStale() {
    staleVisible.value = false
    if (staleSessionId.value.length > 0) {
      luckyRecord('stopTracker', { journeyId: journeyState.journeyId, sessionId: staleSessionId.value } as UTSJSONObject).catch(() => {})
    }
  }

  onLoad(() => { load() })
  onShow(() => { restoreActive() })
  onUnload(() => { if (running.value) clearInterval(tickTimer) })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .hero { align-items: center; margin-top: 40rpx; }
  .timer-text { font-size: 96rpx; font-weight: bold; color: var(--lb-text-1); }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin-top: 16rpx; }
  .side-row { flex-direction: row; margin: 40rpx 0; }
  .side-btn { width: 280rpx; height: 280rpx; border-radius: 140rpx; background-image: linear-gradient(135deg, #F0709D, #DC3D75); align-items: center; justify-content: center; margin: 0 20rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); transition: all 160ms ease-out; }
  .side-text { font-size: 36rpx; font-weight: bold; color: #FFFFFF; }
  .big-btn { width: 320rpx; height: 320rpx; border-radius: 160rpx; background-color: var(--lb-danger); align-items: center; justify-content: center; margin: 40rpx 0; box-shadow: 0 12rpx 32rpx rgba(229,72,77,0.28); transition: all 160ms ease-out; }
  .big-btn-text { font-size: 40rpx; font-weight: bold; color: #FFFFFF; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 32rpx; margin-top: 16rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 16rpx; }
  .row { flex-direction: row; padding: 12rpx 0; }
  .row-time { width: 140rpx; font-size: 26rpx; color: var(--lb-text-3); }
  .row-dur { font-size: 26rpx; color: var(--lb-text-1); }
  .hint-strong { font-size: 26rpx; color: var(--lb-warning); }
  .stale { width: 702rpx; background-color: var(--lb-warning-soft); border-radius: 24rpx; padding: 28rpx 32rpx; margin-bottom: 24rpx; }
  .stale-text { font-size: 26rpx; color: var(--lb-text-1); }
  .stale-actions { flex-direction: row; margin-top: 20rpx; }
  .stale-btn { font-size: 26rpx; color: #FFFFFF; background-color: var(--lb-primary); border-radius: 32rpx; padding: 12rpx 28rpx; margin-right: 20rpx; }
  .stale-btn-ghost { color: var(--lb-text-2); background-color: var(--lb-fill); }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
