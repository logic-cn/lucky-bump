<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">血压（mmHg）</text>
      <view class="bp-row">
        <view class="bp-col">
          <input class="bp-input" type="number" v-model="sbp" placeholder="120" placeholder-class="ph" />
          <text class="bp-cap">收缩压</text>
        </view>
        <text class="bp-slash">/</text>
        <view class="bp-col">
          <input class="bp-input" type="number" v-model="dbp" placeholder="80" placeholder-class="ph" />
          <text class="bp-cap">舒张压</text>
        </view>
      </view>
      <input class="hr-input" type="number" v-model="hr" placeholder="心率（选填），如 72" placeholder-class="ph" />
    </view>
    <button class="btn-save lb-rise-1" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存' }}</button>

    <view class="redline lb-rise-2" v-if="redlineLevel.length > 0" :class="redlineLevel == 'critical' ? 'redline-critical' : 'redline-warn'">
      <text class="redline-title">{{ redlineLevel == 'critical' ? '⚠️ 请立即就医' : '⚠️ 需要关注' }}</text>
      <text class="redline-msg">{{ redlineMsg }}</text>
      <text class="redline-action">{{ redlineAction }}</text>
      <text class="redline-note">本提示仅描述测量现象，不构成诊断</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const sbp = ref<string>('')
  const dbp = ref<string>('')
  const hr = ref<string>('')
  const saving = ref<boolean>(false)
  const redlineLevel = ref<string>('')
  const redlineMsg = ref<string>('')
  const redlineAction = ref<string>('')

  async function save() {
    const sbpVal = parseInt(sbp.value)
    const dbpVal = parseInt(dbp.value)
    if (!(sbpVal >= 60 && sbpVal <= 260) || !(dbpVal >= 30 && dbpVal <= 160)) {
      uni.showToast({ title: '请输入有效血压值', icon: 'none' }); return
    }
    const value = { sbp: sbpVal, dbp: dbpVal } as UTSJSONObject
    const hrVal = parseInt(hr.value)
    if (hrVal >= 30 && hrVal <= 220) value['hr'] = hrVal
    saving.value = true
    try {
      const res = await luckyRecord('addMetric', { journeyId: journeyState.journeyId, code: 'blood_pressure', value } as UTSJSONObject)
      const rl = res.getJSON('redline')
      if (rl != null) {
        const r = rl as UTSJSONObject
        redlineLevel.value = r.getString('level') ?? ''
        redlineMsg.value = r.getString('message') ?? ''
        redlineAction.value = r.getString('action') ?? ''
      } else {
        uni.showToast({ title: '已记录 ✓', icon: 'success' })
        setTimeout(() => { uni.navigateBack() }, 600)
      }
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 48rpx 40rpx; align-items: center; margin-top: 40rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 30rpx; color: var(--lb-text-1); margin-bottom: 40rpx; }
  .bp-row { flex-direction: row; align-items: flex-end; }
  .bp-col { align-items: center; }
  .bp-input { width: 200rpx; height: 140rpx; font-size: 88rpx; font-weight: bold; color: var(--lb-text-1); text-align: center; border-bottom-width: 2px; border-bottom-color: var(--lb-primary); }
  .bp-cap { font-size: 22rpx; color: var(--lb-text-3); margin-top: 12rpx; }
  .bp-slash { font-size: 56rpx; color: var(--lb-arrow); margin: 0 24rpx 40rpx 24rpx; }
  .ph { color: var(--lb-text-3); }
  .hr-input { width: 500rpx; height: 80rpx; font-size: 28rpx; color: var(--lb-text-1); text-align: center; background-color: var(--lb-fill); border-radius: 24rpx; margin-top: 40rpx; }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 48rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .redline { width: 702rpx; border-radius: 36rpx; padding: 40rpx; margin-top: 32rpx; }
  .redline-critical { background-color: var(--lb-danger-soft); }
  .redline-warn { background-color: var(--lb-warning-soft); }
  .redline-title { font-size: 34rpx; font-weight: bold; color: var(--lb-danger); }
  .redline-msg { font-size: 28rpx; color: var(--lb-text-1); margin-top: 16rpx; }
  .redline-action { font-size: 30rpx; font-weight: bold; color: var(--lb-danger); margin-top: 16rpx; }
  .redline-note { font-size: 24rpx; color: var(--lb-text-3); margin-top: 24rpx; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
