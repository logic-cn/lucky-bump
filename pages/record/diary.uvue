<template>
  <view class="page">
    <view class="card">
      <text class="label">今天想记录点什么</text>
      <textarea class="ta" v-model="text" placeholder="今天宝宝胎动很活跃…（支持纯文字，照片能力随 V1.1 上线）" placeholder-class="ph" :maxlength="2000" />
      <text class="label">此刻心情</text>
      <view class="mood-row">
        <text class="mood" v-for="(m, i) in moods" :key="i" :class="mood == m.value ? 'mood-active' : ''" @click="mood = m.value">{{ m.emoji }}</text>
      </view>
    </view>
    <button class="btn-save" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存这条日记' }}</button>

    <view class="list" v-if="diaries.length > 0">
      <text class="list-title">过去的记录</text>
      <view class="diary" v-for="(d, i) in diaries" :key="i">
        <text class="diary-date">{{ d.getString('date') ?? '' }} · {{ moodEmoji(d.getString('mood') ?? 'normal') }}</text>
        <text class="diary-text">{{ d.getString('text') ?? '' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onLoad } from '@dcloudio/uni-app'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'

  type Mood = { value: string, emoji: string }

  const text = ref<string>('')
  const mood = ref<string>('normal')
  const saving = ref<boolean>(false)
  const diaries = ref<UTSJSONObject[]>([])
  const moods = ref<Mood[]>([
    { value: 'great', emoji: '🥰' }, { value: 'good', emoji: '😊' },
    { value: 'normal', emoji: '🙂' }, { value: 'low', emoji: '😔' }, { value: 'bad', emoji: '😢' }
  ] as Mood[])

  function moodEmoji(m: string): string {
    for (let i = 0; i < moods.value.length; i++) { if (moods.value[i].value == m) return moods.value[i].emoji }
    return '🙂'
  }

  async function load() {
    try {
      const res = await luckyRecord('listDiaries', { journeyId: journeyState.journeyId } as UTSJSONObject)
      diaries.value = res.getArray<UTSJSONObject>('diaries') ?? []
    } catch (e) { /* 首次无数据 */ }
  }

  async function save() {
    if (text.value.trim().length == 0) { uni.showToast({ title: '写点什么吧', icon: 'none' }); return }
    saving.value = true
    try {
      await luckyRecord('addDiary', { journeyId: journeyState.journeyId, text: text.value, mood: mood.value } as UTSJSONObject)
      text.value = ''
      uni.showToast({ title: '已保存 ✓', icon: 'success' })
      load()
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { saving.value = false }
  }

  onLoad(() => { load() })
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 40rpx; margin-top: 40rpx; }
  .label { font-size: 28rpx; color: #1F2329; margin: 16rpx 0 16rpx 0; }
  .ta { width: 620rpx; height: 240rpx; background-color: #F7F6F4; border-radius: 16rpx; padding: 24rpx; font-size: 28rpx; color: #1F2329; }
  .ph { color: #A3AAB5; }
  .mood-row { flex-direction: row; justify-content: space-between; }
  .mood { font-size: 48rpx; padding: 8rpx; }
  .mood-active { background-color: #FFEFEA; border-radius: 16rpx; }
  .btn-save { width: 700rpx; height: 96rpx; line-height: 96rpx; background-color: #FF7A6B; color: #FFFFFF; font-size: 32rpx; border-radius: 44rpx; margin-top: 32rpx; }
  .list { width: 700rpx; margin-top: 40rpx; }
  .list-title { font-size: 28rpx; font-weight: bold; color: #1F2329; margin-bottom: 16rpx; }
  .diary { background-color: #FFFFFF; border-radius: 24rpx; padding: 32rpx; margin-bottom: 16rpx; }
  .diary-date { font-size: 22rpx; color: #A3AAB5; }
  .diary-text { font-size: 28rpx; color: #1F2329; margin-top: 12rpx; }
</style>
