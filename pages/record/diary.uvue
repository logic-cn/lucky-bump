<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise">
      <text class="label">今天想记录点什么</text>
      <textarea class="ta" v-model="text" placeholder="今天宝宝胎动很活跃…" placeholder-class="ph" :maxlength="2000" />
      <text class="label">照片（最多 9 张）</text>
      <view class="photo-row">
        <view class="photo" v-for="(p, i) in previews" :key="i">
          <image class="photo-img" :src="p" mode="aspectFill" />
          <text class="photo-del" @click="removePhoto(i)">✕</text>
        </view>
        <view class="photo photo-add" v-if="previews.length < 9" hover-class="lb-press" hover-stay-time="120" @click="choosePhoto">
          <text class="photo-add-text">{{ uploading ? '…' : '＋' }}</text>
        </view>
      </view>
      <text class="label">此刻心情</text>
      <view class="mood-row">
        <view class="mood-item" v-for="(m, i) in moods" :key="i" hover-class="lb-press" hover-stay-time="120">
          <text class="mood" :class="mood == m.value ? 'mood-active' : ''" @click="mood = m.value">{{ m.emoji }}</text>
        </view>
      </view>
    </view>
    <button class="btn-save lb-rise-1" :disabled="saving" @click="save">{{ saving ? '保存中…' : '保存这条日记' }}</button>

    <view class="list lb-rise-2" v-if="diaries.length > 0">
      <text class="list-title">过去的记录</text>
      <view class="diary" v-for="(d, i) in diaries" :key="i">
        <text class="diary-date">{{ d.getString('date') ?? '' }} · {{ moodEmoji(d.getString('mood') ?? 'normal') }}</text>
        <text class="diary-text">{{ d.getString('text') ?? '' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'
  import { track } from '../../utils/track.uts'
  import { newClientId, isNetworkError, enqueueRecord } from '../../utils/offlineQueue.uts'

  type Mood = { value: string, emoji: string }

  const text = ref<string>('')
  const mood = ref<string>('normal')
  const saving = ref<boolean>(false)
  const diaries = ref<UTSJSONObject[]>([])
  const mediaIds = ref<string[]>([])
  const previews = ref<string[]>([])
  const uploading = ref<boolean>(false)
  const moods = ref<Mood[]>([
    { value: 'great', emoji: '🥰' }, { value: 'good', emoji: '😊' },
    { value: 'normal', emoji: '🙂' }, { value: 'low', emoji: '😔' }, { value: 'bad', emoji: '😢' }
  ] as Mood[])

  function moodEmoji(m: string): string {
    for (let i = 0; i < moods.value.length; i++) { if (moods.value[i].value == m) return moods.value[i].emoji }
    return '🙂'
  }

  /** 日记照片：选择 → 上传 uniCloud 存储 → 记录 fileID（列表用本地临时路径预览） */
  function choosePhoto() {
    uni.chooseImage({
      count: 9 - previews.value.length,
      success: async (res) => {
        const paths = res.tempFilePaths
        uploading.value = true
        try {
          for (let i = 0; i < paths.length; i++) {
            const cloudPath = `diaries/${journeyState.journeyId}/${Date.now()}_${i}.jpg`
            const up = await uploadOne(paths[i], cloudPath)
            mediaIds.value.push(up)
            previews.value.push(paths[i])
          }
        } catch (e) {
          uni.showToast({ title: (e as Error).message, icon: 'none' })
        } finally { uploading.value = false }
      }
    })
  }
  function uploadOne(filePath: string, cloudPath: string): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      uniCloud.uploadFile({
        filePath: filePath,
        cloudPath: cloudPath,
        success: (res) => { resolve(res.fileID) },
        fail: (err) => { reject(new Error(err.errMsg ?? '上传失败')) }
      } as UploadFileOptions)
    })
  }
  function removePhoto(i: number) {
    mediaIds.value.splice(i, 1)
    previews.value.splice(i, 1)
  }

  async function load() {
    try {
      const res = await luckyRecord('listDiaries', { journeyId: journeyState.journeyId } as UTSJSONObject)
      diaries.value = res.getArray<UTSJSONObject>('diaries') ?? []
    } catch (e) { /* 首次无数据 */ }
  }

  async function save() {
    if (text.value.trim().length == 0) { uni.showToast({ title: '写点什么吧', icon: 'none' }); return }
    saving.value = true
    const cid = newClientId()
    const params = {
      journeyId: journeyState.journeyId, text: text.value, mood: mood.value, mediaIds: mediaIds.value, clientId: cid
    } as UTSJSONObject
    let queued = false
    try {
      await luckyRecord('addDiary', params)
      track('record_create', { type: 'diary' } as UTSJSONObject)
    } catch (e) {
      const msg = (e as Error).message
      if (!isNetworkError(msg)) {
        uni.showToast({ title: msg, icon: 'none' })
        saving.value = false
        return
      }
      queued = true
      enqueueRecord('addDiary', params, cid)
    }
    uni.setStorageSync('lb_has_record', true)
    text.value = ''
    mediaIds.value = []
    previews.value = []
    uni.showToast({ title: queued ? '网络不佳，已离线保存，联网后自动同步' : '已保存 ✓', icon: 'none' })
    saving.value = false
    if (!queued) load()
  }

  onPageReady(() => { load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 40rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .label { font-size: 28rpx; color: var(--lb-text-1); margin: 16rpx 0 16rpx 0; }
  .ta { width: 620rpx; height: 240rpx; background-color: var(--lb-fill); border-radius: 24rpx; padding: 24rpx; font-size: 28rpx; color: var(--lb-text-1); }
  .ph { color: var(--lb-text-3); }
  .mood-row { flex-direction: row; justify-content: space-between; }
  .mood-item { transition: all 160ms ease-out; }
  .mood { font-size: 48rpx; padding: 8rpx; transition: all 160ms ease-out; }
  .mood-active { background-color: var(--lb-primary-soft); border-radius: 24rpx; }
  .photo-row { flex-direction: row; flex-wrap: wrap; }
  .photo { width: 140rpx; height: 140rpx; border-radius: 20rpx; margin: 0 12rpx 12rpx 0; }
  .photo-img { width: 140rpx; height: 140rpx; border-radius: 20rpx; }
  .photo-del { position: absolute; top: 4rpx; right: 10rpx; font-size: 28rpx; color: #FFFFFF; background-color: rgba(0,0,0,0.45); border-radius: 20rpx; padding: 0 8rpx; }
  .photo-add { background-color: var(--lb-fill); align-items: center; justify-content: center; }
  .photo-add-text { font-size: 48rpx; color: var(--lb-text-3); }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-primary); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 32rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .list { width: 702rpx; margin-top: 40rpx; }
  .list-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 16rpx; }
  .diary { background-color: var(--lb-card); border-radius: 36rpx; padding: 32rpx; margin-bottom: 16rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .diary-date { font-size: 24rpx; color: var(--lb-text-3); }
  .diary-text { font-size: 28rpx; color: var(--lb-text-1); margin-top: 12rpx; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
