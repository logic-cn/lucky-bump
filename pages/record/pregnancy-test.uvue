<template>
  <view class="page">
    <view class="card" v-if="step == 0">
      <text class="label">今天的验孕结果</text>
      <view class="opts">
        <view class="opt" v-for="(o, i) in opts" :key="i" :class="result == o.value ? 'opt-active' : ''" @click="result = o.value">
          <text class="opt-emoji">{{ o.emoji }}</text>
          <text class="opt-text" :class="result == o.value ? 'opt-text-active' : ''">{{ o.label }}</text>
        </view>
      </view>
      <text class="hint" v-if="result == 'faint'">一深一浅可能是怀孕早期，建议 2-3 天后用晨尿复测</text>
      <button class="btn-save" :disabled="saving || result.length == 0" @click="save">{{ saving ? '保存中…' : '保存' }}</button>
    </view>

    <!-- 好孕确认仪式（docs/02 §4.4 / docs/03 M1.7） -->
    <view class="card" v-if="step == 1">
      <text class="celebrate">🎉</text>
      <text class="celebrate-title">恭喜！要先确认好孕吗？</text>
      <text class="hint">确认后你的备孕记录会无缝带孕展示，还能邀请宝宝爸爸一起记录</text>
      <text class="label">末次月经第一天</text>
      <picker mode="date" :value="lmp" @change="onLmpChange">
        <view class="date-box"><text class="date-text">{{ lmp == '' ? '选择日期' : lmp }}</text></view>
      </picker>
      <button class="btn-save" :disabled="saving" @click="confirmPregnancy">{{ saving ? '确认中…' : '确认好孕，开始孕期模式' }}</button>
      <text class="link" @click="uni.navigateBack()">稍后再说</text>
    </view>

    <view class="card" v-if="step == 2">
      <text class="celebrate-title">已进入孕期模式 🌸</text>
      <text class="hint">现在你处于 {{ stageText }}，去首页看看宝宝本周有多大吧</text>
      <button class="btn-save" @click="goHome">回到首页</button>
    </view>
  </view>
</template>

<script>
  import { luckyRecord, luckyJourney } from '../../utils/request.uts'
  import { journeyState, applyJourney, stageText } from '../../store/journeyStore.uts'

  export default {
    data() {
      return {
        result: '', step: 0, lmp: '', saving: false,
        opts: [
          { value: 'negative', label: '一道杠', emoji: '⚪' },
          { value: 'faint', label: '一深一浅', emoji: '🌓' },
          { value: 'positive', label: '两道杠', emoji: '🎉' }
        ] as Opt[]
      }
    },
    methods: {
      onLmpChange(e: UniPickerChangeEvent) { this.lmp = (e.detail.value as string) ?? '' },
      async save() {
        this.saving = true
        try {
          const res = await luckyRecord('addCycleEvent', { journeyId: journeyState.journeyId, type: 'pregnancy_test', value: { result: this.result } } as UTSJSONObject)
          if (res.getBoolean('pregnancyPositive') == true) {
            this.step = 1
          } else {
            uni.showToast({ title: '已记录 ✓', icon: 'success' })
            setTimeout(() => { uni.navigateBack() }, 600)
          }
        } catch (e) {
          uni.showToast({ title: (e as Error).message, icon: 'none' })
        } finally { this.saving = false }
      },
      async confirmPregnancy() {
        if (this.lmp.length == 0) { uni.showToast({ title: '请选择末次月经日期', icon: 'none' }); return }
        this.saving = true
        try {
          const res = await luckyJourney('confirmPregnancy', { journeyId: journeyState.journeyId, eddSource: 'lmp', lmpDate: this.lmp } as UTSJSONObject)
          const view = res.getJSON('view')
          if (view != null) applyJourney(view as UTSJSONObject)
          this.step = 2
        } catch (e) {
          uni.showToast({ title: (e as Error).message, icon: 'none' })
        } finally { this.saving = false }
      },
      goHome() { uni.switchTab({ url: '/pages/index/index' }) }
    }
  }

  type Opt = { value: string, label: string, emoji: string }
</script>

<style>
  .page { flex: 1; background-color: #F7F6F4; padding: 24rpx; align-items: center; }
  .card { width: 700rpx; background-color: #FFFFFF; border-radius: 24rpx; padding: 48rpx 40rpx; margin-top: 40rpx; align-items: center; }
  .label { font-size: 30rpx; color: #1F2329; margin-bottom: 24rpx; }
  .opts { flex-direction: row; margin-bottom: 24rpx; }
  .opt { width: 200rpx; align-items: center; background-color: #F7F6F4; border-radius: 20rpx; padding: 32rpx 0; margin: 0 10rpx; }
  .opt-active { background-color: #FFEFEA; }
  .opt-emoji { font-size: 44rpx; }
  .opt-text { font-size: 26rpx; color: #6B7280; margin-top: 12rpx; }
  .opt-text-active { color: #FF7A6B; font-weight: bold; }
  .hint { font-size: 22rpx; color: #A3AAB5; margin: 8rpx 0 24rpx 0; text-align: center; }
  .btn-save { width: 620rpx; height: 96rpx; line-height: 96rpx; background-color: #FF7A6B; color: #FFFFFF; font-size: 32rpx; border-radius: 44rpx; margin-top: 16rpx; }
  .celebrate { font-size: 80rpx; }
  .celebrate-title { font-size: 36rpx; font-weight: bold; color: #1F2329; margin: 16rpx 0; }
  .date-box { width: 620rpx; height: 96rpx; background-color: #F7F6F4; border-radius: 16rpx; align-items: center; justify-content: center; margin-bottom: 24rpx; }
  .date-text { font-size: 30rpx; color: #1F2329; }
  .link { color: #A3AAB5; font-size: 26rpx; margin-top: 24rpx; }
</style>
