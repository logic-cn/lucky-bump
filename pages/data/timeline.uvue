<template>
  <view class="page" :class="themeClass()">
    <!-- 生命故事卡：一条不断档的时间线（差异化核心，docs/09-同类产品对标） -->
    <view class="story lb-rise" v-if="events.length > 0">
      <text class="story-title">{{ storyTitle }}</text>
      <text class="story-sub">{{ storySub }}</text>
    </view>

    <view v-for="(g, gi) in groups" :key="g.date">
      <view class="chapter-row" v-if="g.showChapter">
        <text class="chapter-title">{{ g.chapter }}</text>
        <view class="chapter-rule" />
      </view>
      <view class="day-group">
        <view class="day-spine">
          <text class="day-num">{{ g.day }}</text>
          <text class="day-month">{{ g.month }}</text>
          <text class="day-wd">{{ g.weekday }}</text>
          <view class="spine-line" />
        </view>
        <view class="day-card">
          <view class="day-head">
            <text class="day-count">{{ g.items.length }} 条记录</text>
            <view class="week-chip" v-if="g.weekTag.length > 0"><text class="week-chip-text">{{ g.weekTag }}</text></view>
          </view>
          <view class="event-row" v-for="(it, ii) in g.items" :key="ii">
            <text class="event-time">{{ it.time }}</text>
            <view class="dot-col"><view class="dot" :class="'dot-' + it.dotType" /></view>
            <view class="event-body">
              <text class="event-title">{{ it.title }}</text>
              <text class="event-sub" v-if="it.detail.length > 0">{{ it.detail }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <lbc-error v-if="loadFailed" :message="errorMsg" @retry="load" />
    <lbc-empty v-if="events.length == 0 && !loadFailed" title="时间线还是空的" hint="每一条记录，都会长成回忆" ctaText="写下第一条" @cta="goFirst" />
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyData } from '../../utils/request.uts'
  import { journeyState, loadCurrentJourney } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const CODE_TEXT: Map<string, string> = new Map([
    ['weight', '体重'], ['blood_pressure', '血压'], ['blood_glucose', '血糖'],
    ['hcg', 'hCG'], ['progesterone', '孕酮'],
    ['symptom', '症状记录'], ['mood', '情绪'], ['fetal_movement', '胎动'],
    ['lochia', '恶露'], ['kegel', '盆底肌训练'], ['water', '饮水'],
    ['period_start', '经期开始'], ['period_end', '经期结束'],
    ['ovulation_test', '排卵试纸'], ['bbt', '基础体温'], ['intercourse', '同房'], ['pregnancy_test', '验孕'],
    ['mucus', '白带记录'],
    ['visit', '产检'], ['prenatal_visit', '产检'],
    ['head_up', '学会了抬头'], ['roll_over', '学会了翻身'], ['sit_alone', '学会了独坐'],
    ['crawl', '学会了爬行'], ['stand_assisted', '学会了扶站'], ['walk_alone', '学会了独走'],
    ['grasp', '学会了抓握'], ['transfer', '双手传递物品'], ['pincer', '拇指食指对捏'],
    ['babble', '开始咿呀发声'], ['mama_dada', '会叫爸爸妈妈'], ['words_combo', '会说双词短句'],
    ['stranger_aware', '开始认生'], ['wave_bye', '会挥手再见'],
    ['medication', '用药记录']
  ])

  type DayEvent = { time: string, title: string, detail: string, dotType: string }
  type DayGroup = { date: string, day: string, month: string, weekday: string, weekTag: string, chapter: string, showChapter: boolean, items: DayEvent[] }
  type Chapter = { title: string, sub: string, tag: string }

  const events = ref<UTSJSONObject[]>([])
  const loadFailed = ref<boolean>(false)
  const errorMsg = ref<string>('')

  async function load() {
    try {
      // 故事流需要旅程锚点（末次月经/分娩日）；冷启动直接进时间线时补拉一次
      if (journeyState.lmpDate.length == 0 && journeyState.deliveryDate.length == 0 && journeyState.journeyId.length == 0) {
        await loadCurrentJourney()
      }
      const res = await luckyData('timeline', { journeyId: journeyState.journeyId, limit: 80 } as UTSJSONObject)
      // strict 敏感记录（同房/量表）在非 owner 视角由服务端过滤；owner 视角全量可见
      events.value = res.getArray<UTSJSONObject>('events') ?? []
      loadFailed.value = false
    } catch (e) {
      loadFailed.value = true
      errorMsg.value = (e as Error).message
    }
  }
  function timeText(e: UTSJSONObject): string {
    const ts = e.getNumber('ts') ?? 0
    const d = new Date(ts)
    const hh = d.getHours() < 10 ? '0' + d.getHours() : '' + d.getHours()
    const mm = d.getMinutes() < 10 ? '0' + d.getMinutes() : '' + d.getMinutes()
    return `${hh}:${mm}`
  }
  // 日期用本地时区计算，与时间列同源：早 8 点前的记录不再显示成前一天
  function dateText(e: UTSJSONObject): string {
    const ts = e.getNumber('ts') ?? 0
    const d = new Date(ts)
    const mo = d.getMonth() + 1
    const da = d.getDate()
    return `${d.getFullYear()}-${mo < 10 ? '0' + mo : '' + mo}-${da < 10 ? '0' + da : '' + da}`
  }
  function fmtNum(n: number): string {
    return `${Math.round(n * 10) / 10}`
  }
  function titleOf(e: UTSJSONObject): string {
    const code = e.getString('code') ?? ''
    if (code == 'medication') return '用药'
    return CODE_TEXT.get(code) ?? code
  }
  function slotText(s: string): string {
    if (s == 'fasting') return '空腹'
    if (s == '1h') return '餐后 1h'
    if (s == '2h') return '餐后 2h'
    if (s == 'random') return '随机'
    return s
  }
  /** 事件副标题：具体数值/医院等，让时间线不止有标题 */
  function detailOf(e: UTSJSONObject): string {
    const code = e.getString('code') ?? ''
    const v = e.getJSON('value') as UTSJSONObject | null
    if (v == null) return ''
    if (code == 'weight') return `${fmtNum(v.getNumber('kg') ?? 0)} kg`
    if (code == 'water') return `${fmtNum(v.getNumber('ml') ?? 0)} ml`
    if (code == 'blood_pressure') {
      const hr = v.getNumber('hr') ?? 0
      return `${fmtNum(v.getNumber('sbp') ?? 0)}/${fmtNum(v.getNumber('dbp') ?? 0)} mmHg${hr > 0 ? ` · 心率 ${fmtNum(hr)}` : ''}`
    }
    if (code == 'blood_glucose') return `${fmtNum(v.getNumber('mmol') ?? 0)} mmol/L · ${slotText(v.getString('slot') ?? '')}`
    if (code == 'fetal_movement') return `${fmtNum(v.getNumber('count') ?? 0)} 次${(v.getNumber('durationMin') ?? 0) > 0 ? ` / ${fmtNum(v.getNumber('durationMin') ?? 0)} 分钟` : ''}`
    if (code == 'mood') return `${fmtNum(v.getNumber('score') ?? 0)} / 5 分`
    if (code == 'kegel') return `${fmtNum(v.getNumber('sets') ?? 0)} 组 × ${fmtNum(v.getNumber('reps') ?? 0)} 次`
    if (code == 'symptom') {
      const codes = v.getArray<string>('codes') ?? []
      const sev = v.getNumber('severity') ?? 0
      const sevText = sev == 1 ? '轻' : (sev == 2 ? '中' : (sev == 3 ? '重' : ''))
      return `${codes.length} 项${sevText.length > 0 ? ' · ' + sevText : ''}`
    }
    if (code == 'medication') {
      const name = v.getString('name') ?? ''
      const dose = v.getString('dose') ?? ''
      return `${name}${dose.length > 0 ? ' · ' + dose : ''}`
    }
    if (code == 'visit' || code == 'prenatal_visit') {
      const week = v.getNumber('week') ?? 0
      const hospital = v.getString('hospital') ?? ''
      const parts: string[] = []
      if (week > 0) parts.push(`孕 ${fmtNum(week)} 周`)
      if (hospital.length > 0) parts.push(hospital)
      return parts.join(' · ')
    }
    if (code == 'lochia') {
      const color = v.getString('color') ?? ''
      const amount = v.getString('amount') ?? ''
      return [color, amount].filter(x => x.length > 0).join(' · ')
    }
    return ''
  }
  function weekdayOf(ds: string): string {
    const ts = Date.parse(ds + 'T12:00:00')
    if (!Number.isFinite(ts)) return ''
    const names = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
    return names[new Date(ts).getDay()]
  }
  function goFirst() { uni.switchTab({ url: '/pages/record/record' }) }

  /** 章节归属：分娩日 → 宝宝出生后；孕期阶段 → 孕期（带孕周标签）；其余 → 备孕时光 */
  function chapterOf(e: UTSJSONObject): Chapter {
    const ts = e.getNumber('ts') ?? 0
    const delivery = journeyState.deliveryDate
    if (delivery.length > 0) {
      const dts = Date.parse(delivery + 'T12:00:00Z')
      if (Number.isFinite(dts) && ts >= dts) {
        const days = Math.floor((ts - dts) / 86400000)
        return { title: '宝宝出生以后', sub: '', tag: days >= 0 ? `出生第 ${days + 1} 天` : '' }
      }
    }
    const pregnant = journeyState.stage == 'T1' || journeyState.stage == 'T2' || journeyState.stage == 'T3'
    // 备孕旅程也会存末次月经锚点，不能据此把记录误标成孕期
    if ((pregnant || delivery.length > 0) && journeyState.lmpDate.length > 0) {
      const lts = Date.parse(journeyState.lmpDate + 'T12:00:00Z')
      if (Number.isFinite(lts) && ts >= lts) {
        const days = Math.floor((ts - lts) / 86400000)
        return { title: '孕期', sub: '', tag: `孕 ${Math.floor(days / 7)} 周` }
      }
    }
    return { title: '备孕时光', sub: '', tag: '' }
  }

  const storyTitle = computed((): string => {
    if (events.value.length == 0) return ''
    if (journeyState.deliveryDate.length > 0) return '从两道杠，到抱在怀里'
    if (journeyState.stage == 'T1' || journeyState.stage == 'T2' || journeyState.stage == 'T3') return '从末次月经开始的故事'
    return '记录的每一步都在这里'
  })
  const storySub = computed((): string => `共 ${events.value.length} 条记录 · 数据只属于你们`)

  /** 按天分组：日期只出现一次，事件进入当天卡片 */
  const groups = computed((): DayGroup[] => {
    const out: DayGroup[] = []
    let lastChapter = ''
    for (let i = 0; i < events.value.length; i++) {
      const e = events.value[i]
      const ds = dateText(e)
      const ch = chapterOf(e)
      if (out.length == 0 || out[out.length - 1].date != ds) {
        out.push({
          date: ds, day: ds.slice(8, 10), month: `${parseInt(ds.slice(5, 7))}月`, weekday: weekdayOf(ds),
          weekTag: ch.tag, chapter: ch.title, showChapter: ch.title != lastChapter, items: []
        })
        lastChapter = ch.title
      }
      out[out.length - 1].items.push({
        time: timeText(e), title: titleOf(e), detail: detailOf(e), dotType: e.getString('type') ?? 'metric'
      })
    }
    return out
  })

  // 首屏与 tab 切回统一走 onPageReady（uni-app x 5.34 页面钩子不触发，见 utils/pageLifecycle.uts）
  onPageReady(() => { load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .story { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 36rpx; margin-top: 16rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .story-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); }
  .story-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 12rpx; }
  .chapter-row { width: 702rpx; flex-direction: row; align-items: center; padding: 28rpx 8rpx 4rpx 8rpx; }
  .chapter-title { font-size: 30rpx; font-weight: bold; color: var(--lb-primary-deep); }
  .chapter-rule { flex: 1; height: 1px; background-color: var(--lb-line); margin-left: 16rpx; }
  .day-group { width: 702rpx; flex-direction: row; margin-top: 16rpx; }
  .day-spine { width: 104rpx; align-items: flex-start; padding-top: 8rpx; }
  .day-num { font-size: 44rpx; font-weight: bold; color: var(--lb-text-1); line-height: 1; }
  .day-month { font-size: 24rpx; color: var(--lb-text-2); margin-top: 6rpx; }
  .day-wd { font-size: 24rpx; color: var(--lb-text-3); margin-top: 2rpx; }
  .spine-line { width: 2px; flex: 1; min-height: 24rpx; background-color: var(--lb-line); margin-top: 12rpx; }
  .day-card { flex: 1; background-color: var(--lb-card); border-radius: 28rpx; padding: 8rpx 28rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .day-head { flex-direction: row; align-items: center; justify-content: space-between; padding: 12rpx 0 4rpx 0; }
  .day-count { font-size: 24rpx; color: var(--lb-text-3); }
  .week-chip { background-color: var(--lb-primary-soft); border-radius: 999rpx; padding: 6rpx 16rpx; }
  .week-chip-text { font-size: 24rpx; color: var(--lb-primary-deep); font-weight: bold; }
  .event-row { flex-direction: row; padding: 20rpx 0; border-bottom-width: 1px; border-bottom-color: var(--lb-line); }
  .event-time { width: 88rpx; font-size: 24rpx; color: var(--lb-text-3); padding-top: 2rpx; }
  .dot-col { width: 36rpx; padding-top: 10rpx; align-items: flex-start; }
  .dot { width: 14rpx; height: 14rpx; border-radius: 7rpx; background-color: var(--lb-primary); }
  .dot-cycle { background-color: var(--lb-warning); }
  .dot-visit { background-color: var(--lb-secondary); }
  .dot-milestone { background-color: var(--lb-success); }
  .dot-medication { background-color: var(--lb-warning); }
  .event-body { flex: 1; }
  .event-title { font-size: 28rpx; color: var(--lb-text-1); font-weight: bold; }
  .event-sub { font-size: 24rpx; color: var(--lb-text-2); margin-top: 6rpx; line-height: 36rpx; }
  .empty { font-size: 28rpx; color: var(--lb-text-2); }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin-top: 12rpx; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
