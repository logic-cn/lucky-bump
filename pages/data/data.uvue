<template>
  <view class="page" :class="themeClass()">
    <!-- 首屏概览：数据 Tab 不再是"4 行导航"空页面 -->
    <view class="overview lb-rise" v-if="overview != null">
      <view class="ov-col">
        <text class="ov-num">{{ ovRecords }}</text>
        <text class="ov-cap">本周记录</text>
      </view>
      <view class="ov-divider" />
      <view class="ov-col">
        <text class="ov-num">{{ ovWeight }}</text>
        <text class="ov-cap">最近体重</text>
      </view>
      <view class="ov-divider" />
      <view class="ov-col">
        <text class="ov-num ov-num-sm">{{ ovNext }}</text>
        <text class="ov-cap">下一项日程</text>
      </view>
    </view>

    <view class="nav-card lb-rise">
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/data/charts')">
        <text class="nav-icon">📈</text>
        <view class="nav-body"><text class="nav-text">指标曲线</text><text class="nav-sub">体重 / 血压 / 血糖 / 胎动趋势</text></view>
        <text class="nav-arrow">›</text>
      </view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/data/timeline')">
        <text class="nav-icon">🕰</text>
        <view class="nav-body"><text class="nav-text">生命时间线</text><text class="nav-sub">从备孕到育儿的所有记录</text></view>
        <text class="nav-arrow">›</text>
      </view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="goExport">
        <text class="nav-icon">📦</text>
        <view class="nav-body"><text class="nav-text">导出我的数据</text><text class="nav-sub">数据属于你，随时带走</text></view>
        <text class="nav-arrow">›</text>
      </view>
      <view class="nav-row" hover-class="lb-press" hover-stay-time="120" @click="go('/pages/data/export-report')">
        <text class="nav-icon">🖨</text>
        <view class="nav-body"><text class="nav-text">打印 / 导出 PDF</text><text class="nav-sub">汇总摘要，可保存或发给医生</text></view>
        <text class="nav-arrow">›</text>
      </view>
    </view>

    <!-- 自绘提示弹窗（web 端 uni.showModal 回调不触发） -->
    <view class="mask lb-fade" v-if="infoVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">{{ infoTitle }}</text>
        <text class="dlg-content">{{ infoContent }}</text>
        <view class="dlg-actions">
          <text class="dlg-btn dlg-btn-ghost" @click="copySummary">复制摘要</text>
          <text class="dlg-btn dlg-btn-ok" @click="infoVisible = false">知道了</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyData } from '../../utils/request.uts'

  const infoVisible = ref<boolean>(false)
  const infoTitle = ref<string>('')
  const infoContent = ref<string>('')
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'
  import { track } from '../../utils/track.uts'

  // 首屏概览（today 聚合复用）：加载失败时整卡隐藏，不误导
  const overview = ref<UTSJSONObject | null>(null)
  const ovRecords = computed((): string => `${((overview.value as UTSJSONObject | null)?.getJSON('weekStats') as UTSJSONObject | null)?.getNumber('records')?.toInt() ?? 0} 条`)
  const ovWeight = computed((): string => {
    const w = (overview.value as UTSJSONObject | null)?.getJSON('latest') as UTSJSONObject | null
    const kg = (w?.getJSON('weight') as UTSJSONObject | null)?.getJSON('value') as UTSJSONObject | null
    const v = kg?.getNumber('kg') ?? 0
    return v > 0 ? `${v}kg` : '—'
  })
  const ovNext = computed((): string => {
    const nv = (overview.value as UTSJSONObject | null)?.getJSON('weekStats') as UTSJSONObject | null
    const visit = nv?.getJSON('nextVisit') as UTSJSONObject | null
    const title = visit?.getString('title') ?? ''
    return title.length > 0 ? title : '—'
  })
  async function loadOverview() {
    try {
      overview.value = await luckyData('today', { journeyId: journeyState.journeyId } as UTSJSONObject)
    } catch (e) { /* 概览失败不阻塞导航主体 */ }
  }

  const exporting = ref<boolean>(false)
  function go(url: string) { uni.navigateTo({ url }) }

  async function goExport() {
    if (exporting.value) return
    exporting.value = true
    try {
      await luckyData('exportAll', { journeyId: journeyState.journeyId } as UTSJSONObject)
      const sum = await luckyData('exportSummary', { journeyId: journeyState.journeyId } as UTSJSONObject)
      track('export_done')
      infoTitle.value = '数据已就绪'
      infoContent.value = sum.getString('summary') ?? ''
      infoVisible.value = true
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { exporting.value = false }
  }

  onPageReady(() => { loadOverview() })
  function copySummary() {
    uni.setClipboardData({
      data: infoContent.value,
      success: () => { uni.showToast({ title: '摘要已复制', icon: 'none' }) }
    })
  }
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .overview { width: 702rpx; background-image: linear-gradient(165deg, var(--lb-grad-1), var(--lb-grad-2)); border-radius: 46rpx; padding: 40rpx 24rpx; margin-bottom: 24rpx; flex-direction: row; align-items: center; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .ov-col { flex: 1; align-items: center; }
  .ov-num { font-size: 40rpx; font-weight: bold; color: #FFFFFF; }
  .ov-num-sm { font-size: 26rpx; font-weight: bold; }
  .ov-cap { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 8rpx; }
  .ov-divider { width: 2rpx; height: 56rpx; background-color: rgba(255,255,255,0.25); }
  .nav-card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 8rpx 32rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .nav-row { flex-direction: row; align-items: center; padding: 28rpx 0; border-bottom-width: 1px; border-bottom-color: var(--lb-line); transition: all 160ms ease-out; }
  .nav-icon { font-size: 40rpx; margin-right: 20rpx; }
  .nav-body { flex: 1; }
  .nav-text { font-size: 30rpx; color: var(--lb-text-1); }
  .nav-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 4rpx; }
  .nav-arrow { font-size: 36rpx; color: var(--lb-arrow); }

  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--lb-mask); justify-content: center; align-items: center; }
  .dialog { width: 560rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx 32rpx 24rpx 32rpx; }
  .dlg-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); text-align: center; }
  .dlg-content { font-size: 27rpx; color: var(--lb-text-2); margin-top: 20rpx; text-align: left; line-height: 44rpx; }
  .dlg-actions { flex-direction: row; justify-content: space-between; margin-top: 36rpx; }
  .dlg-btn { width: 250rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 29rpx; color: #FFFFFF; background-image: linear-gradient(135deg, #F376A0, #D43770); border-radius: 999rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .dlg-btn-ghost { color: var(--lb-text-2); background-image: none; background-color: var(--lb-fill); box-shadow: none; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
