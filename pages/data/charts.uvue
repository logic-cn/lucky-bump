<template>
  <view class="page" :class="themeClass()">
    <view class="metrics lb-rise">
      <view class="metric" v-for="(m, i) in metricList" :key="i" :class="code == m.value ? 'metric-active' : ''" hover-class="lb-press" hover-stay-time="120" @click="select(m.value)">
        <text class="metric-text" :class="code == m.value ? 'metric-text-active' : ''">{{ m.label }}</text>
      </view>
    </view>

    <lbc-error v-if="loadFailed" :message="errorMsg" @retry="load" />

    <lbc-empty v-if="points.length == 0 && !loadFailed" :title="'还没有 ' + metricLabel + ' 记录'" hint="每一条都会长成属于你的曲线" ctaText="去记一条" @cta="goRecord" />

    <!-- 指标总览：最新值 + 较上次变化 + 平均值 -->
    <view class="summary lb-rise-1" v-if="points.length > 0">
      <view class="summary-top">
        <text class="summary-label">{{ metricLabel }}</text>
        <view class="delta-chip" v-if="deltaText.length > 0">
          <text class="delta-text">{{ deltaText }}</text>
        </view>
      </view>
      <view class="summary-main">
        <text class="summary-value">{{ latestDisplay }}</text>
        <text class="summary-unit">{{ metricUnit }}</text>
      </view>
      <text class="summary-sub">最近 {{ points.length }} 次 · 平均 {{ avgText }} {{ metricUnit }}</text>
    </view>

    <!-- 柱状趋势：数值在柱顶，日期在底部，柱体撑满卡片高度 -->
    <view class="card lb-rise-2" v-if="points.length > 0">
      <view class="chart-head">
        <text class="card-title chart-title">趋势</text>
        <text class="chart-range">{{ axisBaseText }} – {{ axisTopText }}</text>
      </view>
      <view class="plot">
        <view class="bar-col" v-for="(p, i) in points" :key="i">
          <text class="bar-val" :class="i == points.length - 1 ? 'bar-val-latest' : ''">{{ p.display }}</text>
          <view class="bar" :class="i == points.length - 1 ? 'bar-latest' : ''" :style="{ height: barPx(p.y) }" />
          <text class="bar-date">{{ p.date.slice(5) }}</text>
        </view>
      </view>
      <text class="hint" v-if="hasBaseline">纵轴已聚焦到 {{ axisBaseText }}-{{ axisTopText }} 区间，微小变化更直观</text>
    </view>

    <view class="card lb-rise-3" v-if="points.length > 0">
      <text class="card-title">全部记录</text>
      <view class="d-row" v-for="(p, i) in detailRows" :key="i">
        <view class="d-dot" />
        <text class="d-date">{{ p.date }}</text>
        <text class="d-val">{{ p.display }} {{ metricUnit }}</text>
      </view>
      <view class="more-btn" v-if="hasMore" hover-class="lb-press" hover-stay-time="120" @click="loadMore">
        <text class="more-text">加载更早记录</text>
      </view>
      <text class="hint" v-if="!hasMore && points.length > 12">已到最早记录</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyData } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  type MOpt = { value: string, label: string }
  type Pt = { date: string, y: number, display: string }

  const code = ref<string>('weight')
  const metricList = ref<MOpt[]>([
    { value: 'weight', label: '体重' },
    { value: 'blood_pressure', label: '血压' },
    { value: 'blood_glucose', label: '血糖' },
    { value: 'fetal_movement', label: '胎动' },
    { value: 'mood', label: '情绪' }
  ] as MOpt[])
  const points = ref<Pt[]>([] as Pt[])
  const loadFailed = ref<boolean>(false)
  const errorMsg = ref<string>('')
  const visibleCount = ref<number>(12)

  const metricLabel = computed((): string => {
    for (let i = 0; i < metricList.value.length; i++) { if (metricList.value[i].value == code.value) return metricList.value[i].label }
    return ''
  })
  const minVal = computed((): number => {
    let mn = Number.MAX_VALUE
    for (let i = 0; i < points.value.length; i++) { if (points.value[i].y < mn) mn = points.value[i].y }
    return points.value.length > 0 ? mn : 0
  })
  const maxVal = computed((): number => {
    let mx = 1
    for (let i = 0; i < points.value.length; i++) { if (points.value[i].y > mx) mx = points.value[i].y }
    return mx
  })
  const spanVal = computed((): number => Math.max(0, maxVal.value - minVal.value))
  // Y 轴基线自适应：体重 60→70kg 这类小幅波动不再被"从 0 起算"压平；
  // 数据本身接近 0（如胎动计数）时保持 0 基线，避免视觉夸大
  const baseline = computed((): number => {
    const s = spanVal.value
    if (s < 0.0001) return Math.max(0, minVal.value - Math.abs(minVal.value) * 0.05 - 1)
    if (minVal.value <= s) return 0
    return minVal.value - s * 0.2
  })
  const axisTop = computed((): number => {
    const s = spanVal.value
    if (s < 0.0001) return maxVal.value + Math.abs(maxVal.value) * 0.05 + 1
    return maxVal.value + s * 0.08
  })
  const hasBaseline = computed((): boolean => baseline.value > 0.0001)
  const axisTopText = computed((): string => fmtNum(axisTop.value))
  const axisBaseText = computed((): string => fmtNum(baseline.value))
  // 明细倒序展示（最新在前），支持分批加载更早记录
  const detailRows = computed((): Pt[] => {
    const rows: Pt[] = []
    for (let i = points.value.length - 1; i >= 0 && rows.length < visibleCount.value; i--) rows.push(points.value[i])
    return rows
  })
  const hasMore = computed((): boolean => points.value.length > visibleCount.value)

  const metricUnit = computed((): string => {
    if (code.value == 'weight') return 'kg'
    if (code.value == 'blood_pressure') return 'mmHg'
    if (code.value == 'blood_glucose') return 'mmol/L'
    if (code.value == 'fetal_movement') return '次'
    return '分'
  })
  const latestDisplay = computed((): string => {
    if (points.value.length == 0) return '—'
    return points.value[points.value.length - 1].display
  })
  const deltaText = computed((): string => {
    if (points.value.length < 2) return ''
    const last = points.value[points.value.length - 1].y
    const prev = points.value[points.value.length - 2].y
    const d = Math.round((last - prev) * 10) / 10
    if (d == 0) return '与上次持平'
    return `较上次 ${d > 0 ? '+' : ''}${d}`
  })
  const avgText = computed((): string => {
    if (points.value.length == 0) return '—'
    let sum = 0
    for (let i = 0; i < points.value.length; i++) sum += points.value[i].y
    return fmtNum(sum / points.value.length)
  })

  function fmtNum(n: number): string { return `${Math.round(n * 10) / 10}` }
  function select(c: string) { code.value = c; visibleCount.value = 12; load() }
  function loadMore() { visibleCount.value = visibleCount.value + 12 }
  function goRecord() { uni.switchTab({ url: '/pages/record/record' }) }
  function barHeight(y: number): number {
    const range = axisTop.value - baseline.value
    if (range <= 0) return 90
    return Math.max(14, Math.round((y - baseline.value) / range * 200))
  }
  /** Web 端不支持内联样式里的 rpx，统一转为 px 后绑定 */
  function barPx(y: number): string {
    return `${uni.rpx2px(barHeight(y))}px`
  }
  async function load() {
    try {
      const res = await luckyData('series', { journeyId: journeyState.journeyId, code: code.value } as UTSJSONObject)
      const arr = res.getArray<UTSJSONObject>('points') ?? []
      const pts: Pt[] = []
      // 手机宽度下最多容纳 6 根柱，血压等长数值标签也不会互相挤压
      for (let i = Math.max(0, arr.length - 6); i < arr.length; i++) {
        const p = arr[i].getJSON('primary')
        const raw = arr[i].getJSON('raw') as UTSJSONObject | null
        if (p == null) continue
        const y = (p as UTSJSONObject).getNumber('y') ?? 0
        let display = `${y}`
        if (code.value == 'blood_pressure') display = `${y}/${(p as UTSJSONObject).getNumber('y2') ?? ''}`
        else if (code.value == 'fetal_movement') display = `${(raw as UTSJSONObject | null)?.getNumber('count')?.toInt() ?? y} 次`
        pts.push({ date: arr[i].getString('date') ?? '', y, display })
      }
      points.value = pts
      loadFailed.value = false
    } catch (e) {
      // 失败时不能落到"还没有记录"，否则用户会误以为数据丢失
      loadFailed.value = true
      errorMsg.value = (e as Error).message
    }
  }

  // 首屏与 tab 切回统一走 onPageReady（uni-app x 5.34 页面钩子不触发，见 utils/pageLifecycle.uts）
  onPageReady(() => { load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .metrics { flex-direction: row; flex-wrap: wrap; margin-bottom: 8rpx; }
  .metric { background-color: var(--lb-card); border-radius: 999rpx; padding: 18rpx 28rpx; margin: 8rpx; transition: all 160ms ease-out; }
  .metric-active { background-color: var(--lb-primary); }
  .metric-text { font-size: 26rpx; color: var(--lb-text-2); }
  .metric-text-active { color: #FFFFFF; font-weight: bold; }
  .summary { width: 702rpx; border-radius: 36rpx; padding: 32rpx; margin-top: 16rpx; background-image: linear-gradient(135deg, var(--lb-primary-soft), var(--lb-card) 72%); box-shadow: 0 8rpx 28rpx rgba(190,47,92,0.08); }
  .summary-top { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; }
  .summary-label { font-size: 26rpx; color: var(--lb-text-2); }
  .delta-chip { background-color: var(--lb-card); border-radius: 999rpx; padding: 6rpx 18rpx; }
  .delta-text { font-size: 24rpx; color: var(--lb-primary-deep); font-weight: bold; }
  .summary-main { flex-direction: row; align-items: flex-end; margin-top: 10rpx; }
  .summary-value { font-size: 72rpx; font-weight: bold; color: var(--lb-primary-deep); line-height: 1; }
  .summary-unit { font-size: 26rpx; color: var(--lb-text-2); margin-left: 12rpx; margin-bottom: 8rpx; }
  .summary-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 14rpx; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 32rpx; margin-top: 16rpx; align-items: center; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-title { font-size: 28rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 20rpx; align-self: flex-start; }
  .chart-head { width: 100%; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
  .chart-title { margin-bottom: 0; align-self: center; }
  .chart-range { font-size: 24rpx; color: var(--lb-text-3); }
  .plot { width: 100%; height: 300rpx; flex-direction: row; align-items: flex-end; justify-content: space-between; padding-top: 8rpx; }
  .bar-col { flex: 1; height: 100%; align-items: center; justify-content: flex-end; }
  .bar { width: 36rpx; background-color: #F5A3C3; border-radius: 12rpx 12rpx 4rpx 4rpx; }
  .bar-latest { background-image: linear-gradient(180deg, #F5A3C3, var(--lb-primary-deep)); }
  .bar-val { font-size: 24rpx; color: var(--lb-text-2); font-weight: bold; margin-bottom: 8rpx; }
  .bar-val-latest { color: var(--lb-primary-deep); }
  .bar-date { font-size: 24rpx; color: var(--lb-text-3); margin-top: 10rpx; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); margin-top: 12rpx; }
  .more-btn { margin-top: 20rpx; padding: 16rpx 40rpx; border-radius: 999rpx; background-color: var(--lb-fill); transition: all 160ms ease-out; }
  .more-text { font-size: 26rpx; color: var(--lb-text-2); }
  .d-row { flex-direction: row; align-items: center; width: 100%; padding: 18rpx 0; border-bottom-width: 1px; border-bottom-color: var(--lb-line); }
  .d-dot { width: 10rpx; height: 10rpx; border-radius: 5rpx; background-color: var(--lb-primary); }
  .d-date { flex: 1; font-size: 26rpx; color: var(--lb-text-2); margin-left: 12rpx; }
  .d-val { font-size: 26rpx; color: var(--lb-text-1); font-weight: bold; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
