<template>
  <view class="page" :class="themeClass()">
    <view class="card lb-rise" v-if="summary.length > 0">
      <text class="card-title">幸孕记 · 健康记录摘要</text>
      <text class="meta">生成时间 {{ generatedAt }}</text>
      <text class="body">{{ summary }}</text>
      <text class="note">报告由你的记录自动汇总，仅供本人与医生参考，不构成诊断。</text>
    </view>

    <lbc-error v-if="loadFailed" :message="errorMsg" @retry="load" />

    <button class="btn-save lb-rise-1" hover-class="lb-press" hover-stay-time="120" :disabled="summary.length == 0" @click="doPrint">打印 / 另存为 PDF</button>
    <button class="btn-ghost lb-rise-1" hover-class="lb-press" hover-stay-time="120" :disabled="csvLoading" @click="downloadCsv">{{ csvLoading ? '生成中…' : '下载 CSV（Excel）' }}</button>
    <text class="hint lb-rise-2">在浏览器打印对话框中选择"另存为 PDF"即可保存；CSV 可直接用 Excel 打开。App 端请使用数据页的导出功能。</text>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { luckyData } from '../../utils/request.uts'
  import { luckyRecord } from '../../utils/request.uts'
  import { journeyState } from '../../store/journeyStore.uts'
  import { themeClass } from '../../store/themeStore.uts'

  const summary = ref<string>('')
  const generatedAt = ref<string>('')
  const loadFailed = ref<boolean>(false)
  const errorMsg = ref<string>('')
  const csvLoading = ref<boolean>(false)

  function stamp(): string {
    const d = new Date()
    const p = (n: number): string => n < 10 ? '0' + n : '' + n
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`
  }

  async function load() {
    try {
      const res = await luckyData('exportSummary', { journeyId: journeyState.journeyId } as UTSJSONObject)
      summary.value = res.getString('summary') ?? ''
      generatedAt.value = stamp()
      loadFailed.value = false
    } catch (e) {
      loadFailed.value = true
      errorMsg.value = (e as Error).message
    }
  }

  function doPrint() {
    // #ifdef WEB
    const g: any = globalThis as any
    if (g.print != null) {
      g.print()
      return
    }
    // #endif
    uni.showToast({ title: '请在 Web 端打印导出', icon: 'none' })
  }

  function codeLabel(code: string): string {
    if (code == 'weight') return '体重'
    if (code == 'blood_pressure') return '血压'
    if (code == 'blood_glucose') return '血糖'
    if (code == 'fetal_movement') return '胎动'
    if (code == 'symptom') return '症状'
    if (code == 'mood') return '情绪'
    return code
  }

  function metricText(code: string, v: UTSJSONObject | null): string {
    if (v == null) return ''
    if (code == 'weight') return `${v.getNumber('kg') ?? ''} kg`
    if (code == 'blood_pressure') {
      let s = `${v.getNumber('sbp') ?? ''}/${v.getNumber('dbp') ?? ''} mmHg`
      const hr = v.getNumber('hr')
      if (hr != null) s += ` 心率 ${hr}`
      return s
    }
    if (code == 'blood_glucose') {
      const slot = v.getString('slot') ?? ''
      const label = slot == 'fasting' ? '空腹' : (slot == '1h' ? '餐后 1h' : (slot == '2h' ? '餐后 2h' : '随机'))
      return `${label} ${v.getNumber('mmol') ?? ''} mmol/L`
    }
    if (code == 'fetal_movement') return `${v.getNumber('count') ?? ''} 次`
    if (code == 'symptom') {
      const arr = v.getArray('codes') ?? []
      const parts: string[] = []
      for (let i = 0; i < arr.length; i++) parts.push(`${arr[i]}`)
      return parts.join('、')
    }
    if (code == 'mood') return `${v.getNumber('score') ?? ''} 分`
    return ''
  }

  function csvCell(s: string): string {
    return `"${s.replace(/"/g, '""')}"`
  }

  async function buildCsv(): Promise<string> {
    const res = await luckyRecord('listMetrics', { journeyId: journeyState.journeyId, limit: 500 } as UTSJSONObject)
    const records = res.getArray<UTSJSONObject>('records') ?? []
    const dres = await luckyRecord('listDiaries', { journeyId: journeyState.journeyId } as UTSJSONObject)
    const diaries = dres.getArray<UTSJSONObject>('diaries') ?? []
    const lines: string[] = ['日期,类型,数值,备注']
    // 记录按时间正序，方便 Excel 画图
    for (let i = records.length - 1; i >= 0; i--) {
      const r = records[i]
      const code = r.getString('code') ?? ''
      const value = r.getJSON('value') as UTSJSONObject | null
      lines.push(`${csvCell(r.getString('date') ?? '')},${csvCell(codeLabel(code))},${csvCell(metricText(code, value))},`)
    }
    for (let i = diaries.length - 1; i >= 0; i--) {
      const d = diaries[i]
      lines.push(`${csvCell(d.getString('date') ?? '')},${csvCell('日记')},${csvCell(d.getString('mood') ?? '')},${csvCell(d.getString('text') ?? '')}`)
    }
    return lines.join('\n')
  }

  async function downloadCsv() {
    if (csvLoading.value) return
    csvLoading.value = true
    try {
      const csv = await buildCsv()
      // #ifdef WEB
      const g: any = globalThis as any
      const doc: any = g.document
      const blob = new g.Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' })
      const url = g.URL.createObjectURL(blob)
      const a = doc.createElement('a')
      a.href = url
      a.download = `幸孕记-记录-${stamp().slice(0, 10)}.csv`
      doc.body.appendChild(a)
      a.click()
      doc.body.removeChild(a)
      g.URL.revokeObjectURL(url)
      uni.showToast({ title: 'CSV 已开始下载', icon: 'none' })
      // #endif
      // #ifndef WEB
      uni.setClipboardData({
        data: csv,
        success: () => { uni.showToast({ title: 'CSV 已复制到剪贴板', icon: 'none' }) }
      })
      // #endif
    } catch (e) {
      uni.showToast({ title: (e as Error).message, icon: 'none' })
    } finally { csvLoading.value = false }
  }

  onPageReady(() => { load() })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; align-items: center; }
  .card { width: 702rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx; margin-top: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); }
  .meta { font-size: 24rpx; color: var(--lb-text-3); margin-top: 10rpx; }
  .body { font-size: 26rpx; color: var(--lb-text-1); line-height: 46rpx; margin-top: 24rpx; }
  .note { font-size: 24rpx; color: var(--lb-text-3); line-height: 38rpx; margin-top: 24rpx; }
  .btn-save { width: 702rpx; height: 96rpx; line-height: 96rpx; background-color: var(--lb-action); color: #FFFFFF; font-size: 32rpx; border-radius: 48rpx; margin-top: 32rpx; }
  .btn-ghost { width: 702rpx; height: 88rpx; line-height: 88rpx; background-color: var(--lb-fill); color: var(--lb-text-2); font-size: 28rpx; border-radius: 48rpx; margin-top: 20rpx; }
  .hint { font-size: 24rpx; color: var(--lb-text-3); line-height: 38rpx; margin-top: 20rpx; text-align: center; }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms forwards; opacity: 0; transform: translateY(28rpx); }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; opacity: 0; transform: scale(0.92); }
  .lb-fade { animation: lb-fade 200ms ease-out forwards; opacity: 0; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
