<template>
  <view class="page" :class="themeClass()">
    <!-- 阶段大卡 -->
    <view class="hero-card lb-rise">
      <view class="hero-row">
        <text class="hero-week" :lines="1">{{ weekLabel }}</text>
        <text class="hero-stage" v-if="stageLabel.length > 0 && stageLabel != weekLabel">{{ stageLabel }}</text>
      </view>
      <text class="hero-sub" v-if="showBabySize">宝宝现在{{ babySizeText }}，距预产期还有 {{ journeyState.daysToEdd }} 天</text>
      <text class="hero-sub" v-else-if="isPostpartum">产后第 {{ journeyState.postpartumDays }} 天 · 照顾好你自己也是宝宝的事</text>
      <text class="hero-sub" v-else-if="isTtc">距预测下次月经还有 {{ daysToPeriod }} 天 · 记录身体信号，好孕自来</text>
    </view>

    <!-- 今日待办 -->
    <view class="card lb-rise-1" v-if="todos.length > 0">
      <text class="card-title">今日待办</text>
      <view class="todo-row" v-for="(t, i) in todos" :key="i" hover-class="lb-press" hover-stay-time="120" @click="openTodo(t)">
        <view class="todo-dot" :class="t.getBoolean('urgent') == true ? 'todo-dot-urgent' : ''" />
        <view class="todo-body">
          <text class="todo-title">{{ t.getString('title') ?? '' }}</text>
          <text class="todo-sub">{{ todoDateText(t) }}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="card lb-rise-1" v-else>
      <text class="card-title">今日待办</text>
      <text class="empty-text">暂无待办，按节奏来就好 ☺</text>
    </view>

    <!-- 快捷记录宫格 -->
    <view class="card lb-rise-2">
      <text class="card-title">快捷记录</text>
      <view class="grid">
        <view class="grid-item" v-for="(item, i) in quickItems" :key="i" hover-class="lb-press" hover-stay-time="120" @click="goRecord(item.url)">
          <view class="grid-chip" :class="'grid-chip-' + (i % 5)">
            <text class="grid-icon">{{ item.icon }}</text>
          </view>
          <text class="grid-label">{{ item.label }}</text>
        </view>
      </view>
    </view>

    <!-- 首条记录引导：完成任意一条记录后不再出现 -->
    <view class="card lb-rise-1" v-if="firstGuideVisible">
      <text class="card-title">开始第一条记录</text>
      <text class="empty-text" v-if="isTtc">记录一次经期或排卵试纸，周期预测就会开始工作。</text>
      <text class="empty-text" v-else>记录一次体重，或写一条今天的日记，数据资产从这一条开始。</text>
      <view class="guide-row" v-if="isTtc">
        <text class="guide-btn" @click="goRecord('/pages/record/cycle')">记经期</text>
        <text class="guide-btn guide-btn-ghost" @click="goRecord('/pages/record/ovulation-test')">记排卵试纸</text>
      </view>
      <view class="guide-row" v-else>
        <text class="guide-btn" @click="goRecord('/pages/record/weight')">记体重</text>
        <text class="guide-btn guide-btn-ghost" @click="goRecord('/pages/record/diary')">写日记</text>
      </view>
    </view>

    <!-- 本周小结（周报最小版） -->
    <view class="card lb-rise-2" v-if="weeklyVisible">
      <text class="card-title">本周小结</text>
      <text class="trend-text">最近 7 天记录 {{ weekRecords }} 条{{ weekDeltaText }}</text>
      <text class="mom-foot">持续记录，趋势才会说话</text>
    </view>

    <!-- 家庭邀请引导（一次，可关闭） -->
    <view class="card lb-rise-2" v-if="inviteTipVisible">
      <text class="card-title">邀请家人一起记录</text>
      <text class="empty-text">爸爸也能记录喂养与夜奶，长辈可只读围观。数据始终只在你授权的范围内共享。</text>
      <view class="guide-row">
        <text class="guide-btn" @click="goRecord('/pages/me/family')">去邀请</text>
        <text class="guide-btn guide-btn-ghost" @click="dismissInviteTip">暂不邀请</text>
      </view>
    </view>

    <!-- 产后：妈妈今天 -->
    <view class="card lb-rise-2" v-if="momCardVisible">
      <text class="card-title">妈妈今天</text>
      <view class="mom-row">
        <view class="mom-item"><text class="mom-num">{{ momFeedings }}</text><text class="mom-label">喂养</text></view>
        <view class="mom-item"><text class="mom-num">{{ momDiapers }}</text><text class="mom-label">尿布</text></view>
        <view class="mom-item"><text class="mom-num">{{ momSleepText }}</text><text class="mom-label">宝宝睡眠</text></view>
      </view>
      <text class="mom-foot">照顾好你自己，也是宝宝的事</text>
    </view>

    <!-- 趋势摘要 -->
    <view class="card lb-rise-3" v-if="trendText.length > 0">
      <text class="card-title">最近记录</text>
      <text class="trend-text">{{ trendText }}</text>
    </view>

    <!-- 到期提醒弹层（免打扰时段内仅紧急提醒弹出） -->
    <view class="mask lb-fade" v-if="reminderVisible">
      <view class="dialog lb-pop">
        <text class="dlg-title">今日提醒</text>
        <text class="dlg-content">{{ reminderText }}</text>
        <view class="dlg-actions"><text class="dlg-btn dlg-btn-ok" @click="reminderVisible = false">知道了</text></view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue'
  import { onPageReady } from '../../utils/pageLifecycle.uts'
  import { appState } from '../../store/appStore.uts'
  import { journeyState, weekText, stageText, loadCurrentJourney, loadToday } from '../../store/journeyStore.uts'
  import { luckyRecord } from '../../utils/request.uts'
  import { themeClass } from '../../store/themeStore.uts'
  import { isQuietNow } from '../../utils/quiet.uts'
  import { track } from '../../utils/track.uts'

  type QuickItem = { icon: string, label: string, url: string }

  const todos = ref<UTSJSONObject[]>([])
  const babySizeText = ref('')
  const daysToPeriod = ref(0)
  const trendText = ref('')
  const reminderVisible = ref<boolean>(false)
  const reminderText = ref<string>('')
  const momCardVisible = ref<boolean>(false)
  const firstGuideVisible = ref<boolean>(false)
  const weeklyVisible = ref<boolean>(false)
  const weekRecords = ref<number>(0)
  const weekDeltaText = ref<string>('')
  const inviteTipVisible = ref<boolean>(false)
  const momFeedings = ref<number>(0)
  const momDiapers = ref<number>(0)
  const momSleepText = ref<string>('0h')

  const stageLabel = computed((): string => stageText(journeyState.stage))
  const weekLabel = computed((): string => weekText())
  const showBabySize = computed((): boolean => journeyState.stage == 'T1' || journeyState.stage == 'T2' || journeyState.stage == 'T3')
  const isPostpartum = computed((): boolean => journeyState.deliveryDate.length > 0)
  const isTtc = computed((): boolean => journeyState.stage == 'PRECONCEPTION')
  const quickItems = computed((): QuickItem[] => {
    const s = journeyState.stage
    const items: QuickItem[] = []
    if (s == 'PRECONCEPTION') {
      items.push({ icon: '🌸', label: '经期', url: '/pages/record/cycle' })
      items.push({ icon: '🧪', label: '排卵试纸', url: '/pages/record/ovulation-test' })
      items.push({ icon: '🌡', label: '基础体温', url: '/pages/record/cycle' })
      items.push({ icon: '🤰', label: '验孕', url: '/pages/record/pregnancy-test' })
    } else if (isPostpartum.value) {
      items.push({ icon: '🍼', label: '喂养', url: '/pages/baby/feeding' })
      items.push({ icon: '🧷', label: '尿布', url: '/pages/baby/diaper' })
      items.push({ icon: '😴', label: '睡眠', url: '/pages/baby/sleep' })
      items.push({ icon: '🩸', label: '恶露', url: '/pages/record/lochia' })
      items.push({ icon: '💗', label: '情绪自评', url: '/pages/record/epds' })
    } else {
      items.push({ icon: '⚖️', label: '体重', url: '/pages/record/weight' })
      items.push({ icon: '🩺', label: '血压', url: '/pages/record/blood-pressure' })
      items.push({ icon: '🦶', label: '胎动', url: '/pages/record/fetal-movement' })
      items.push({ icon: '⏱', label: '宫缩计时', url: '/pages/record/contraction-timer' })
      items.push({ icon: '🌸', label: '症状', url: '/pages/record/symptom' })
      items.push({ icon: '📔', label: '日记', url: '/pages/record/diary' })
      items.push({ icon: '🩸', label: '血糖', url: '/pages/record/blood-glucose' })
      items.push({ icon: '🏥', label: '产检', url: '/pages/care/schedule' })
    }
    return items
  })

  function goRecord(url: string) { uni.navigateTo({ url }) }
  function dismissInviteTip() {
    inviteTipVisible.value = false
    uni.setStorageSync('lb_family_tip_dismissed', true)
  }
  function openTodo(t: UTSJSONObject) {
    const kind = t.getString('kind') ?? ''
    track('reminder_done', { kind: kind } as UTSJSONObject)
    if (kind.indexOf('prenatal') == 0) uni.navigateTo({ url: '/pages/care/schedule' })
    else if (kind == 'vaccine') uni.navigateTo({ url: '/pages/baby/vaccines' })
  }
  function todoDateText(t: UTSJSONObject): string {
    const due = t.getString('dueDate') ?? ''
    const prep = t.getString('prep') ?? ''
    return prep.length > 0 ? `${due} · ${prep}` : due
  }

  /** 到期提醒：当天只弹一次；免打扰时段内仅紧急提醒可突破（docs/03 M9） */
  function maybeShowReminder() {
    const today = new Date().toISOString().slice(0, 10)
    const shown = uni.getStorageSync('lb_reminder_shown_date')
    if (shown != null && (shown as string) == today) return
    const due: UTSJSONObject[] = []
    let hasUrgent = false
    for (let i = 0; i < todos.value.length; i++) {
      const t = todos.value[i]
      const d = t.getString('dueDate') ?? ''
      if (d.length > 0 && d <= today) {
        due.push(t)
        if (t.getBoolean('urgent') == true) hasUrgent = true
      }
    }
    if (due.length == 0) return
    if (isQuietNow() && !hasUrgent) return
    const lines: string[] = []
    const max = due.length > 3 ? 3 : due.length
    for (let i = 0; i < max; i++) lines.push('· ' + (due[i].getString('title') ?? ''))
    if (due.length > 3) lines.push(`…还有 ${due.length - 3} 条，见首页待办`)
    reminderText.value = lines.join('\n')
    reminderVisible.value = true
    uni.setStorageSync('lb_reminder_shown_date', today)
  }

  async function refresh() {
    if (appState.token.length == 0) { uni.reLaunch({ url: '/pages/account/login' }); return }
    try {
      const j = await loadCurrentJourney()
      if (j == null) { uni.reLaunch({ url: '/pages/onboarding/onboarding' }); return }
      const res = await loadToday()
      todos.value = res.getArray<UTSJSONObject>('todos') ?? []
      const latest = res.getJSON('latest')
      if (latest != null) {
        const parts: string[] = []
        const w = latest.getJSON('weight')
        if (w != null) {
          const wv = w.getJSON('value')
          if (wv != null) parts.push(`体重 ${wv.getNumber('kg') ?? 0}kg`)
        }
        const bp = latest.getJSON('blood_pressure')
        if (bp != null) {
          const bv = bp.getJSON('value')
          if (bv != null) parts.push(`血压 ${bv.getNumber('sbp') ?? 0}/${bv.getNumber('dbp') ?? 0}`)
        }
        trendText.value = parts.join(' · ')
      }
      const jv = res.getJSON('journey')
      if (jv != null) {
        const edd = jv.getString('edd') ?? ''
        if (edd.length > 0 && journeyState.deliveryDate.length == 0) {
          const diff = Math.max(0, Math.floor((Date.parse(edd + 'T12:00:00Z') - Date.now()) / 86400000))
          journeyState.daysToEdd = diff
          const sizeMap = ['约一颗草莓', '约一个柠檬', '约一个牛油果', '约一个菠萝', '约一个小西瓜']
          const idx = Math.max(0, Math.min(4, Math.floor(journeyState.weeks / 8)))
          babySizeText.value = sizeMap[idx]
        }
      }
      const mc = res.getJSON('momCard')
      if (mc != null) {
        momCardVisible.value = true
        momFeedings.value = mc.getNumber('feedings') ?? 0
        momDiapers.value = mc.getNumber('diapers') ?? 0
        const mins = mc.getNumber('sleepMinutes') ?? 0
        momSleepText.value = mins >= 60 ? `${Math.floor(mins / 60)}h${mins % 60}m` : `${mins}m`
      } else {
        momCardVisible.value = false
      }
      if (journeyState.stage == 'PRECONCEPTION') {
        const c = await luckyRecord('listCycleEvents', { journeyId: journeyState.journeyId } as UTSJSONObject)
        const pred = c.getJSON('prediction')
        const nextPeriod = pred != null ? (pred as UTSJSONObject).getString('nextPeriodDate') ?? '' : ''
        if (nextPeriod.length > 0) {
          const diff = Math.max(0, Math.floor((Date.parse(nextPeriod + 'T12:00:00Z') - Date.now()) / 86400000))
          daysToPeriod.value = diff
        }
      }
      maybeShowReminder()
      // 首条记录引导：本地标记，记录成功后置 true（失败不影响主流程）
      const hasRecord = uni.getStorageSync('lb_has_record')
      firstGuideVisible.value = hasRecord == null
      // 本周小结
      const ws = res.getJSON('weekStats')
      if (ws != null) {
        const n = ws.getNumber('records') ?? 0
        weekRecords.value = n
        weeklyVisible.value = n > 0
        const delta = ws.getNumber('weightDelta')
        if (delta != null) {
          const sign = delta >= 0 ? '+' : ''
          weekDeltaText.value = ` · 体重较上次 ${sign}${delta}kg`
        } else {
          weekDeltaText.value = ''
        }
      }
      // 家庭邀请引导：首次有记录后出现一次，可关闭
      const inviteDone = uni.getStorageSync('lb_family_tip_dismissed')
      inviteTipVisible.value = hasRecord != null && inviteDone == null
    } catch (e) {
      // token 失效已由请求层统一跳登录
    }
  }

  onPageReady(() => {
    refresh()
  })
</script>

<style>
  @import '../../theme.scss';
  .page { flex: 1; background-color: var(--lb-bg); padding: 24rpx; }
  .hero-card { background-image: linear-gradient(135deg, #F0709D, #DC3D75); border-radius: 40rpx; padding: 44rpx 40rpx; margin-bottom: 24rpx; box-shadow: 0 12rpx 32rpx rgba(228,83,127,0.28); }
  .hero-row { flex-direction: row; align-items: flex-end; }
  .hero-week { font-size: 52rpx; font-weight: bold; color: #FFFFFF; flex: 1; margin-right: 12rpx; }
  .hero-stage { font-size: 24rpx; color: #FFFFFF; background-color: rgba(255,255,255,0.28); border-radius: 999rpx; padding: 8rpx 20rpx; }
  .hero-sub { font-size: 26rpx; color: rgba(255,255,255,0.92); margin-top: 16rpx; }
  .card { background-color: var(--lb-card); border-radius: 36rpx; padding: 36rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 24rpx rgba(50,36,48,0.04); }
  .card-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); margin-bottom: 24rpx; }
  .todo-row { flex-direction: row; align-items: center; padding: 18rpx 16rpx; border-radius: 24rpx; transition: all 160ms ease-out; }
  .todo-dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; background-color: var(--lb-primary); margin-right: 16rpx; }
  .todo-dot-urgent { background-color: var(--lb-danger); }
  .todo-body { flex: 1; }
  .todo-title { font-size: 28rpx; color: var(--lb-text-1); }
  .todo-sub { font-size: 24rpx; color: var(--lb-text-3); margin-top: 4rpx; }
  .arrow { font-size: 36rpx; color: var(--lb-arrow); }
  .empty-text { font-size: 26rpx; color: var(--lb-text-3); }
  .grid { flex-direction: row; flex-wrap: wrap; }
  .grid-item { width: 25%; align-items: center; padding: 16rpx 0; border-radius: 24rpx; transition: all 160ms ease-out; }
  .grid-chip { width: 84rpx; height: 84rpx; border-radius: 24rpx; align-items: center; justify-content: center; }
  .grid-chip-0 { background-color: var(--lb-primary-soft); }
  .grid-chip-1 { background-color: var(--lb-secondary-soft); }
  .grid-chip-2 { background-color: var(--lb-success-soft); }
  .grid-chip-3 { background-color: var(--lb-warning-soft); }
  .grid-chip-4 { background-color: var(--lb-chip-5); }
  .grid-icon { font-size: 40rpx; }
  .grid-label { font-size: 24rpx; color: var(--lb-text-2); margin-top: 12rpx; }
  .trend-text { font-size: 28rpx; color: var(--lb-text-2); }
  .mom-row { flex-direction: row; justify-content: space-between; padding: 8rpx 12rpx; }
  .mom-item { align-items: center; flex: 1; }
  .mom-num { font-size: 44rpx; font-weight: bold; color: var(--lb-primary-deep); }
  .mom-label { font-size: 24rpx; color: var(--lb-text-3); margin-top: 6rpx; }
  .mom-foot { font-size: 24rpx; color: var(--lb-text-3); margin-top: 16rpx; text-align: center; }
  .guide-row { flex-direction: row; margin-top: 24rpx; }
  .guide-btn { font-size: 28rpx; color: #FFFFFF; background-color: var(--lb-primary); border-radius: 40rpx; padding: 14rpx 32rpx; margin-right: 16rpx; text-align: center; }
  .guide-btn-ghost { color: var(--lb-text-2); background-color: var(--lb-fill); }

  .mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--lb-mask); justify-content: center; align-items: center; }
  .dialog { width: 560rpx; background-color: var(--lb-card); border-radius: 36rpx; padding: 40rpx 32rpx 24rpx 32rpx; }
  .dlg-title { font-size: 32rpx; font-weight: bold; color: var(--lb-text-1); text-align: center; }
  .dlg-content { font-size: 27rpx; color: var(--lb-text-2); margin-top: 20rpx; text-align: left; line-height: 44rpx; }
  .dlg-actions { flex-direction: row; justify-content: center; margin-top: 36rpx; }
  .dlg-btn { width: 300rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 29rpx; color: #FFFFFF; background-color: var(--lb-primary); border-radius: 40rpx; }
  .dlg-btn-ok { color: #FFFFFF; background-color: var(--lb-primary); }

  @keyframes lb-rise { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pulse { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
  .lb-rise { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-rise-1 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 70ms both; }
  .lb-rise-2 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both; }
  .lb-rise-3 { animation: lb-rise 520ms cubic-bezier(0.22, 1, 0.36, 1) 210ms both; }
  .lb-pop { animation: lb-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .lb-fade { animation: lb-fade 200ms ease-out both; }
  .lb-press { opacity: 0.72; transform: scale(0.98); }
</style>
